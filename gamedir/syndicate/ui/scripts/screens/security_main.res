"ui/scripts/screens/security_main.res"
{
	// Security station showcase: the console (SBO docs: World screens, "Showcase: security station"; the SDK's
	// prefabs/world_screens). 960 x 600 pixels on a bent {screen panel: rows 0 .. 420 on the upright display,
	// 420 .. 600 on the tilted control strip (the bend is at 70 % of the panel height).
	// The map keeps it up to date with vgui_control_proxy entities (screen "sec_screen"): the status texts, the
	// button texts, the log lines, the alarm bar (a ContinuousProgressBar: its value comes as a text in percent),
	// and the state colors and the header pulse (animations of security_main_anims.txt, mode 5). The tabs are
	// local: "anim:page_status" / "anim:page_log" show or hide the log page (LogCover, LogLine1-3) on this
	// player's screen only. DOOR / ALARM / LIGHTS send door / alarm / lights ("~<command>" keys).
	"WorldScreen"
	{
		"ControlName"		"EditablePanel"
		"fieldName"			"WorldScreen"
		"wide"				"960"
		"tall"				"600"
		"bgcolor_override"	"8 14 10 255"
	}
