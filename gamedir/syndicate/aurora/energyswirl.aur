// energyswirl.aur - SBO example (SBO docs: Aurora particle systems): a magic / energy effect. Spinning orbs (two layers:
// "overlaytype" draws a second sprite on each orb, turning the other way) rise slowly while their color moves
// from blue to violet, and shed small sparkles. Sprites: glow01 (SBO), xspark4 (stock Half-Life).
"particles" "220"
"maintype" "core"

{
  "name" "core"
  "spraytype" "orb"
  "sprayrate" "6"
  "sprayforce" "40..70"
  "spraypitch" "-20..20"
  "sprayyaw" "0..360"
}

{
  "name" "orb"
  "sprite" "sprites/glow01.spr"
  "rendermode" "additive"
  "overlaytype" "ring"
  "gravity" "20"
  "drag" "1.5"
  "lifetime" "2.5..3"
  "startsize" "6"
  "endsize" "18..24"
  "startred" "0.2..0.4"
  "startgreen" "0.4..0.7"
  "startblue" "1"
  "endred" "0.8"
  "endgreen" "0.2"
  "endblue" "1"
  "startalpha" "0.9"
  "endalpha" "0"
  "startangle" "0..360"
  "angledelta" "120..180"
  "spraytype" "mote"
  "sprayrate" "8"
  "sprayforce" "20..50"
  "spraypitch" "-90..90"
  "sprayyaw" "0..360"
}

{
  "name" "ring"
  "sprite" "sprites/xspark4.spr"
  "rendermode" "additive"
  "startred" "0.6"
  "startgreen" "0.8"
  "startblue" "1"
  "endred" "1"
  "endgreen" "0.4"
  "endblue" "1"
  "startalpha" "0.7"
  "endalpha" "0"
  "startangle" "0..360"
  "angledelta" "-240..-160"
}

{
  "name" "mote"
  "sprite" "sprites/glow01.spr"
  "rendermode" "additive"
  "gravity" "-10"
  "drag" "1"
  "lifetime" "0.8..1.2"
  "startsize" "1.5"
  "endsize" "0.5"
  "startred" "0.7"
  "startgreen" "0.8"
  "startblue" "1"
  "endred" "1"
  "endgreen" "0.5"
  "endblue" "1"
  "startalpha" "1"
  "endalpha" "0"
}
