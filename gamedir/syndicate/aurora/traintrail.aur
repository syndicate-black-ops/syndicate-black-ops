// traintrail.aur - SBO example (SBO docs: Aurora particle systems) for an env_particle with "Move with entity" (target):
// exhaust behind a moving func_train / door / monster. The puffs leave with the speed of the emitter and
// lose it quickly ("drag"), so they stay behind as a trail. Sprites: fasmoke2 (SBO), hotglow (SBO).
"particles" "160"
"maintype" "exhaust"

{
  "name" "exhaust"
  "spraytype" "puff"
  "sprayrate" "24"
  "sprayforce" "10..30"
  "spraypitch" "-60..0"
  "sprayyaw" "0..360"
}

{
  "name" "puff"
  "sprite" "sprites/fasmoke2.spr"
  "rendermode" "solid"
  "gravity" "12"
  "drag" "2.5"
  "lifetime" "2..3"
  "startsize" "6"
  "endsize" "30..40"
  "startred" "0.55"
  "startgreen" "0.5"
  "startblue" "0.45"
  "endred" "0.7"
  "endgreen" "0.68"
  "endblue" "0.65"
  "startalpha" "0.5"
  "endalpha" "0"
  "startframe" "0..120"
  "framerate" "12"
  "startangle" "0..360"
  "angledelta" "-30..30"
  "spraytype" "cinder"
  "sprayrate" "0.5"
  "sprayforce" "20"
  "spraypitch" "-90..90"
  "sprayyaw" "0..360"
}

{
  "name" "cinder"
  "sprite" "sprites/hotglow.spr"
  "rendermode" "additive"
  "gravity" "-150"
  "lifetime" "0.8"
  "startsize" "1.5"
  "endsize" "0.5"
  "startred" "1"
  "startgreen" "0.6"
  "startblue" "0.2"
  "endred" "1"
  "endgreen" "0.2"
  "endblue" "0"
}
