// Game Master mode display model (models/gmmode.mdl).
// From MrCalvin's gmmode_merged.qc (amxmodx-plugins server/syndicate/gmmode/modelsrc/gmmode_merged),
// generated by its tools/merge_models.py; the intro black box (body 24) is left out.
// Bodies: 0-21 spinning weapons/items, 22 green arrow, 23 teleporter / display base (skins 0 red, 1 blue, 2 green).
$modelname "gmmode.mdl"
$cd ".\mesh"
$cdtexture ".\textures"
$cliptotextures
$scale 1.0
$flags 0
$bodygroup "display"
{
	studio "item_00"
	studio "item_01"
	studio "item_02"
	studio "item_03"
	studio "item_04"
	studio "item_05"
	studio "item_06"
	studio "item_07"
	studio "item_08"
	studio "item_09"
	studio "item_10"
	studio "item_11"
	studio "item_12"
	studio "item_13"
	studio "item_14"
	studio "item_15"
	studio "item_16"
	studio "item_17"
	studio "item_18"
	studio "item_19"
	studio "item_20"
	studio "item_21"
	studio "item_22"
	studio "item_23"
}
$texturegroup "teleporter"
{
	{ "teleporter_dm_base.bmp" }
	{ "teleporter_dm_base_blue.bmp" }
	{ "teleporter_dm_base_green.bmp" }
}
$sequence "display" "..\anims\display" fps 10 loop
