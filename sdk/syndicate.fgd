	wind_rand_y(integer) : "Wind spread Y" : : "Each snowflake gets a random extra sideways speed along Y, from minus this to this, in units per second. If left empty or set to 0, there is none."
]

@PointClass base(GibshooterBase) iconsprite("sprites/editor/gibshooter.spr") = gibshooter : "Gib Shooter" []

@PointClass base(Targetname) iconsprite("sprites/editor/nuclear_explosion.spr") = nuclear_explosion : "Nuclear Explosion: a huge explosion with a mushroom cloud, shockwave and damage. Every value but damage and the radii is 0-255."
[
	master(string) : "Master"
	v1(integer) : "Explosion size (x 0.1, 0-255)" : 60 : "Size of the main fireball, in tenths."
	v2(integer) : "Explosion opacity (0-255)" : 255 : "Opacity of the main fireball (0 invisible, 255 opaque)."
	v3(integer) : "Smoke size (x 0.1, 0-255)" : 255 : "Size of the mushroom cloud, in tenths."
	v4(integer) : "Disc lifetime (x 0.1 sec, 0-255)" : 20 : "How long the shockwave disc lasts, in tenths of a second."
	v5(integer) : "Disc width (x 0.1, 0-255)" : 48 : "Width of the shockwave disc, in tenths."
	v6(integer) : "Disc brightness (0-255)" : 200 : "Brightness of the shockwave disc."
	v7(integer) : "Disc texture scroll (0-255)" : 0 : "How fast the disc's texture scrolls; no visible change with the stock white sprite. Disc lifetime sets how fast it grows."
	v8(integer) : "Glow lifetime (x 0.1 sec, 0-255)" : 20 : "How long the fireball glow lasts, in tenths of a second."
	v9(integer) : "Glow size (x 0.1, 0-255)" : 128 : "Size of the fireball glow, in tenths."
	v10(integer) : "Glow brightness (0-255)" : 190 : "Brightness of the fireball glow."
	v11(integer) : "Explosion damage" : 250 : "Damage dealt within the explosion radius."
	v12(integer) : "Explosion radius" : 3000 : "How far the damage reaches, in units."
	v13(integer) : "Shake radius" : 3000 : "How far players feel the screen shake, in units."
	v14(integer) : "Afterglow lifetime (x 0.1 sec, 0-255)" : 30 : "How long the afterglow lasts, in tenths of a second."
	v15(integer) : "Afterglow size (x 0.1, 0-255)" : 64 : "Size of the afterglow, in tenths."
	v16(integer) : "Afterglow brightness (0-255)" : 255 : "Brightness of the afterglow."
]


//
// HUD and world screens
//

@PointClass base(Targetname, Target) iconsprite("sprites/editor/env_message.spr") = env_message : "HUD Text Message"
[
	message(string) : "Message Name"
	spawnflags(flags) =
	[
		1 : "Play Once" : 0
		2 : "All Clients (else the activator)" : 0
	]
	messagesound(sound) : "Sound Effect"
	messagevolume(string) : "Volume 0-10" : "10"
	messageattenuation(choices) : "Sound Radius" : 0 =
	[
		0 : "Small Radius"
		1 : "Medium Radius"
		2 : "Large Radius"
		3 : "Play Everywhere"
	]
]

// Tutor window message for players in play (or the activator only). Trigger on to show, off to close.
// Messages queue one at a time per player. Target fires when a player sees the message.
@PointClass base(Targetname, Target, Master) iconsprite("sprites/editor/env_tutor.spr") = env_tutor : "Tutor Message (CZ tutor window)"
[
	spawnflags(flags) =
	[
		1 : "Activator only" : 0
		4 : "Show on player spawn" : 0
		8 : "Repeatable (see Max shows)" : 0
	]
	message(string) : "Text (\n = new line)" : : "The text, where %n becomes the player's name, %+reload% becomes the player's key for a command, and a #Token gives localized text. At most 1023 bytes."
	type(choices) : "Type (color, default icon/sound)" : 1 =
	[
		1 : "Default (green)"
		2 : "FriendDeath (red, skull)"
		4 : "EnemyDeath (blue, skull)"
		8 : "Scenario (yellow)"
		16 : "Buy (green)"
		32 : "Career (green)"
		64 : "Hint (green)"
		128 : "InGameHint (green)"
		256 : "EndGame (yellow)"
	]
	icon(choices) : "Icon" : 0 =
	[
		0 : "Type's (i, skull for deaths)"
		1 : "None"
		2 : "i"
		3 : "!"
		4 : "Skull"
		5 : "i (bigger, colored)"
		6 : "! (bigger, colored)"
	]
	iconfile(string) : "Custom icon .tga (overrides Icon; e.g. gfx/mymap/hint.tga)"
	sound(choices) : "Sound" : 0 =
	[
		0 : "Type's"
		1 : "None"
		2 : "events/tutor_msg.wav"
		3 : "events/friend_died.wav"
		4 : "events/enemy_died.wav"
	]
	soundfile(sound) : "Custom sound (overrides Sound)"
	color(color255) : "Text color (empty = type's)" : ""
	iconcolor(color255) : "Icon color (empty = text's; 255 255 255 = own)" : ""
	bgcolor(string) : "Background R G B A (empty = 0 0 0 200)" : ""
	bordercolor(string) : "Border R G B A (empty = scheme)" : ""
	align(choices) : "Alignment" : 0 =
	[
		0 : "Top right (default)"
		1 : "Top left"
		2 : "Top center"
		3 : "Center left"
		4 : "Center"
		5 : "Center right"
		6 : "Bottom left"
		7 : "Bottom center"
		8 : "Bottom right"
	]
	x(string) : "X (0 - 1.0 = left to right) (-1 = alignment's)" : "-1"
	y(string) : "Y (0 - 1.0 = top to bottom) (-1 = alignment's)" : "-1"
	holdtime(string) : "Hold Time (0 = until triggered off)" : "6"
	priority(integer) : "Priority (higher shows first)" : 0
	interrupt(choices) : "Interrupt" : 0 =
	[
		0 : "No: wait in the queue"
		1 : "Yes: replace a message of same/lower priority"
	]
	lifetime(string) : "Queue lifetime (0 = no limit, -1 = don't wait)" : "0"
	maxshows(integer) : "Max shows per player (Repeatable; 0 = no limit)" : 0
	closetarget(target_destination) : "Target when closed"
]

// A text box in the middle of the screen for the activator, or every player in play. The player closes it with
// Close, Enter or primary attack.
@PointClass base(Targetname) iconsprite("sprites/editor/game_messagebox.spr") = game_messagebox : "Message Box"
[
	spawnflags(flags) =
	[
		1 : "All Players" : 0
	]
	title(string) : "Title" : : "One line shown in a title bar. If left empty, the box has no title bar."
	message(string) : "Text (\n = new line)" : : "The text, and a #Token gives localized text. At most 1023 bytes."
	distance(string) : "Autoclose distance (0 = none)" : "0" : "Players farther than this when it is triggered don't get the box. It closes when the player moves farther than this from the position."
	position(target_destination) : "Autoclose position (entity name or x y z; empty = here)"
]

// Plays a full-screen video for the activator, or every player. The player cannot move while it plays; Esc ends it.
@PointClass base(Targetname, Master) iconsprite("sprites/editor/game_playvideo.spr") = game_playvideo : "Video (full screen)"
[
	spawnflags(flags) =
	[
		1 : "All Players" : 0
	]
	video(string) : "Video file (.ogv, in video/)" : : "Ogg Theora file under video/, e.g. mymap/intro.ogv (at most 57 characters, one dot). Added to the downloads."
	audio(string) : "Sound file (.ogg, in video/; empty = the video's own)"
]

@PointClass base(Targetname) iconsprite("sprites/editor/game_text.spr") = game_text : "HUD Text Message"
[
	spawnflags(flags) =
	[
		1 : "All Players" : 0
	]

	message(string) : "Message Text"
	x(string) : "X (0 - 1.0 = left to right) (-1 centers)" : "-1" : "Where the text sits across the screen, from 0 at the left to 1 at the right, and -1 centers it. If left empty, the text starts at the left edge."
	y(string) : "Y (0 - 1.0 = top to bottom) (-1 centers)" : "-1" : "Where the text sits down the screen, from 0 at the top to 1 at the bottom, and -1 centers it. If left empty, the text starts at the top edge."
	effect(choices) : "Text Effect" : 0 =
	[
		0 : "Fade In/Out"
		1 : "Credits"
		2 : "Scan Out"
	]
	color(color255) : "Color1" : "100 100 100" : "The text color. If left empty, the text is black, which doesn't show."
	color2(color255) : "Color2" : "240 110 0" : "The highlight color of the effects. If left empty, it is black, so no highlight shows."
	fadein(string) : "Fade in Time (or character scan time)" : "1.5" : "Seconds the text takes to fade in, or with the scan effect, the time each character takes to appear. If left empty, the text appears at once."
	fadeout(string) : "Fade Out Time" : "0.5" : "Seconds the text takes to fade out. If left empty, it disappears at once."
	holdtime(string) : "Hold Time" : "1.2" : "Seconds the text stays on screen. If left empty, it starts to fade out as soon as it has appeared."
	fxtime(string) : "Scan time (scan effect only)" : "0.25" : "With the scan effect, how long each character stays highlighted. If left empty, no highlight shows."
	channel(choices) : "Text Channel" : 1 : "A new text on a channel replaces the one shown there. If left empty, it uses the same channel as Channel 4." =
	[
		1 : "Channel 1"
		2 : "Channel 2"
		3 : "Channel 3"
		4 : "Channel 4"
	]
	master(string) : "Master"
]

// HUD countdown timer. Trigger on to start, off to stop and hide. Fires its target when the time is up.
// One timer shows at a time. A game_counter_set or trigger_changevalue changes it while it runs.
@PointClass base(Targetname) color(220 30 220) iconsprite("sprites/editor/game_timer.spr") = game_timer : "Game Timer (HUD countdown)"
[
	timer_length(string) : "Timer Length (seconds)" : "0"
	max_length(string) : "Max Length (seconds, 0 = no cap)" : "0"
	warn_time(string) : "Warn Time (seconds left; -1 = a quarter of the length)" : "-1"
	StartDisabled(choices) : "Start Disabled" : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	start_paused(choices) : "Start Paused" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	show_time_remaining(choices) : "Show Time Remaining" : 1 =
	[
		0 : "Show elapsed time"
		1 : "Show remaining time"
	]
	disable_on_finish(choices) : "Disable On Finish" : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	show_in_hud(choices) : "Show In HUD" : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	progress_bar_max(integer) : "Progress Bar Max Segments (-1 = timer length, 15 at most; 0 = no bar)" : -1
	progress_bar_override(integer) : "Progress Bar Override (segments shown; -1 = timer progress)" : -1
	x(string) : "HUD X Override (0 - 1.0 = left to right) (-1 = centered)" : "-1"
	y(string) : "HUD Y Override (0 - 1.0 = top to bottom) (-1 = default top position)" : "-1"
	timer_caption(string) : "Timer Caption (\n = new line)" : : "The caption, and a #Token gives localized text."
	caption_width(integer) : "Caption Width (pixels at 1080p before wrapping; 0 = no wrapping)" : 260
	caption_lines(integer) : "Caption Lines (1 - 4)" : 2
	target(target_destination) : "Target when finished (time is up)"
	warntarget(target_destination) : "Target when warned (Warn Time reached)"
	pausetarget(target_destination) : "Target when paused (also finished / disabled while running)"
	resumetarget(target_destination) : "Target when resumed (starts running)"
]

// Mission objective in every player's objective panel (top left) and the scoreboard's objective line.
// A trigger shows a hidden objective, the next one completes it. With a counter, each trigger counts one up ("2/3")
// and the objective is completed at the count. Part of: listed under a group objective, which is completed when
// all its parts are. At most 32 per map.
@PointClass base(Targetname, Master) color(220 30 220) iconsprite("sprites/editor/trigger_objective.spr") = trigger_objective : "Objective (HUD list)"
[
	message(string) : "Objective text" : : "Up to 127 characters, or #NAME for the titles.txt message NAME."
	state(choices) : "State at map start" : 0 =
	[
		0 : "Hidden (first trigger: active, next: completed)"
		1 : "Active"
		2 : "Completed"
	]
	order(integer) : "List position (0 = after the numbered ones)" : 0
	partof(target_destination) : "Part of (group objective)" : : "Listed under that trigger_objective. The group shows its done parts (1/3) and is completed when all are."
	count(integer) : "Counter target (0 = none; shows 2/3)" : 0
	target(target_destination) : "Target when completed"
	spawnflags(flags) =
	[
		1 : "Silent (no notice, no sound)" : 0
		2 : "Reset on new round" : 0
	]
]

// Text drawn in the world, read looking the way the entity points. Place it 1 unit in front of a wall.
// The origin is the start of the first line. Trigger: on, off or toggle.
@PointClass base(Targetname, Angles, MoveWith) size(-4 -4 -4, 4 4 4) color(255 190 60) iconsprite("sprites/editor/point_worldtext.spr") = point_worldtext : "World Text"
[
	spawnflags(flags) =
	[
		1 : "Start Off" : 0
		2 : "Center lines" : 0
	]
	message(string) : "Entity Message (\n = new line)" : "" : "The text, at most 1023 bytes (UTF-8)."
	textsize(string) : "Text Size (line height in units)" : "10"
	textspacingX(string) : "Text Spacing X (extra space between letters)" : "0"
	textspacingY(string) : "Text Spacing Y (extra space between lines)" : "0"
	color(color255) : "Color (R G B A)" : "255 255 255 255"
	font(choices) : "Font" : 0 =
	[
		0 : "Sans, black outline"
		1 : "Sans"
		12 : "Sans, glow"
		13 : "Sans, drop shadow"
		8 : "Mono (terminal), black outline"
		9 : "Mono (terminal)"
		10 : "Mono (terminal), drop shadow"
		11 : "Mono (terminal), glow"
	]
	orientation(choices) : "Orientation" : 0 =
	[
		0 : "Stationary (the entity's angles)"
		1 : "Face player"
		2 : "Face player, upright (ignore pitch)"
	]
	rainbow(choices) : "Rainbow" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
]

// Changes a control of a world screen for every player when triggered. Players who join later see the latest state.
@PointClass base(Targetname) size(-4 -4 -4, 4 4 4) color(80 255 120) iconsprite("sprites/editor/vgui_control_proxy.spr") = vgui_control_proxy : "World Screen Control"
[
	screen(target_destination) : "Screen (vgui_screen name)"
	controlname(string) : "Control Name (in the layout .res)"
	mode(choices) : "Change" : 0 =
	[
		0 : "Set the text (Label, Button) or value (bars, Slider: percent)"
		1 : "Enable"
		2 : "Disable"
		3 : "Show"
		4 : "Hide"
		5 : "Play animation (Text: the sequence)"
	]
	text(string) : "Text / value / sequence (at most 127 characters)" : : "Bars and sliders take a percentage, and Play animation takes a sequence of the layout's _anims.txt. A #Token gives localized text."
]

// World screen: a VGUI2 panel (ui/scripts/screens/<Panel Name>.res) on a rectangle in the world that players click.
// The origin is the lower-left corner seen from the front; the screen faces along Angles. A button fires Target and
// the key "~<command>" (add it with SmartEdit off). Trigger: on, off or toggle.
// Surface: a brush entity whose {screen faces (sbo_tools.wad) show the panel; Angles, Width and Height are then unused.
// Movie File: shows an Ogg Theora video instead of the panel; keep Width : Height equal to the video's.
@PointClass base(Targetname, Target, Angles, MoveWith) size(-4 -4 -4, 4 4 4) color(80 255 120) studio("models/editor/vgui_screen.mdl") = vgui_screen : "World Screen (VGUI2 panel)"
[
	panelname(string) : "Panel Name (ui/scripts/screens/<name>.res)" : "example_screen" : "The panel it shows, which isn't used with a Movie File. If left empty, the entity is removed, unless it has a Movie File."
	moviefilename(string) : "Movie File (.ogv in video/)" : : "If set, the screen shows this video instead of the panel."
	looping(choices) : "Movie Looping" : 0 =
	[
		0 : "No (stops on its last frame)"
		1 : "Yes"
	]
	health(integer) : "Movie Volume (10 = loudest)" : 10 : "How loud the movie is. If left empty or set to 0, it plays at full volume."
	radius(integer) : "Movie Sound Radius (units; silent beyond)" : 1250
	surface(target_destination) : "Surface (brush entity)" : : "A brush entity whose {screen faces show the panel. If left empty, the panel is placed by Angles, Width and Height."
	width(string) : "Width (world units)" : "32"
	height(string) : "Height (world units)" : "32"
	inputdistance(string) : "Input Distance (units, at most 4096)" : "128"
	showcursor(choices) : "Show Cursor" : -1 =
	[
		-1 : "Default (yes)"
		0 : "No"
		1 : "Yes"
	]
	spawnflags(flags) =
	[
		1 : "Start Inactive" : 0
		2 : "Input Disabled (display only)" : 0
		4 : "Movie sound everywhere" : 0
		8 : "Movie without sound" : 0
	]
]


