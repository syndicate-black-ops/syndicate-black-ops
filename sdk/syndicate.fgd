	]
]

// Mirror: reflects models (not the world) within Radius of the brush. For the room, build a mirrored copy behind a
// translucent mirror brush. Trigger to toggle. At most 32 active mirrors per map.
@SolidClass base(Targetname) = env_mirror : "Mirror: the brush is solid; off, it is drawn opaque"
[
	spawnflags(flags) =
	[
		1 : "Draw Player" : 0
		2 : "Start Off" : 0
	]
	radius(integer) : "Radius (from the brush's center)" : 330
	frags(choices) : "Mirror axis" : 0 =
	[
		0 : "X or automatic: the brush's thinnest side (X: a wall facing east / west)"
		1 : "Y: a wall facing north / south"
		2 : "Z: a shiny floor"
	]
	side(choices) : "Reflecting side" : 0 : "A floor (axis Z) left on Both reflects on its top face only." =
	[
		0 : "Both (the viewer's side; plane in the brush's middle)"
		1 : "Positive only (east / north / top face)"
		2 : "Negative only (west / south / bottom face)"
	]
	rendermode(choices) : "Render Mode" : 2 =
	[
		0 : "Normal (opaque: hides the mirrored room)"
		1 : "Color"
		2 : "Texture"
		5 : "Additive"
	]
	renderamt(integer) : "FX Amount (1 - 255; mirror's opacity)" : 100
	rendercolor(color255) : "FX Color (R G B)" : "0 0 0"
]

// Half-Life's model cycler, for looking at a model's animations: it plays its sequences in a loop; each hit
// moves it to the next sequence, a trigger or +use stops / starts it. Solid, takes no damage. For an animated
// prop in a map use env_model.
@PointClass base(Targetname, Angles, RenderFields, LightOrigin) size(-16 -16 0, 16 16 72) studio() = cycler : "Monster Cycler"
[
	model(studio) : "Model" : "" : "The model shown. If left empty, or set to an editor placeholder or a file the server doesn't have, the entity is removed at map start."
	sequence(integer) : "Animation sequence" : 0 : "With 0, it animates. With another number, it stands still on that sequence, and a hit then steps through its frames."
]

// An animated model with an on and an off sequence. Trigger: On, Off or Toggle.
// Solid (model hitboxes) needs a model compiled with $flags 512 and $hbox lines.
@PointClass base(Targetname, Angles, RenderFields, Colormap, EntityEffects, LightOrigin) size(-16 -16 0, 16 16 72) studio() = env_model : "Animated Model (on / off sequences)"
[
	model(studio) : "Model name" : "models/editor/env_model.mdl" : "The model to show. The default is an editor placeholder, so replace it, or the entity is removed at map start."
	skin(integer) : "Skin" : 0
	body(integer) : "Body" : 0
	scale(string) : "Scale (0 or 1 = normal)" : "1" : "How big the model is drawn. If left empty or set to 0 or 1, it is its normal size."
	frame(integer) : "Starting frame (-1 = random, 0-255)" : 0
	m_iszSequence_On(string) : "Sequence when on"
	m_iAction_On(choices) : "Behavior when on" : 0 =
	[
		0 : "Freeze when sequence ends"
		1 : "Loop"
		2 : "Change state when sequence ends"
	]
	m_flFramerate_On(string) : "Framerate when on (1 is default)"
	m_iszSequence_Off(string) : "Sequence when off"
	m_iAction_Off(choices) : "Behavior when off" : 0 =
	[
		0 : "Freeze when sequence ends"
		1 : "Loop"
		2 : "Change state when sequence ends"
	]
	m_flFramerate_Off(string) : "Framerate when off (1 is default)"
	material(choices) : "Material (Solid (model hitboxes))" : 4 : "The hit sound and effects of bullets on the hitboxes. Only with Solid (model hitboxes)." =
	[
		0 : "Glass"
		1 : "Wood"
		2 : "Metal"
		3 : "Flesh"
		4 : "Cinder Block"
		5 : "Ceiling Tile"
		6 : "Computer"
		7 : "Unbreakable Glass"
		8 : "Rocks"
	]
	spawnflags(flags) =
	[
		1 : "Initially Off" : 0
		2 : "Drop to Floor" : 0
		4 : "Solid (20 unit box)" : 0
		8 : "Solid (model hitboxes)" : 0
		16 : "Client-side animation" : 0
		32 : "Always send to clients (ignore PVS, costs bandwidth)" : 0
	]
	round_reset(choices) : "Reset at round start" : 0 : "With Yes, it goes back to its state at map load at each round start." =
	[
		0 : "No"
		1 : "Yes"
	]
]

// A model that moves along path_corners like a func_train, facing each next corner.
@PointClass studio() base(Targetname, RenderFields) size(-16 -16 -16, 16 16 16) color(0 128 255) = env_modeltrain : "Model Train"
[
	model(studio) : "Model"
	scale(string) : "Model Scale"
	target(target_destination) : "First stop target"
	speed(integer) : "Speed (units per second)" : 64 : "How fast it moves, in units per second. With 0, it moves at 100."
	m_iObeyTriggerMode(choices) : "Obey Trigger Mode" : 0 : "With No, any trigger starts or stops it. With Yes, On starts it, Off stops it and Toggle toggles it." =
	[
		0 : "No"
		1 : "Yes"
	]
	spawnflags(flags) =
	[
		4 : "Initially On" : 0
	]
	volume(string) : "Sound Volume 0.0 - 1.0" : "0.85"
	noise(sound) : "Move Sound"
	noise1(sound) : "Stop Sound"
	idle_sequence(string) : "Idle sequence" : : "The model sequence played while the train is stopped. If left empty, it plays the first one."
	idle_framerate(string) : "Custom idle framerate [default=1.0]"
	move_sequence(string) : "Move sequence" : : "The model sequence played while the train moves."
	move_framerate(string) : "Custom move framerate [default=1.0]"
	turn_policy(choices) : "Turn Policy" : 0 =
	[
		0 : "Instant (face to next target)"
		1 : "Instant, only YAW"
		2 : "No turn"
	]
]

// A picture or a color on the screens of players in play, under the HUD: hints, logos, tints and flashes.
// docs/ENV_OVERLAY.md
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/env_overlay.spr") = env_overlay : "Screen Overlay (picture or color on the screen)"
[
	spawnflags(flags) =
	[
		1 : "All Players" : 0
		2 : "Full Screen" : 0
		4 : "Start On (for all players)" : 0
		8 : "Loop" : 0
	]
	sprite(sprite) : "Picture (.spr or .tga)" : "" : "A sprite, animated or not, or a 24-bit or 32-bit .tga, e.g. sprites/hint.spr or gfx/hint.tga. If left empty, the overlay is a plain color, which needs Full Screen. Without Full Screen it shows nothing, and the console reports an error."
	x(string) : "X (0 - 1.0 = left to right) (-1 centers)" : "-1" : "Placed as with game_text. A negative number puts the right edge that far from the right."
	y(string) : "Y (0 - 1.0 = top to bottom) (-1 centers)" : "-1" : "Placed as with game_text. A negative number puts the bottom edge that far from the bottom."
	scale(string) : "Scale" : "1" : "With 1, the picture shows at its own size in pixels, which grows with the HUD (hud_scale). It isn't used with Full Screen."
	rendermode(choices) : "Render Mode" : 0 : "With Normal, the picture is blended by its own transparency. With Additive, it adds light, so black is see-through." =
	[
		0 : "Normal"
		5 : "Additive"
	]
	renderamt(integer) : "FX Amount (1 - 255)" : 255 : "The opacity, or the brightness with Additive. If left empty or set to 0, it is 255."
	rendercolor(color255) : "FX Color (R G B)" : "255 255 255" : "Tints the picture, and 255 255 255 keeps its own colors. It is also the color of a plain color overlay."
	framerate(string) : "Frame Rate" : "10" : "Frames per second of an animated sprite. With 0, it shows only the first frame."
	fadein(string) : "Fade In Time" : "0.5"
	holdtime(string) : "Hold Time" : "0" : "How long it stays on screen. With 0, it stays until it is turned off. With Loop, it is the time between the fades."
	fadeout(string) : "Fade Out Time" : "0.5" : "Also used when it is turned off."
	channel(choices) : "Channel" : 1 : "A player sees one overlay per channel, so a new one replaces the one on its channel. Channel 8 is drawn on top." =
	[
		1 : "Channel 1"
		2 : "Channel 2"
		3 : "Channel 3"
		4 : "Channel 4"
		5 : "Channel 5"
		6 : "Channel 6"
		7 : "Channel 7"
		8 : "Channel 8"
	]
]

// Color grading of the 3D view (Source's color correction): black and white, noir, sepia, tints or a lookup table
// file. The HUD keeps its colors. docs/COLOR_CORRECTION.md
@BaseClass base(Targetname, Master) = ColorCorrection
[
	StartDisabled(choices) : "Start Disabled" : 0 : "With Disabled, it is off until it is triggered. A name toggles it with On, Off or Toggle." =
	[
		0 : "No"
		1 : "Yes"
	]
	filename(string) : "Lookup Table File" : "" : "Optional. A Source .raw (32x32x32) or .cube table in gfx/colorcorrection/, e.g. tealorange.cube. Players download it. The simple keys below are applied after it."
	maxweight(string) : "Maximum Weight (0 - 1)" : "1" : "How strong the look is at full, where 1 is the full look and 0.5 is half way between the normal picture and the look."
	exclusive(choices) : "Exclusive" : 0 : "With Yes, while it is on, it takes its share from every other color correction, and the others fade under it." =
	[
		0 : "No"
		1 : "Yes"
	]
	saturation(string) : "Saturation" : "1" : "How strong the colors are, where 1 gives normal colors, 0 black and white, and above 1 stronger colors."
	contrast(string) : "Contrast" : "1" : "Where 1 is normal, above 1 is harder, with darker darks and brighter lights, and below 1 is flatter."
	brightness(string) : "Brightness" : "0" : "Added to every color, where 0 is normal, 0.1 is brighter and -0.1 is darker."
	gamma(string) : "Gamma" : "1" : "Where 1 is normal, above 1 gives brighter mid tones and below 1 darker mid tones."
	tintcolor(color255) : "Tint Color (R G B)" : "255 255 255" : "The picture is multiplied by this color, by Tint Amount, and 255 200 140 gives sepia."
	tintamount(string) : "Tint Amount (0 - 1)" : "0" : "How strong the tint is, from 0 for no tint up to 1 for the full tint."
]

// A color grade around a point: everywhere, or stronger the nearer the player is.
@PointClass base(ColorCorrection) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/color_correction.spr") = color_correction : "Color Correction (color grade of the view)"
[
	minfalloff(string) : "Full Strength Distance" : "-1" : "Units from this point where the look is at full strength. With -1, and Fade-Out Distance -1, the look is the same everywhere on the map."
	maxfalloff(string) : "Fade-Out Distance" : "-1" : "Units from this point where the look is gone; it fades in between."
	fadeInDuration(string) : "Fade In Time" : "0" : "Seconds to fade in when it is turned on."
	fadeOutDuration(string) : "Fade Out Time" : "0" : "Seconds to fade out when it is turned off."
]

// A color grade inside a brush: it fades in as the player's view enters the brush and out as it leaves.
@SolidClass base(ColorCorrection) = color_correction_volume : "Color Correction Volume (color grade inside the brush)"
[
	fadeDuration(string) : "Fade Time" : "1" : "Seconds to fade in when the view enters the brush, and out when it leaves (also when turned on or off)."
]

// Particle effect from an Aurora script (.aur). Every player sees it, including players who join later.
@PointClass base(Targetname, Angles) size(-8 -8 -8, 8 8 8) color(255 160 40) iconsprite("sprites/editor/env_particle.spr") particles("aurora/steamvent.aur") = env_particle : "Aurora Particle System: without a name it is always on; with a name, trigger it to toggle"
[
	spawnflags(flags) =
	[
		1 : "Start On (only with a Name)" : 0
		2 : "Spawn Use (one-shot copy at the activator)" : 0
	]
	message(string) : "Particle script" : "aurora/steamvent.aur" : "The .aur file, e.g. aurora/steamvent.aur (at most 63 characters). It is added to the downloads."
	target(target_destination) : "Move with entity" : "" : "An entity the effect moves and turns with, keeping its offset. Hidden while that entity is not visible."
	attachment(choices) : "Attachment point" : -1 : "With Move with on a model, it puts the effect on this attachment point of the model." =
	[
		-1 : "None (the entity's origin plus the offset)"
		0 : "Attachment 0"
		1 : "Attachment 1"
		2 : "Attachment 2"
		3 : "Attachment 3"
	]
]

// Quake particle effects. Players who join later do not see them.
@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) iconsprite("sprites/editor/env_quakefx.spr") = env_quakefx : "Quake 1 particle effects"
[
	message(string) : "Position [LP] (blank = here)"
	impulse(choices) : "Effect type" : 4 =
	[
		4 : "Tar Explosion"
		10 : "Lava Splash"
		11 : "Teleport Splash"
		12 : "Explosion"
		14 : "Implosion"
		122 : "Particle Burst"
	]
	frags(integer) : "Particle Burst: color number" : 70
	armortype(integer) : "Implosion/Particle Burst: radius" : 250
	health(string) : "Implosion/Particle Burst: duration" : "1.0"
	armorvalue(integer) : "Implosion tracer count" : 10
	spawnflags(flags) =
	[
		1 : "Repeatable" : 0
	]
]

// Rain or snow for the whole map, wherever the sky is above. Players set the amount with cl_weather 0-3.
// Without a name it is always on, and only the map's first unnamed env_rain (else env_snow) counts. A named one is a
// weather of its own: off at the start unless Start Active is set, switched on and off by triggers.
// For the rain sound, add looping ambient_generic entities with ambience/rain.wav outdoors.
@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) color(100 150 255) iconsprite("sprites/editor/env_rain.spr") = env_rain : "Rain (whole map)"
[
	spawnflags(flags) =
	[
		1 : "Start Active (always on without a name)" : 0
		2 : "Allow indoor (no sky needed above)" : 0
		4 : "Raindrops not affected by wind" : 0
		32 : "No wind puffs" : 0
		64 : "No rain splashes" : 0
		128 : "No ripples on water" : 0
		256 : "Raindrops go through brush entities" : 0
		512 : "Don't stop at the water surface" : 0
	]
	intensity(integer) : "Raindrops per update" : 150 : "Spread within 400 units around each player's view. At most 1000."
	update_period(string) : "Update period (seconds)" : "0.3" : "Seconds between batches of raindrops."
	raindrop_width(integer) : "Raindrop width (units)" : 2
	raindrop_height(integer) : "Raindrop tallness (units)" : 80
	raindrop_min_speed(integer) : "Raindrop min falling speed" : 500
	raindrop_max_speed(integer) : "Raindrop max falling speed" : 1800
	raindrop_life(string) : "Raindrop max life (seconds)" : "1.0"
	wind_x(integer) : "Wind X" : : "Sideways speed of every raindrop along the map's X axis, in units per second, and they fall at 500 to 1800. If you set Wind X or Wind Y, this rain blows with that fixed wind instead of the random wind that changes every 15 to 30 seconds. If both are left empty, it uses the random wind."
	wind_y(integer) : "Wind Y" : : "Sideways speed of every raindrop along the map's Y axis, in units per second. See Wind X."
	wind_rand_x(integer) : "Wind spread X" : : "Each raindrop gets a random extra sideways speed along X, from minus this to this, in units per second, on the fixed or the random wind. If left empty or set to 0, there is none."
	wind_rand_y(integer) : "Wind spread Y" : : "Each raindrop gets a random extra sideways speed along Y, from minus this to this, in units per second. If left empty or set to 0, there is none."
]

// Copies its render settings to its targets, at once or as a smooth fade.
@PointClass base(Targetname, Target, RenderFields) size(-16 -16 -16, 16 16 16) color(100 100 0) iconsprite("sprites/editor/env_render.spr") = env_render : "Render Controls"
[
	message(string) : "FX Amount factor [LR]" : "" : "Multiplies the FX Amount given to the targets (a number, a..b, or a calc entity)."
	m_fScale(string) : "Scale (0 = no change)" : "0" : "Model or sprite scale given to the targets. Their hitboxes and solid box change with it, step by step during a fade."
	frags(string) : "Fade Time (seconds, 0 = at once)" : "0" : "FX Amount, color and scale change smoothly over this time. Mode and FX change at once."
	netname(target_destination) : "Trigger after fading" : "" : "Fired once when the change is done; the activator is the first target."
	spawnflags(flags) =
	[
		1 : "No Renderfx" : 0
		2 : "No Renderamt" : 0
		4 : "No Rendermode" : 0
		8 : "No Rendercolor" : 0
		32 : "Remove target (after a fade only)" : 0
		64 : "Remove self (after use)" : 0
	]
]

@PointClass base(Targetname) iconsprite("sprites/editor/env_shake.spr") = env_shake : "Screen Shake"
[
	spawnflags(flags) =
	[
		1 : "GlobalShake" : 0
	]
	amplitude(string) : "Amplitude 0-16" : "4" : "How strong the shake is, from 0 for none up to 16. If left empty, nothing shakes."
	radius(string) : "Effect radius" : "500" : "How far from its position players shake. If left empty, every player shakes, as with GlobalShake."
	duration(string) : "Duration (seconds)" : "1" : "Seconds the shake lasts. If left empty, nothing shakes."
	frequency(string) : "0.1 = jerk, 255.0 = rumble" : "2.5" : "How fast the view moves back and forth, from 0.1 for a single jolt up to 255 for a rumble. If left empty, nothing shakes."
	message(string) : "Position [LP] (blank = here)" : "" : "Where the shake is, given as x y z, an entity name or !activator."
]

