@PointClass base(GibshooterBase, RenderFields, MoveWith) size(-16 -16 -16, 16 16 16) iconsprite("sprites/editor/env_shooter.spr") = env_shooter : "Model Shooter"
[
	shootmodel(studio) : "Model or Sprite name" : "" : "The .mdl or .spr it shoots. If left empty, or set to an editor model or a missing file, the entity is removed. It can't be changed while the map runs."
	shootsounds(choices) : "Material Sound" : -1 =
	[
		-1 : "None"
		0 : "Glass"
		1 : "Wood"
		2 : "Metal"
		3 : "Flesh"
		4 : "Concrete"
	]
	scale(string) : "Gib Scale" : "" : "The size of each gib or shot, model or sprite, so 2 is double and 0.5 is half. If left empty or set to 1, it is its normal size."
	skin(integer) : "Gib Skin" : 0
	spawnflags(flags) =
	[
		1 : "Repeatable" : 0
		4 : "Don't wait till land" : 0
		8 : "Start instantly" : 0
	]
