@BaseClass base(Targetname, Targetx, RenderFields, Appearflags, Angles, BodySkin, CustomObjectHint, Colormap) size(-16 -16 0, 16 16 32) color(0 0 200) = Weapon []
@BaseClass base(Targetname, Target, RenderFields, Appearflags, Angles, BodySkin, ModelScale, CustomObjectHint, Colormap) size(-16 -16 0, 16 16 36) = ItemBase []
@BaseClass = ItemPickupFlags
[
	spawnflags(flags) =
	[
		128 : "TOUCH only" : 0
		256 : "USE only" : 0
	]
]
@BaseClass base(Appearflags, Angles) size(-16 -16 -36, 16 16 36) color(0 255 0) studio("models/player.mdl") = PlayerClass []


@BaseClass base(Targetname, Target, RenderFields, Angles, ModelScale) color(0 200 200) = Monster
[
	TriggerTarget(string) : "TriggerTarget"
	bloodcolor(choices) : "Blood Color" : 0 : "The color of its blood, decals and gibs. Default: the monster's own." =
	[
		-1 : "Don't bleed"
		0 : "Default"
		247 : "Human (red)"
		195 : "Alien (yellow)"
		70 : "Dark red"
		192 : "Bright yellow"
		244 : "Green"
	]
	gibmodel(studio) : "Custom gib model" : "" : "When gibbed, it throws 4 gibs of this model (random submodels)."
	trigger_on_death(target_destination) : "Trigger on death" : "" : "Fired once when it is killed; the activator is the killer."
	TriggerCondition(choices) : "Trigger Condition" : 0 =
	[
		0 : "No Trigger"
		1 : "See Player, Mad at Player"
		2 : "Take Damage"
		3 : "50% Health Remaining"
		4 : "Death"
		7 : "Hear World"
		8 : "Hear Player"
		9 : "Hear Combat"
		10 : "See Player Unconditional"
		11 : "See Player, Not In Combat"
		12 : "Provoked by a player"
		13 : "Got healed"
	]
	TriggerAltCondition(choices) : "Trigger Alternative Condition" : 0 : "A second condition that fires TriggerTarget (whichever comes first, once)." =
	[
		0 : "No Trigger"
		1 : "See Player, Mad at Player"
		2 : "Take Damage"
		3 : "50% Health Remaining"
		4 : "Death"
		7 : "Hear World"
		8 : "Hear Player"
		9 : "Hear Combat"
		10 : "See Player Unconditional"
		11 : "See Player, Not In Combat"
		12 : "Provoked by a player"
		13 : "Got healed"
	]
	classify(choices) : "Classification" : "" : "Who it fights and who fights it. Empty or 0: its own class." =
	[
		-1 : "None"
		0 : "Default"
		1 : "Machine"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
	is_player_ally(choices) : "Is player ally" : 0 : "Yes: it changes sides. A barney follows on +use only as an ally with Followage policy Regular." =
	[
		0 : "No"
		1 : "Yes"
	]
	gib_policy(choices) : "Gibbing policy" : 0 : "A kill that always or never gibs still wins." =
	[
		0 : "Default"
		1 : "Prefer gibbing"
		2 : "Prefer not to gib"
	]
	field_of_view(choices) : "Custom Field Of View" : "" : "How wide it sees. Empty or 0: its own." =
	[
		0 : "Default"
		-1 : "Full"
		"-0.7" : "Wide (humans)"
		"-0.2" : "Broad"
		"0.2" : "Average"
		"0.5" : "Tunnel"
		"0.7" : "Narrow"
		"0.9" : "Ultra narrow"
	]
	soundmask(choices) : "Custom Sound Mask" : "" : "The sounds it reacts to. Empty or 0: its own." =
	[
		-1 : "No sounds (deaf)"
		0 : "Default for monster"
		32 : "Only Danger"
		33 : "Only Combat and Danger"
		37 : "Combat, Danger and Player"
		127 : "Every sound and scent"
		1028 : "Default, except Player"
	]
	prisonerto(choices) : "Prisoner to" : 0 : "It and this class ignore each other." =
	[
		0 : "None"
		1 : "Machine"
		2 : "Player"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
	ignoredby(choices) : "Ignored by" : 0 : "This class ignores it, but it still sees them." =
	[
		0 : "None"
		1 : "Machine"
		2 : "Player"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
	freeroam(choices) : "Freeroam" : 0 : "When idle, it walks from node to node (needs nodes)." =
	[
		0 : "Map default"
		1 : "Never"
		2 : "Always"
	]
	active_alert(choices) : "Active after combat" : 0 : "After a fight, it goes toward gunfire it hears instead of standing still." =
	[
		0 : "Default (no)"
		1 : "Never"
		2 : "Always"
	]
	spawnflags(flags) =
	[
		1 : "WaitTillSeen" : 0
		2 : "Gag" : 0
		4 : "MonsterClip" : 0
		16 : "Prisoner" : 0
		128 : "WaitForScript" : 0
		256 : "Pre-Disaster" : 0
		512 : "Fade Corpse" : 0
	]
]
@BaseClass = TalkMonster
[
	UseSentence(string) : "Use Sentence"
	UnUseSentence(string) : "Un-Use Sentence"
	voicepitch(integer) : "Voice pitch" : 0 : "The pitch of its voice (100 normal). 0: its own."
	followage_policy(choices) : "Followage policy" : "" : "Empty: scientists follow on +use, barneys do not. Regular: ally barneys follow too. Scripted only: only scripted_following makes it follow." =
	[
		0 : "Regular"
		1 : "Scripted only"
		2 : "Scripted only, decline use"
	]
	followfailpolicy(choices) : "Follow failure policy" : 0 : "What it does when it cannot reach the player it follows. Default: scientists stop following, others keep trying." =
	[
		0 : "Default"
		1 : "Keep trying"
		2 : "Stop following"
		3 : "Run to the nearest spot"
	]
	suspicious(choices) : "Pre-provoked" : 0 : "Yes: it dislikes players from the start." =
	[
		0 : "No"
		1 : "Yes"
	]
	tolerance(choices) : "Tolerance level" : 0 : "How many hits from a player make it hostile. Default: Low for barneys, Zero for scientists." =
	[
		0 : "Default"
		1 : "Zero: any hit"
		2 : "Low: a direct hit or a second hit"
		3 : "Average: a second direct hit"
		4 : "High: three direct hits within 4 seconds"
		5 : "Absolute: never"
		6 : "Absolute, don't alert friends"
	]
	alert_friends(choices) : "Alert friends" : 0 : "Whether killing it makes its friends who see it hostile. Default: always." =
	[
		0 : "Default"
		1 : "Always"
		2 : "If not in combat"
		3 : "Never"
	]
	RefusalSentence(string) : "Refusal Sentence" : "" : "The sentence group it says when it refuses to follow. null: says nothing."
	SpeakAs(string) : "Speech Prefix" : "" : "Speak another voice's lines (BA barney, SC scientist). Lines that voice lacks stay silent."
]

// Charger options
@BaseClass = Recharger
[
	TriggerOnFirstUse(target_destination) : "Trigger On First Use" : "" : "Fired once, the first time it gives a player some charge."
	TriggerOnEmpty(target_destination) : "Trigger On Empty" : "" : "Fired when a player uses it after it ran out."
	TriggerOnRecharged(target_destination) : "Trigger On Recharged" : "" : "Fired when it fills up again."
	CustomLoopSound(sound) : "Custom Loop Sound" : ""
	CustomDeniedSound(sound) : "Custom Denied Sound" : ""
	CustomStartSound(sound) : "Custom Start Sound" : ""
	CustomRechargeSound(sound) : "Custom Recharge Sound" : "" : "Played when it fills up again (the suit charger plays none by default)."
	CustomJuice(integer) : "Custom Juice Amount" : : "The armor it holds. Empty or 0: the skill setting."
]

@BaseClass base(Targetname, Targetx, Angles) size(-16 -16 0, 16 16 72) color(255 0 255) = Scripted
[
	m_iszEntity(string) : "Target Monster"
	m_iszPlay(string) : "Action Animation" : ""
	m_flRadius(integer) : "Search Radius" : 512
	m_flRepeat(integer) : "Repeat Rate ms" : 0
	m_fMoveTo(choices) : "Move to Position" : 0 =
	[
		0 : "No"
		1 : "Walk"
		2 : "Run"
		4 : "Instantaneous"
		5 : "No - Turn to Face"
		7 : "Teleport"
	]
	m_iszFireOnPossessed(target_destination) : "Fire on Possession" : "" : "Fired when the script takes its monster (activator: this script)."
	m_iszFireOnBegin(target_destination) : "Fire after moving" : "" : "Walk / Run: fired when the monster reaches the mark and the script may start (activator: this script)."
	m_iszFireOnAnimStart(target_destination) : "Fire on Animation start" : "" : "Fired when the Action Animation starts (activator: this script)."
	master(string) : "Master" : "" : "While the master is locked the script waits (it looks again every second)."
	m_interruptionPolicy(choices) : "Interruption policy" : 0 : "What breaks the monster out of the script." =
	[
		0 : "Default (by any damage)"
		1 : "No Interruptions (same as flag)"
		2 : "By Death Only"
	]
	m_takeDamagePolicy(choices) : "TakeDamage policy" : 0 : "Damage while the script holds the monster." =
	[
		0 : "As usual"
		1 : "Invulnerable during script"
		2 : "Non-lethal damage"
	]
	m_searchPolicy(choices) : "Search target monster by..." : 0 : "Target Monster as a name, a class name or both." =
	[
		0 : "Targetname, then classname"
		1 : "Targetname only"
		2 : "Classname only"
	]
	m_applySearchRadius(choices) : "Test against search radius" : 0 : "Always: a monster found by name must be within the Search Radius too." =
	[
		0 : "When searching by classname"
		1 : "Always"
	]
	required_state(choices) : "Required MonsterState" : 0 : "The script takes a monster only in this state." =
	[
		0 : "Any"
		1 : "Idle"
		2 : "Combat"
		3 : "Alert, Hunt"
		4 : "Non-combat (Idle, Alert, Hunt)"
	]
	moveto_radius(string) : "Move to target's radius" : "" : "Walk / Run: the monster stops this close to the mark (and plays there). Empty or 0: on the mark."
	m_fTurnType(choices) : "Turn mode" : 0 : "How the monster turns before the action." =
	[
		0 : "Match turn target's angle"
		1 : "Turn to target"
		2 : "Don't Turn"
