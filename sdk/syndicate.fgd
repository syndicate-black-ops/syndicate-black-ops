@PointClass base(trigger_cdaudio) iconsprite("sprites/editor/target_cdaudio.spr") = target_cdaudio : "CD Audio Target"
[
	radius(string) : "Player Radius"
]

@PointClass base(Targetname, Targetx) iconsprite("sprites/editor/trigger_changetarget.spr") = trigger_changetarget : "Trigger Change Target"
[
	m_iszNewTarget(string) : "New Target"
]

@SolidClass base(Targetname, Targetx, Master, Appearflags) = trigger_counter : "Trigger counter"
[
	spawnflags(flags) =
	[
		1 : "No Message" : 0
	]
	message(string) : "Message"
	count(integer) : "Count before activation" : 2 : "Fires its target after this many triggers. game_counter does more."
]

@SolidClass base(Targetname) = trigger_gravity : "Trigger Gravity"
[
	gravity(string) : "Gravity Multiplier (1.0 default)" : "1.0"
]

@SolidClass base(Targetname, Targetx, Master) = trigger_hurt : "Trigger player hurt"
[
	spawnflags(flags) =
	[
		1 : "Target Once" : 0
		2 : "Start Off" : 0
		8 : "No clients" : 0
		16 : "FireClientOnly" : 0
		32 : "TouchClientOnly" : 0
		64 : "Affect non-moving NPC's" : 0
		128 : "Full dmg every 0.5 seconds" : 0
		256 : "Ignore Armor" : 0
		512 : "No Camera Punch" : 0
	]
	dmg(integer) : "Damage" : 10
	untouchable_ent_name(string) : "Untouchable entity name" : "" : "Nothing with this class name or name is hurt."
	min_health(string) : "Minimum health threshold" : "" : "Damage never takes health below this. Empty or 0: no minimum."
	gib_policy(choices) : "Gibbing policy" : 0 : "What happens to a body killed by this trigger." =
	[
		0 : "Default"
		1 : "Always gib"
		2 : "Never gib"
	]
	delay(string) : "Delay before trigger" : "0"
	damagetype(choices) : "Damage Type" : 0 =
	[
		0 : "GENERIC"
		1 : "CRUSH"
		2 : "BULLET"
		4 : "SLASH"
		8 : "BURN"
		16 : "FREEZE"
		32 : "FALL"
		64 : "BLAST"
		128 : "CLUB"
		256 : "SHOCK"
		512 : "SONIC"
		1024 : "ENERGYBEAM"
		16384 : "DROWN"
		32768 : "PARALYSE"
		65536 : "NERVEGAS"
		131072 : "POISON"
		262144 : "RADIATION"
		524288 : "DROWNRECOVER"
		1048576 : "CHEMICAL"
		2097152 : "SLOWBURN"
		4194304 : "SLOWFREEZE"
	]
	m_iObeyTriggerMode(choices) : "Obey Trigger Mode" : 0 : "No: any trigger turns it on or off. Yes: On turns it on, Off turns it off, Toggle toggles." =
	[
		0 : "No (always toggle)"
		1 : "Yes"
	]
]

// Damages or heals named entities or a whole class, without a brush.
@PointClass base(Targetname) color(180 120 255) iconsprite("sprites/editor/trigger_hurt_remote.spr") = trigger_hurt_remote : "Trigger Hurt (no touch)"
[
	spawnflags(flags) =
	[
		1 : "Instant kill (heal: to full health)" : 0
		2 : "Constant (every Delay seconds while on)" : 0
		4 : "Start on (Constant only)" : 0
		8 : "Do armor damage" : 0
		16 : "Do damage to dead (corpses)" : 0
		256 : "Ignore armor" : 0
		512 : "No camera punch" : 0
	]
	target(target_destination) : "Target [LE]" : : "The entities with this name are hurt. !activator: whoever triggered it."
	targetclass(string) : "Target class name" : : "Every entity of this class is hurt too (player: every player in play)."
	dmg(integer) : "Damage" : 10 : "Damage per trigger, or per Delay with Constant. Negative: heals instead."
	damagetype(choices) : "Damage type" : 0 =
	[
		0 : "GENERIC"
		1 : "CRUSH"
		2 : "BULLET"
		4 : "SLASH"
		8 : "BURN"
		16 : "FREEZE"
		32 : "FALL"
		64 : "BLAST"
		128 : "CLUB"
		256 : "SHOCK"
		512 : "SONIC"
		1024 : "ENERGYBEAM"
		16384 : "DROWN"
		32768 : "PARALYSE"
		65536 : "NERVEGAS"
		131072 : "POISON"
		262144 : "RADIATION"
		524288 : "DROWNRECOVER"
		1048576 : "CHEMICAL"
		2097152 : "SLOWBURN"
		4194304 : "SLOWFREEZE"
	]
	gib_policy(choices) : "Gibbing policy" : 0 : "Whether a kill turns the body into gibs." =
	[
		0 : "Default (by damage)"
		1 : "Always gib"
		2 : "Never gib"
	]
	delay(string) : "Delay (Constant only)" : "1" : "Seconds between two hurts while it is on."
	min_health(string) : "Minimum health" : : "Damage never takes health below this. Empty or 0: no minimum."
	armordmg(string) : "Armor damage" : : "With 'Do armor damage': armor taken from a player each time (down to 0); negative gives armor (up to 100)."
]

// Fires for each entity that enters and for each that leaves; the entity is the activator.
@SolidClass base(Targetname, Master) = trigger_inout : "Trigger: Activate on entering or leaving"
[
	target(target_destination) : "Fire on entering"
	m_iszAltTarget(target_destination) : "Fire on leaving"
	m_iszBothTarget(target_destination) : "Fire on/off (On entering, Off leaving)"
	netname(string) : "Triggered only by entity (class name or name)"
	spawnflags(flags) =
	[
		1 : "Monsters" : 0
		2 : "No Clients" : 0
		4 : "Pushables" : 0
		8 : "Everything else" : 0
	]
]

// Jump pad: launches the toucher on an arc to the Jump target. It has no sound: fire an ambient_generic from Trigger on jump.
@SolidClass base(Targetname, Master) = trigger_jump : "Trigger Jump (jump pad)"
[
	target(target_destination) : "Jump target [LP]" : "" : "Where the toucher lands: an entity name or x y z."
	height(string) : "Height [0 = auto]" : "0" : "How high the arc goes above the toucher. 0: just above the target or the toucher, whichever is higher."
	trigger_on_jump(target_destination) : "Trigger on jump" : "" : "Fired for every launch; the activator is the toucher."
	netname(string) : "Triggered only by entity (class name or name)"
	spawnflags(flags) =
	[
		1 : "Monsters" : 0
		2 : "No Clients" : 0
		4 : "Pushables" : 0
		8 : "Everything else" : 0
	]
]

// Kills the monsters that match its filters, with a death animation or gibs.
@PointClass base(Targetname) color(180 120 255) iconsprite("sprites/editor/trigger_killmonster.spr") = trigger_killmonster : "Trigger Kill Monster"
[
	spawnflags(flags) =
	[
		1 : "Remove on fire (works once)" : 1
		16 : "Always gib" : 0
	]
	target(target_destination) : "Monster's name" : : "Kills living monsters with this name. Every filter that is set must match."
	message(string) : "Monster's class name" : : "Kills living monsters of this class, e.g. monster_zombie. Every filter that is set must match."
	netname(string) : "Monster's squad name" : : "Kills living monsters with this squad name. Every filter that is set must match."
]

// Fires when a player in the brush looks at the target long enough.
@SolidClass base(Targetname, Master) = trigger_look : "Trigger Look (fire when a player looks at something)"
[
	spawnflags(flags) =
	[
		1 : "Remove on fire (works once)" : 1
	]
	netname(target_destination) : "Look target" : : "The entity the player must look at (its origin)."
	look_time(string) : "Look time" : "1" : "Seconds the player must keep looking. Looking away starts it over."
	field_of_view(string) : "Field of view" : "0.7" : "How exactly the player must look: 1.0 dead center, 0.7 about 45 degrees, 0 90 degrees, -1 any direction."
	target(target_destination) : "Target (fired on look)" : : "Fired with the looking player as !activator."
	killtarget(target_destination) : "Kill target"
	delay(string) : "Delay before trigger" : "0"
]

@SolidClass base(Angles, Master) = trigger_monsterjump : "Trigger monster jump"
[
	speed(integer) : "Jump Speed" : 200 : "Speed the monster jumps with, in the trigger's direction. 0: 200."
	height(integer) : "Jump Height" : 150 : "Upward speed added to the throw (0: 150)."
]

@SolidClass base(Trigger) = trigger_multiple : "Trigger: Activate multiple"
[
	wait(integer) : "Delay before reset" : 10
	noise(sound) : "Sound to play" : "" : "Played at the trigger each time it fires."
	spawnflags(flags) =
	[
		8 : "Everything else" : 0
	]
]

@SolidClass base(Trigger) = trigger_once : "Trigger: Activate once"
[
	noise(sound) : "Sound to play" : "" : "Played at the trigger when it fires."
	spawnflags(flags) =
	[
		8 : "Everything else" : 0
	]
]

// Freezes players in place: they can look around but not move, shoot or use.
@PointClass base(Targetname) color(180 120 255) iconsprite("sprites/editor/trigger_playerfreeze.spr") = trigger_playerfreeze : "Trigger Player Freeze"
[
	use_type(choices) : "Use type" : 0 : "What a trigger does. Players stay frozen until unfrozen, until they die, or until a new round." =
	[
		-1 : "Unfreeze"
		0 : "Toggle freeze (each player: frozen if free, free if frozen)"
		1 : "Freeze"
		2 : "Copy input (On freezes, Off unfreezes, Toggle toggles)"
	]
	spawnflags(flags) =
	[
		1 : "All players (not only the activator)" : 0
	]
]

@SolidClass base(Trigger, Angles) = trigger_push : "Trigger player push"
[
	spawnflags(flags) =
	[
		1 : "Push Once Only" : 0
		2 : "Start Off" : 0
		8 : "No clients" : 0
		16 : "No monsters" : 0
	]
	speed(integer) : "Speed of push" : 40
	m_iszPushSpeed(string) : "Speed factor [LR]" : "" : "Multiplies the push for each toucher (!activator is the toucher)."
	m_iszPushVel(string) : "Push direction [LV] (blank = angles)" : "" : "The push direction instead of the angles (times Speed of push)."
	m_iObeyTriggerMode(choices) : "Obey Trigger Mode" : 0 : "No: any trigger turns it on or off. Yes: On turns it on, Off turns it off, Toggle toggles." =
	[
		0 : "No (always toggle)"
		1 : "Yes"
	]
]

@PointClass base(Targetname, Targetx) iconsprite("sprites/editor/trigger_relay.spr") = trigger_relay : "Trigger Relay"
[
	triggerstate(choices) : "Trigger State" : 2 =
	[
		0 : "Off"
		1 : "On"
		2 : "Toggle"
		-1 : "Copy Input"
		-2 : "Reverse Input"
	]
	spawnflags(flags) =
	[
		1 : "Remove On fire" : 0
		64 : "Forward activator" : 0
		128 : "Pass caller as activator" : 0
	]
	m_flDelayBeforeReset(string) : "Delay Before Reset" : "" : "After it fires, it ignores every trigger for this many seconds."
]

// A player falling through it takes no fall damage on landing.
@SolidClass base(Targetname, Master) = trigger_safe_fall : "Trigger Safe Fall (no fall damage)" []

// Runs an entry of the map's sequence file, sequences/<map name>.seq: timed lines that fire targets,
// show HUD text and play sounds. On or Toggle starts it over, Off stops it.
@PointClass base(Targetname) color(180 120 255) iconsprite("sprites/editor/trigger_sequence.spr") = trigger_sequence : "Trigger Sequence (sequences/<map>.seq)"
[
	spawnflags(flags) =
	[
		1 : "Fire once" : 0
	]
	sequence_id(string) : "Sequence name (entry of the .seq file, without the %)"
]

@SolidClass base(Targetname, Target, Master) = trigger_teleport : "Trigger teleport"
[
	message(target_destination) : "Landmark (seamless)" : "" : "A point entity at the trigger, for a seamless teleport: the toucher keeps its place relative to Target, speed and view."
	spawnflags(flags) =
	[
		1 : "Monsters" : 0
		2 : "No Clients" : 0
		64 : "Random destination" : 0
		128 : "Relative (no landmark)" : 0
		256 : "Keep angles (no landmark)" : 0
		512 : "Keep velocity (no landmark)" : 0
		1024 : "Grenades, items (landmark)" : 0
	]
	teleport_start_inactive(choices) : "Start Inactive" : 0 : "Yes: it does nothing until triggered on. Needs a name." =
	[
		0 : "No"
		1 : "Yes"
	]
]

// Locks or unlocks the controls of the func_tracktrain or func_vehicle named Target.
// On unlocks, Off locks, Toggle switches.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/trigger_vehiclecontrols.spr") = trigger_vehiclecontrols : "Lock / unlock vehicle controls"
[
	target(target_destination) : "Train or vehicle"
]


