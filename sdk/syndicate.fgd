[
	spawnflags(flags) =
	[
		1 : "All Players" : 0
	]
	title(string) : "Title" : : "One line in a title bar. Empty: no title bar."
	message(string) : "Text (\n = new line)" : : "#Token: localized text. At most 1023 bytes."
	distance(string) : "Autoclose distance (0 = none)" : "0" : "The box closes when the player moves farther than this from the position."
	position(target_destination) : "Autoclose position (entity name or x y z; empty = here)"
]

// Plays a full-screen video for the activator, or every player. The player cannot move while it plays; Esc ends it.
