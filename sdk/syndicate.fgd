		2 : "Repeatable" : 0
		4 : "No Fireball" : 0
		8 : "No Smoke" : 0
		16 : "No Decal" : 0
		32 : "No Sparks" : 0
		64 : "No Sound" : 0
		128 : "Activator is attacker" : 0
	]
	iradius(integer) : "Damage radius" : 0 : "How far the damage reaches. With 0, it reaches 2.5 times the Magnitude."
	model(sprite) : "Custom Fireball Sprite" : "" : "The fireball sprite. If left empty, it uses the stock fireball."
	smokesprite(sprite) : "Custom Smoke Sprite" : "" : "The smoke sprite. If left empty, it uses the stock smoke."
	scale(string) : "Custom sprite scale" : "" : "The fireball and smoke scale, where 1 is the sprite's own size. If left empty or set to 0, the Magnitude sets it."
]

