@PointClass sprite() base(Targetname, RenderFields, Angles) size(-4 -4 -4, 4 4 4) = cycler_wreckage : "Wreckage: a sprite or model (not animated) that keeps puffing smoke"
[
	model(sprite) : "Sprite Name" : "sprites/fire.spr" : "The sprite or model shown. If left empty, nothing is shown and only the smoke puffs."
	scale(string) : "Scale" : "1.0" : "How big the sprite or model is drawn, where 1 is its normal size. If left empty or set to 0, it is its normal size."
]

@PointClass base(Targetname, BeamStartEnd, RenderFxChoices) size(-16 -16 -16, 16 16 16) iconsprite("sprites/editor/env_beam.spr") = env_beam : "Energy Beam Effect"
[
	renderamt(integer) : "Brightness (1 - 255)" : 100 : "How bright the beam is, from 1 to 255. If left empty, the beam can't be seen."
	rendercolor(color255) : "Beam Color (R G B)" : "0 0 0"
	Radius(integer) : "Radius" : 256 : "How far it reaches for a random strike when it has no End Entity. If left empty, it makes no strikes."
	life(string) : "Life (seconds 0 = infinite)" : "1" : "Seconds each strike lasts, and 0 keeps the beam on. If left empty, the beam stays on."
	BoltWidth(integer) : "Width of beam (pixels*0.1 0-255)" : 20 : "How wide the beam is. If left empty, the beam has no width and can't be seen."
	NoiseAmplitude(integer) : "Amount of noise (0-255)" : 0
	texture(sprite) : "Sprite Name" : "sprites/laserbeam.spr" : "The beam sprite. If left empty, the entity removes itself and there is no beam."
	TextureScroll(integer) : "Texture Scroll Rate (0-100)" : 35 : "How fast the texture scrolls along the beam. If left empty, it doesn't scroll."
	framerate(integer) : "Frames per 10 seconds" : 0
	framestart(integer) : "Starting Frame" : 0
	StrikeTime(string) : "Strike again time (secs)" : "1" : "Seconds between strikes, counted after Life ends. If left empty, it strikes again as soon as Life ends."
	damage(string) : "Damage / second" : "0"
	spawnflags(flags) =
	[
		1 : "Start On" : 0
		2 : "Toggle" : 0
		4 : "Random Strike" : 0
		8 : "Ring" : 0
		16 : "StartSparks" : 0
		32 : "EndSparks" : 0
		64 : "Decal End" : 0
		128 : "Shade Start" : 0
		256 : "Shade End" : 0
		512 : "Draw Solid" : 0
		1024 : "Draw Sine" : 0
		4096 : "No Camera Punch" : 0
	]
]

