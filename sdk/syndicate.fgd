// Makes the flashlight of the player who fires it flicker (On) or stop (Off).
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/player_flicker.spr") = player_flicker : "Player flashlight flicker" []

// Gives, takes or sets an inventory item of the player who fires it (Shared: of the team's shared items, whoever or
// whatever fires it). Taking an item that came from an item_pickup uses that pickup up: it is hidden until a round
// restart (Shared: until a round start with Reset at round start on the item_pickup). Items given here have no
// pickup: the player loses them on death, on leaving or at a round restart; for keys the team must not lose, use an
// item_pickup or Shared.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/player_inventory.spr") = player_inventory : "Player inventory (give / take / set an item)"
[
	item_name(string) : "Item name" : : "Up to 31 characters. If left empty with Remove or Set and a Count of 0, it takes every item."
	item_icon(choices) : "HUD icon" : "inv_key" : "When this gives a new item, its icon from sprites/hud.txt." =
	[
		"inv_key" : "Key"
		"inv_card_red" : "Red keycard"
		"inv_card_blue" : "Blue keycard"
		"inv_card_yellow" : "Yellow keycard"
	]
	operation(choices) : "Operation" : 0 : "With Use type, On or Toggle gives, Off takes, and Set sets the count to the value it is fired with." =
	[
		-1 : "Remove"
		0 : "Use type"
		1 : "Give"
		2 : "Set"
	]
	count(integer) : "Count" : 1 : "For Give and Remove, 0 or less counts as 1. For Set, the new count, or with Use type, the value it is fired with."
	collect_limit(integer) : "Maximum" : 0 : "The most of the item a Give or Set gives, and above it, On Max Count Limit fires, or On Count Overflow when it goes over. With 0, the only limit is 32767."
	on_count_change(target_destination) : "On Count Change" : : "Fired when the count changed."
	on_item_limit(target_destination) : "On Item Limit" : : "Fired when no new item fits (16 different items)."
	on_max_count_limit(target_destination) : "On Max Count Limit" : : "Fired when the item is at its Maximum already."
	on_count_overflow(target_destination) : "On Count Overflow" : : "Fired when the count went over the Maximum."
	round_reset(choices) : "Reset at round start" : 0 : "With Yes, Remove On Fire turns it off until the next round instead of removing it. With Shared, at each round start the team's count of this item goes back to what it holds from item_pickups." =
	[
		0 : "No"
		1 : "Yes"
	]
	spawnflags(flags) =
	[
		1 : "Remove On Fire" : 0
		2 : "Allow going over Maximum" : 0
		4 : "Shared (whole team)" : 0
	]
]

// Fires Pass Target if the player who fires it has the inventory item, else Fail Target (Shared: if the team has it,
// whoever or whatever fires it). As a master (e.g. of a door or button), it passes while that is so.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/player_hasinventory.spr") = player_hasinventory : "Player has inventory item"
[
	item_name(string) : "Item name"
	pass_target(target_destination) : "Pass Target"
	fail_target(target_destination) : "Fail Target"
	spawnflags(flags) =
	[
		4 : "Shared (whole team)" : 0
	]
]

// Fires Pass Target if the player who fires it has the weapon, else Fail Target.
// As a master, it passes while the activator has the weapon.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/player_hasweapon.spr") = player_hasweapon : "Player has weapon"
[
	weapon_name(string) : "Weapon classname (blank = any weapon, fists too)" : : "e.g. weapon_sword, weapon_rpg"
	pass_target(target_destination) : "Pass Target"
	fail_target(target_destination) : "Fail Target"
]

