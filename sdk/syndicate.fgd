@PointClass base(Weapon) studio("models/w_mini.mdl") = weapon_chaingun : "Vindico Avenger Minigun" []
// A Vindico Grenade Launcher players can pick up, with ammo. Taking it fires Target.
@PointClass base(Weapon) studio("models/w_glauncher.mdl") = weapon_glauncher : "Vindico Grenade Launcher" []
