// A dynamic light that lights the world and models around it.
@PointClass base(Targetname) color(255 255 128) iconsprite("sprites/editor/env_dlight.spr") = env_dlight : "Dynamic Light"
[
	message(string) : "Position (blank = here) [LP], [LE]" : : "A position or an entity name. With Position is Locus Entity, the light moves with that entity when it has a visible model; on one without (an info_target) it stays where the entity was when it turned on, unless Track position updates is set."
	rendercolor(color255) : "Light color (R G B)" : "255 255 255"
	renderamt(integer) : "Radius" : 80 : "How far the light reaches, in units (0-1023)."
	health(string) : "Duration (0 = until triggered)" : "0.0" : "Seconds the light stays on after it turns on. With 0, it stays on until it is triggered off."
	spawnflags(flags) =
	[
		1 : "Only once (removed when its duration ends)" : 0
		2 : "Start on" : 0
		4 : "Track position updates" : 0
		8 : "Position is Locus Entity" : 0
	]
]

// A light that lights only models (monsters, players, props), never the walls.
@PointClass base(Targetname) color(255 255 128) iconsprite("sprites/editor/env_elight.spr") = env_elight : "Entity Light (models only)"
[
	target(target_destination) : "Entity to follow [LE]" : : "The light sits on this entity and moves with it. If left empty, the light stays at Position."
	impulse(choices) : "Attachment on that entity" : 0 : "Where on the followed model the light sits." =
	[
		0 : "None (its origin)"
		1 : "1"
		2 : "2"
		3 : "3"
		4 : "4"
	]
	message(string) : "Position (blank = here) [LP], [LE]" : : "Where the light is when it follows no entity. With Position is Locus Entity, the light moves with that entity when it has a visible model; on one without (an info_target) it stays where the entity was when it turned on, unless Track position updates is set."
	rendercolor(color255) : "Light color (R G B)" : "255 255 255"
	renderamt(integer) : "Radius" : 64 : "The radius, from 0 to 1023. It is at full brightness up to this distance and then fades with the square of the distance, so in a dark place it still shows at 6 to 7 times the radius. It shines through walls."
	health(string) : "Duration (0 = until triggered)" : "0.0" : "Seconds the light stays on after it turns on. With 0, it stays on until it is triggered off."
	spawnflags(flags) =
	[
		1 : "Only once (removed when its duration ends)" : 0
		2 : "Start on" : 0
		4 : "Track position updates" : 0
		8 : "Position is Locus Entity" : 0
	]
]

@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) iconsprite("sprites/editor/env_explosion.spr") = env_explosion : "Explosion"
[
	target(target_destination) : "Position [LP] (blank = here)" : "" : "Where it explodes, given as x y z, an entity name, !activator or *player."
	iMagnitude(integer) : "Magnitude" : 100 : "How big the blast is and how much damage it does. If left empty, it makes a small fireball that does no damage."
	spawnflags(flags) =
	[
