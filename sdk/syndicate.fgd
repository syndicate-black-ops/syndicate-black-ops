// A key written as #<key> (add it with SmartEdit off, e.g. #unkillable 1) is given to every monster it makes as <key>.
// Not for the model, health or name of the monsters: those keys are ignored.
@PointClass base(Targetname, Angles, RenderFieldsUnset) size(-16 -16 -16, 16 16 16) studio("models/editor/monstermaker.mdl") = monstermaker : "Monster Maker"
[
	target(string) : "Target On Release"
	netname(string) : "Children's Name"
	squadname(string) : "Children's squad name" : : "The squad name every child gets."
	weapons(choices) : "Children's weapons" : 0 : "Weapons every Fed child gets, and for Fed (Heavy Weapons), 1 is the chaingun and 8 the sniper. With 0, each child keeps the monster's own." =
	[
		0 : "The monster's own"
		1 : "Federal"
		3 : "Federal + HG"
		5 : "Federal + GL"
		8 : "Saan Auto-Shotgun"
		10 : "Saan Auto-Shotgun + HG"
	]
	Ff(choices) : "Children's Ignore Friendly Damage" : 0 : "For Feds, assassins and turrets only, every such child ignores damage from its allies. If left empty, the children take that damage, as with No." =
	[
		0 : "No"
		1 : "Yes"
	]
	childtarget(target_destination) : "Children's Target (path)" : : "The path_corner or path_track every child follows."
	childtriggertarget(target_destination) : "Children's TriggerTarget"
	childtriggercondition(choices) : "Children's Trigger Condition" : 0 =
	[
		0 : "No Trigger"
		1 : "See Player, Mad at Player"
		2 : "Take Damage"
		3 : "50% Health Remaining"
		4 : "Death"
		7 : "Hear World"
		8 : "Hear Player"
		9 : "Hear Combat"
		10 : "See Player Unconditional"
		11 : "See Player, Not In Combat"
	]
	childspawnflags(integer) : "Children's spawnflags" : 0 : "Spawnflags every child gets, as the sum of the monster's flag values, e.g. 32 for Apache Fire Rockets."

	monstertype(choices) : "Monster Type" : "monster_apache" : "The class it makes. If left empty, the maker is removed when the map starts, and the server console says so. Rappelling Fed and Rappelling Fed Hunter make a rope spot, and you fire the Children's Name to send a Fed down. Each spot counts as a live child for good, and the children's keys don't reach the Fed. While the map runs, it can only change to a class the map already loads, which is one it places, one a maker makes or a morph monster, and not on a maker with # keys." =
	[
		"monster_apache" : "Apache"
		"monster_barney" : "Cop"
		"monster_cyborg" : "Cyborg"
		"monster_cyberminotor" : "Cyber Minotaur"
		"monster_dark" : "Sectum"
		"monster_gargantua" : "Gargantua"
		"monster_grunt_hunter" : "Fed Hunter"
		"monster_grunt_hunter_repel" : "Rappelling Fed Hunter"
		"monster_human_assassin" : "Assassin"
		"monster_human_grunt" : "Fed"
		"monster_grunt_repel" : "Rappelling Fed"
		"dark_grunt" : "Fed (Heavy Weapons)"
		"monster_alien_slave" : "Demon Slave"
		"monster_hunter" : "Demon Slave Hunter"
		"monster_ichthyosaur" : "Ichthyosaur"
		"monster_imp" : "Imp"
		"monster_imp_hunter" : "Imp Hunter"
		"monster_scientist" : "Scientist"
		"monster_snark" : "Pitbull"
		"monster_sentry" : "Sentry Gun"
		"monster_turret" : "Auto Turret"
		"monster_werewolf" : "Werewolf"
		"monster_werewolf_hunter" : "Werewolf Hunter"
		"monster_zombie" : "Zombie"
		"monster_zombie_hunter" : "Zombie Hunter"
		"monster_zombie_grunt" : "Zombie Grunt"
	]

	spawnflags(flags) =
	[
		1 : "Start ON" : 0
		4 : "Cyclic" : 0
		8 : "MonsterClip" : 0
		16 : "Prisoner" : 0
		32 : "Auto size BBox" : 0
		64 : "Cyclic backlog" : 0
		256 : "Pre-Disaster" : 0
		8192 : "Monster Flag 64" : 0
		65536 : "Non-solid corpse" : 0
		524288 : "Ignore move away requests" : 0
		1048576 : "Act out of PVS" : 0
	]

	monstercount(integer) : "Number of Monsters" : -1 : "How many monsters it makes in all, and -1 means no limit. The server's mp_makermon scales this and Max live children, and mp_speedmon scales the Frequency. If left empty, there is no limit."

	body(integer) : "Children's body" : 0 : "Body every child gets, for scientists, monster_dark and zombies. With 0, each child keeps the monster's own."
	scale(string) : "Children's scale" : "" : "The model scale every child gets. If left empty, each child keeps its own size."

	delay(string) : "Frequency" : "5" : "Seconds between monsters. For a new one only when the last one dies, set Max live children to 1. If left empty or set to 0, it makes them as fast as it can, with no wait."
	m_imaxlivechildren(integer) : "Max live children" : 5 : "It makes no new monster while this many of its monsters are alive, and 0 or less counts as 1. If left empty, there is no limit."
	spawnorigin(string) : "Spawn position [LP] (blank = here)" : "" : "Where each child appears, given as x y z, an entity name or !activator."
	face_position(string) : "Face position [LP]" : "" : "Each child faces this point, and *player is the nearest player in play."
	warpball(target_destination) : "Warpball (an env_warpball)" : "" : "An env_warpball that plays where each child appears."
	impulse(choices) : "Warp at monster's..." : 0 : "Where the warpball plays on the new monster." =
	[
		-1 : "Origin"
		0 : "Default (Center)"
		1 : "Center"
	]
	spawndelay(string) : "Delay before spawn" : "" : "Seconds between the warpball and the monster appearing. If left empty or set to 0, it appears at once."
	delay_after_blocked(string) : "Delay after blocked" : "" : "Seconds before the next try when the spot was taken. If left empty, it waits as long as the Frequency."
	target_activator(choices) : "Target's Activator" : 0 : "The activator of Target On Release." =
	[
		-1 : "Don't pass activator"
		0 : "Default (Monstermaker, before the monster spawns)"
		1 : "Monstermaker (after the monster spawns)"
		2 : "Spawned monster"
		3 : "Forward my activator"
	]
	yawdeviation(integer) : "Max yaw deviation" : 0 : "Each child turns a random amount up to this many degrees left or right."
	trigger_on_death_notice(target_destination) : "Trigger on death notice" : "" : "Fired each time one of its children dies."
	classify(choices) : "Children's classification" : "" : "The class every child fights as. If left empty or set to 0, each child keeps its own." =
	[
		-1 : "None"
		0 : "Object default"
		1 : "Machine"
		2 : "Player"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
	respawn_as_playerally(choices) : "Reverse Relationship" : 0 : "With Yes, every child changes sides, as with Is player ally." =
	[
		0 : "No"
		1 : "Yes"
	]
	make_blocker_move_away(choices) : "Make blocker move away" : 0 : "When a monster stands on the spot, ask it to move away." =
	[
		0 : "No"
		1 : "Yes, walking"
		2 : "Yes, running"
	]
	gag(choices) : "Gag" : 0 : "With Yes, every child is Gagged and has no idle chatter." =
	[
		0 : "No"
		1 : "Yes"
	]
	change_rendermode(choices) : "Override Render Mode" : 0 : "With Yes, every child gets this maker's render settings." =
	[
		0 : "No"
		1 : "Yes"
	]
]


