//
// Locus
//
// Locus entities. Keys marked [LP] take a position, [LV] a vector, [LR] a number: a value (x y z, 5,
// or 1..3 for random) or an entity name (also !activator, *locus, *player). The calc entities compute such a value.
// A key whose default is *locus is *locus when left blank.

@PointClass base(Targetname) color(128 200 64) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/calc_position.spr") = calc_position : "Calculate Position"
[
	netname(target_destination) : "Entity to use" : "*locus"
	impulse(choices) : "Position to calculate" : 0 =
	[
		0 : "Origin"
		1 : "Eyes"
		2 : "Top"
		3 : "Center"
		4 : "Bottom"
		5 : "Attachment point 0"
		6 : "Attachment point 1"
		7 : "Attachment point 2"
		8 : "Attachment point 3"
		9 : "Random (in its box)"
		10 : "Calc Position of the entity [LP]"
		11 : "Body"
	]
	message(string) : "Add offset [LV]" : : "If left empty, there is no offset."
]

@PointClass base(Targetname) color(170 221 85) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/calc_ratio.spr") = calc_ratio : "Calculate Number"
[
	target(string) : "Based on number [LR]" : "*locus"
	impulse(choices) : "Transformation (trigonometry in degrees)" : 0 =
	[
		0 : "None"
		1 : "Reversed (1-X)"
		2 : "Negative (-X)"
		3 : "Reciprocal (1/X)"
		4 : "Square (X*X)"
		5 : "Inverse Square (1/X*X)"
		6 : "Square root"
		7 : "Cosine"
		8 : "Sine"
		9 : "Tangent"
		10 : "Inverse Cosine"
		11 : "Inverse Sine"
		12 : "Inverse Tangent"
	]
	netname(string) : "Offset by [LR]" : "" : "Added after the transformation."
	message(string) : "Scale factor [LR]" : "" : "Multiplied after the transformation and the offset."
	noise(string) : "Min (blank = none) [LR]"
	noise1(string) : "Max (blank = none) [LR]"
	frags(choices) : "If outside range" : 0 =
	[
		0 : "Pick nearest value"
		1 : "Wrap around"
		2 : "Bounce back"
	]
	base_cast_mode(choices) : "Cast base" : 0 =
	[
		0 : "No cast"
		1 : "Round"
		2 : "Floor"
		3 : "Ceil"
		4 : "Trunc"
	]
	result_cast_mode(choices) : "Cast result" : 0 =
	[
		0 : "No cast"
		1 : "Round"
		2 : "Floor"
		3 : "Ceil"
		4 : "Trunc"
	]
]

@PointClass base(Targetname) color(170 221 85) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/calc_numfromvec.spr") = calc_numfromvec : "Calculate Number from Vector"
[
	target(string) : "Vector to use [LV] / [LP] / color" : "*locus"
	impulse(choices) : "Number to get" : 0 =
	[
		0 : "X (R)"
		1 : "Y (G)"
		2 : "Z (B)"
		3 : "Length"
		4 : "Pitch"
		5 : "Yaw"
	]
	vector_type(choices) : "Vector value is" : 0 =
	[
		0 : "Velocity [LV]"
