[
	message(string) : "Position (blank = here) [LP], [LE]" : : "A position or an entity name. With Position is Locus Entity, the light moves with that entity."
	rendercolor(color255) : "Light color (R G B)" : "255 255 255"
	renderamt(integer) : "Radius" : 80 : "How far the light reaches, in units (0-1023)."
	health(string) : "Duration (0 = until triggered)" : "0.0" : "Seconds the light stays on after it turns on; 0: until it is triggered off."
	spawnflags(flags) =
	[
		1 : "Only once (removed when its duration ends)" : 0
		2 : "Start on" : 0
		4 : "Track position updates" : 0
		8 : "Position is Locus Entity" : 0
	]
]

