[
	spawnflags(flags) =
	[
		1 : "Don't use X" : 0
		2 : "Don't use Y" : 0
		4 : "Don't use Z" : 0
		32 : "Invert target value" : 0
		64 : "Invert source value" : 0
	]
	target(target_destination) : "Destination entity"
	m_iszValueName(string) : "Key name"
	m_iszNewValue(string) : "New value"
	m_iszValueType(choices) : "Type of value (operation)" : 0 =
	[
		0 : "Replace (= new value)"
		1 : "Add (= old + new)"
		2 : "Mul (= old * new)"
		3 : "Sub (= old - new)"
		4 : "Div (= old / new)"
		16 : "Pow (= old ^ new)"
		12 : "Mod (= old % new)"
		5 : "AND (= old & new)"
		6 : "OR (= old | new)"
