	message(target_destination) : "Fire On Pass"
	altpath(target_destination) : "Branch Path"
	netname(target_destination) : "Fire on dead end"
	speed(integer) : "New Train Speed" : 0
]


//
// Player
//

// Turns abilities of the player who fires it off or on, until changed again or the player respawns.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/player_capabilities.spr") = player_capabilities : "Player capabilities (attack, jump, duck, use, steps, movement)"
[
	attack_capability(choices) : "Attack capability (primary and secondary)" : 0 =
	[
		-1 : "Off"
		0 : "No change"
		1 : "On"
		2 : "Toggle"
		3 : "Copy use input"
	]
	jump_capability(choices) : "Jump capability" : 0 =
	[
		-1 : "Off"
		0 : "No change"
		1 : "On"
		2 : "Toggle"
		3 : "Copy use input"
	]
	duck_capability(choices) : "Duck capability" : 0 =
	[
		-1 : "Off"
		0 : "No change"
		1 : "On"
		2 : "Toggle"
		3 : "Copy use input"
	]
	use_capability(choices) : "Use capability (buttons, tanks, trains)" : 0 =
	[
		-1 : "Off"
		0 : "No change"
		1 : "On"
		2 : "Toggle"
		3 : "Copy use input"
	]
	stepsound_capability(choices) : "Step sounds" : 0 =
	[
		-1 : "Off"
		0 : "No change"
		1 : "On"
		2 : "Toggle"
		3 : "Copy use input"
	]
	movement_capability(choices) : "Movement capability (walk, strafe, swim; not jumping)" : 0 =
	[
		-1 : "Off"
		0 : "No change"
		1 : "On"
		2 : "Toggle"
		3 : "Copy use input"
	]
]

// Makes the flashlight of the player who fires it flicker (On) or stop (Off).
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/player_flicker.spr") = player_flicker : "Player flashlight flicker" []

// Fires Pass Target if the player who fires it has the weapon, else Fail Target.
// As a master, it passes while the activator has the weapon.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/player_hasweapon.spr") = player_hasweapon : "Player has weapon"
[
	weapon_name(string) : "Weapon classname (blank = any weapon)" : : "e.g. weapon_sword, weapon_rpg"
	pass_target(target_destination) : "Pass Target"
	fail_target(target_destination) : "Fail Target"
]

// Sets the maximum speed of the player who fires it, until changed again or the player respawns. 0 resets it.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/player_speed.spr") = player_speed : "Player speed"
[
	maxspeed(string) : "Maxspeed value (0 = reset)" : "0"
	value_notion(choices) : "Value mode" : 0 =
	[
		0 : "Fraction of the player's own speed"
		1 : "Set absolute"
	]
]

@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) iconsprite("sprites/editor/player_weaponstrip.spr") = player_weaponstrip : "Strips player's weapons" []


//
// Scripted sequences and AI
//

@PointClass base(Scripted) size(-16 -16 0, 16 16 72) color(255 0 255) studio("models/editor/aiscripted_sequence.mdl") = aiscripted_sequence : "AI Scripted Sequence"
[
	m_iFinishSchedule(choices) : "AI Schedule when done" : 0 =
	[
		0 : "Default AI"
		1 : "Ambush"
	]
	spawnflags(flags) =
	[
		4 : "Repeatable" : 0
		8 : "Leave Corpse" : 0
		512 : "Apply new angles from bones" : 0
		1024 : "Auto-search (act as unnamed)" : 0
		4096 : "Try search once" : 0
		8192 : "Don't reset head turn" : 0
		16384 : "Force idle animation looping" : 0
		32768 : "Remove on interruption" : 0
		65536 : "Don't Drop to Floor" : 0
		131072 : "Allow stuck" : 0
		262144 : "Allow unnamed idle" : 0
		524288 : "Allow Take Damage TriggerCondition" : 0
	]
]

@PointClass base(Scripted) size(-16 -16 0, 16 16 72) color(255 0 255) studio("models/editor/scripted_sequence.mdl") = scripted_sequence : "Scripted Sequence"
[
	m_iszIdle(string) : "Idle Animation" : ""
	spawnflags(flags) =
	[
		4 : "Repeatable" : 0
		8 : "Leave Corpse" : 0
		32 : "No Interruptions" : 0
		64 : "Override AI" : 0
		128 : "No Script Movement" : 0
		512 : "Apply new angles from bones" : 0
		1024 : "Auto-search (act as unnamed)" : 0
		4096 : "Try search once" : 0
		8192 : "Don't reset head turn" : 0
		16384 : "Force idle animation looping" : 0
		32768 : "Remove on interruption" : 0
		65536 : "Don't Drop to Floor" : 0
		131072 : "Allow stuck" : 0
		262144 : "Allow unnamed idle" : 0
		524288 : "Allow Take Damage TriggerCondition" : 0
	]
]

@PointClass base(Targetname, Targetx) size(-16 -16 0, 16 16 72) color(255 0 255) iconsprite("sprites/editor/scripted_sentence.spr") = scripted_sentence : "Scripted Sentence"
[
	spawnflags(flags) =
	[
		1 : "Fire Once" : 1
		2 : "Followers Only" : 0
		4 : "Interrupt Speech" : 1
		8 : "Concurrent" : 0
	]
	sentence(string) : "Sentence Name" : ""
	entity(string) : "Speaker Type"
	duration(string) : "Sentence Time" : "3"
	radius(integer) : "Search Radius" : 512
	refire(string) : "Delay Before Refire" : "3"
	listener(string) : "Listener Type"
	volume(string) : "Volume 0-10" : "10"
	attenuation(choices) : "Sound Radius" : 0 =
	[
		0 : "Small Radius"
		1 : "Medium Radius"
		2 : "Large Radius"
		3 : "Play Everywhere"
		4 : "Larger Radius"
		5 : "Huge Radius"
	]
	follow_action(choices) : "Follow action" : 0 : "What the speaker does when it starts the sentence." =
	[
		0 : "Nothing"
		1 : "Start following"
		2 : "Stop following"
	]
	fire_after(target_destination) : "Fire after speaking" : "" : "Fired when the sentence is over."
	fire_after_delay(string) : "Delay before fire after" : "" : "Seconds after the sentence before Fire after speaking."
	listener_radius(string) : "Listener search radius" : "" : "How far the listener is looked for. Empty or 0: the Search Radius."
	allow_use(choices) : "Allow use" : 0 : "Yes: +use on the speaker works while it says this." =
	[
		0 : "No"
		1 : "Yes"
	]
	search_origin(string) : "Search origin [LP]" : "" : "Where the speaker (by class) is looked for. Empty: here."
]

// A scripted_sequence whose monster performs an action (attack, reload, jump) at a target.
@PointClass base(Scripted) size(-16 -16 0, 16 16 72) color(255 0 255) iconsprite("sprites/editor/scripted_action.spr") = scripted_action : "Scripted Action"
[
	m_iszAttack(string) : "Entity to attack (blank = this; name, !activator or classname)"
	m_fAction(choices) : "Action to perform" : 0 : "Most monsters have only some actions; without the action the script ends at once." =
	[
		0 : "Ranged Attack"
		1 : "Ranged Attack 2"
		2 : "Melee Attack"
		3 : "Melee Attack 2"
		4 : "Special Attack"
		5 : "Special Attack 2"
		6 : "Reload"
		7 : "Jump"
		8 : "No action"
	]
	spawnflags(flags) =
	[
		4 : "Repeatable" : 0
		8 : "Leave Corpse" : 0
		32 : "No Interruptions" : 0
		64 : "Override AI" : 0
	]
]

// Suggests an AI schedule to monsters about a spot (move away, take cover, investigate, turn, move).
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) color(255 0 255) iconsprite("sprites/editor/scripted_schedule.spr") = scripted_schedule : "Scripted Schedule"
[
	entity(string) : "Affected monster (name or !activator)"
	schedule(choices) : "Suggested schedule" : 1 =
	[
		0 : "Clear suggested schedule"
		1 : "Move away from spot"
		2 : "Cover or retreat from spot"
		3 : "Investigate spot"
		4 : "Turn to spot"
		5 : "Move to spot"
	]
	mindist(string) : "Min distance (move away / cover)"
	maxdist(string) : "Max distance (move away / cover; default 784)"
	spot_entity(string) : "Spot entity (blank: the monster itself, or this entity for investigate / turn / move to)"
	move_preference(choices) : "Move preference" : 0 =
	[
		0 : "Auto"
		1 : "Walk"
		2 : "Run"
	]
	spot_preference(choices) : "Spot preference (SBO: the spot is taken where it is when fired)" : 0 =
	[
		0 : "Auto"
		1 : "Position (taken once)"
		2 : "Entity"
	]
]

// Makes a talking monster start or stop following the player who fires it.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) color(255 0 255) iconsprite("sprites/editor/scripted_following.spr") = scripted_following : "Scripted Following"
[
	entity(string) : "Affected monster name"
	on_start_following(target_destination) : "Fire on start following (only when it changed)"
	on_stop_following(target_destination) : "Fire on stop following (only when it changed)"
	spawnflags(flags) =
	[
		1 : "Remove on fire" : 0
	]
	use_type(choices) : "Use type" : 1 =
	[
		-1 : "Make stop following"
		0 : "Forward input (On start, Off stop, Toggle)"
		1 : "Make start following"
	]
]

// Takes over a func_tank, turns it and fires it on cue, then gives it back.
@PointClass base(Targetname, Angles) size(-16 -16 -16, 16 16 16) color(255 0 255) iconsprite("sprites/editor/scripted_tanksequence.spr") = scripted_tanksequence : "Scripted Tank Sequence"
[
	m_iszEntity(target_destination) : "Tank to affect"
	m_iTurn(choices) : "Turn to" : 2 =
	[
		0 : "Don't turn"
		1 : "Match sequence angle"
		2 : "Face sequence"
		3 : "Face enemy"
	]
	m_iszEnemy(string) : "Enemy to face (name, !activator or classname; blank = the tank's target)"
	m_iShoot(choices) : "Fire gun" : 1 =
	[
		0 : "Don't fire"
		1 : "Once (at end)"
		2 : "Constantly"
		3 : "While facing target"
	]
	m_iUntil(choices) : "Halt condition" : 1 =
	[
		0 : "None"
		1 : "Tank faces target"
		2 : "Enemy dies"
	]
	target(target_destination) : "Trigger on halt"
	m_fDuration(string) : "Time limit (0 = no limit)" : "0"
	netname(target_destination) : "Trigger on timeout"
	m_iActive(choices) : "Tank state afterwards" : 0 =
	[
		0 : "No change"
		1 : "Active"
		2 : "Inactive"
		3 : "Toggle"
	]
	m_iControllable(choices) : "Control afterwards" : 0 =
	[
		0 : "No change"
		1 : "Controllable"
		2 : "Not Controllable"
		3 : "Toggle"
	]
	spawnflags(flags) =
	[
		1 : "Dump player" : 0
		2 : "Repeatable" : 0
	]
]

// Sends a monster along a path_corner route; it returns to the route when idle.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/trigger_startpatrol.spr") = trigger_startpatrol : "Trigger Start Patrol"
[
	target(target_destination) : "Target monster (name or !activator)"
	m_iszPath(target_destination) : "Patrol path start (path_corner)"
]

// A sound or smell only monsters notice: Danger makes them flee the spot, Combat draws them in.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/env_soundmark.spr") = env_soundmark : "AI sound mark (monsters only)"
[
	spawnflags(flags) =
	[
		1 : "Remove On fire" : 0
	]
	radius(string) : "Sound Radius" : "384"
	duration(string) : "Sound Duration" : "0.3"
	position(string) : "Position [LP] (blank = here)"
	type(choices) : "Sound Type" : 32 =
	[
		1 : "Combat"
		2 : "World"
		4 : "Player"
		8 : "Carcass"
		16 : "Meat"
		32 : "Danger"
		64 : "Garbage"
	]
]

// An invisible target that monsters treat as an enemy of its class. Not solid. On, Off or Toggle.
@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) color(0 200 200) iconsprite("sprites/editor/monster_target.spr") = monster_target : "Target for monsters to attack"
[
	frags(choices) : "When active, count as" : 11 =
	[
		0 : "Ignored"
		1 : "Machine"
		2 : "Player"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
	spawnflags(flags) =
	[
		1 : "Start inactive" : 0
	]
]

// Moves or turns its targets every frame until turned off.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/motion_manager.spr") = motion_manager : "Motion manager (move / turn an entity every frame)"
[
	target(target_destination) : "Target to affect (name or !activator)"
	m_iszPosition(string) : "Position (blank = no change)"
	m_iPosMode(choices) : "Meaning of Position" : 0 =
	[
		0 : "Set position [LP]"
		1 : "Offset position, units per second [LV]"
		2 : "Set velocity [LV]"
		3 : "Accelerate by [LV]"
		4 : "Follow position [LP]"
	]
	m_iszFacing(string) : "Facing (blank = no change)"
	m_iFaceMode(choices) : "Meaning of Facing" : 0 =
	[
		0 : "Face direction [LV]"
		1 : "Rotate by a direction's angles, per second [LV]"
		2 : "Rotate by (Y Z X), per second"
		3 : "Set avelocity (Y Z X)"
		4 : "Set angles to an entity's angles"
	]
	spawnflags(flags) =
	[
		1 : "Debug" : 0
		16 : "Obey Trigger Mode" : 1
		32 : "Start On" : 0
	]
]

// Sets the position, angles or movement of an entity once per trigger, from Locus values.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/trigger_motion.spr") = trigger_motion : "Trigger motion (set position / movement once)"
[
	target(target_destination) : "Target to affect (name or !activator)"
	m_iszPosition(string) : "Position (blank = no change)"
	m_iPosMode(choices) : "Meaning of Position" : 0 =
	[
		0 : "Set new position [LP]"
		1 : "Add offset [LV]"
	]
	m_iszAngles(string) : "Angles (blank = no change)"
	m_iAngMode(choices) : "Meaning of Angles" : 0 =
	[
		0 : "Set new angle (face a direction) [LV]"
		1 : "Rotate by a direction's angles [LV]"
		2 : "Rotate by (Y Z X)"
	]
	m_iszVelocity(string) : "Velocity (blank = no change)"
	m_iVelMode(choices) : "Meaning of Velocity" : 0 =
	[
		0 : "Set new velocity [LV]"
		1 : "Add to velocity [LV]"
		2 : "Rotate velocity by a direction's angles [LV]"
		3 : "Rotate velocity (Y Z X)"
	]
	m_iszAVelocity(string) : "AVelocity (blank = no change)"
	m_iAVelMode(choices) : "Meaning of AVelocity" : 0 =
	[
		0 : "Set new avelocity (Y Z X)"
		1 : "Add to avelocity (Y Z X)"
	]
	spawnflags(flags) =
	[
		1 : "Debug" : 0
	]
]


//
// Triggers
