]

@PointClass base(Targetname) iconsprite("sprites/editor/multispawn.spr") = multispawn : "Multi-Spawn Manager: each trigger moves the player spawns to the next zone, or to a named spawn set, from the next round. Co-op maps only."
[
	master(string) : "Master"
	spawnset(target_destination) : "Spawn set" : : "The name of a spawn set, which is the Player Start 1 to 5 points with this name. When this fires, players spawn only at those points until another multispawn fires, and you can switch between sets in any order. If left empty, it moves players on to the next zone, from Player Start 2 on to 3, 4 and 5, and ends any named set. If no spawn point has the name, players spawn as if no set were active, and with developer 1 set in the console, a message says so."
]

// Without a Limitator the loadout weapon comes with this reserve ammo (weap1-weap11 order): 120, 140, 180, 150, 250,
// 210, 160, 120, 50, 150, 100; each ammo_reserve gives 900, 900, 900, 900, 150, 180, 200, 210, 100, 210, 500.
// A placed Limitator uses its keys for both. A key left out gives the loadout reserve above, with the loadout and
// with each ammo_reserve pickup; the defaults below are those values.
@PointClass size(0 -0 -0, 16 16 36) color(255 0 120) iconsprite("sprites/editor/limitator.spr") = Limitator : "Ammo Limiter: the reserve ammo the loadout and the ammo_reserve box give per weapon"
[
	weap1(integer) : "Croon RC 28 reserve ammo (weapon_rc28)" : 120 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap2(integer) : ".444k Bear Killer reserve ammo (weapon_k444)" : 140 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap3(integer) : "Canon of Terror reserve ammo (weapon_canon)" : 180 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap4(integer) : "Croon PM 66 reserve ammo (weapon_pm66)" : 150 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap5(integer) : "Croon FA 18 reserve ammo (weapon_fa18)" : 250 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap6(integer) : "Vindico Federal reserve ammo (weapon_federal)" : 210 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap7(integer) : "Saan Auto-Shotgun reserve ammo (weapon_spa)" : 160 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap8(integer) : "Benelli reserve ammo (weapon_ben)" : 120 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap9(integer) : "Vindico Plasma Sniper Rifle reserve ammo (weapon_sw)" : 50 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap10(integer) : "Croon NM 33 Sniper Rifle reserve ammo (weapon_nm33)" : 150 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
	weap11(integer) : "Vindico Avenger Minigun reserve ammo (weapon_chaingun)" : 100 : "Reserve ammo given with the loadout weapon, whose magazine comes full as usual, and added by each ammo_reserve pickup. If left empty or set to 0 or less, there is no reserve ammo, and above 900 it gives 900, the most a player carries."
]

