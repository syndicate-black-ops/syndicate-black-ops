@PointClass base(Targetname, Target) iconsprite("sprites/editor/game_counter.spr") = game_counter : "Fires when it hits limit"
[
	spawnflags(flags) =
	[
		1 : "Remove On fire" : 0
		2 : "Reset On fire" : 1
		4 : "Fire if over limit" : 0
	]
	master(string) : "Master"
	frags(integer) : "Initial Value" : 0
	health(integer) : "Limit Value" : 10 : "It fires its target when the count reaches this. If left empty, the limit is 0, so a count that starts at 0 and goes up never fires it, and with Fire if over limit, every count fires it."
]

@PointClass base(Targetname, Target) iconsprite("sprites/editor/game_counter_set.spr") = game_counter_set : "Sets a game_counter"
[
	spawnflags(flags) =
	[
		1 : "Remove On fire" : 0
	]
	master(string) : "Master"
	frags(integer) : "New Value" : 10 : "The value it gives the game_counter. If left empty, it sets the counter to 0."
]

