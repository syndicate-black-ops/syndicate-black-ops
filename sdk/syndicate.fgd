//
// Syndicate Black Ops game definition file (.fgd) for J.A.C.K. and Hammer
//
// Based on the Half-Life FGD of the GoldSource FGD Collection:
// https://github.com/Erty-Gamedev/GoldSrcFGDCollection
//
// The editor models and sprites are in the game folder (models/editor, sprites/editor).
//


//
// Worldspawn
//

@SolidClass = worldspawn : "World entity"
[
	message(string) : "Map Description / Title"
	skyname(string) : "environment map (cl_skyname)" : : "The sky images (gfx/env), e.g. desert, dusk, night or space."
	sounds(integer) : "CD track to play" : 1
	light(integer) : "Default light level"
	WaveHeight(string) : "Default Wave Height"
	MaxRange(string) : "Max viewable distance" : "4096"
	chaptertitle(string) : "Chapter Title Message"
	startdark(choices) : "Level Fade In" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	gametitle(choices) : "Display game title" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	newunit(choices) : "New Level Unit" : 0 =
	[
		0 : "No, keep current"
		1 : "Yes, clear previous levels"
	]
	mapteams(string) : "Map Team List"
	defaultteam(choices) : "Default Team" : 0 =
	[
		0 : "Fewest Players"
		1 : "First Team"
	]
	grassDensity(integer) : "Grass: density" : 0 : "Grass pieces drawn around the player on grass textures (material A). 0 or empty: no grass. Try 100-400."
	grassSprite(sprite) : "Grass: sprite" : "" : "Empty: sprites/grass_01.spr and grass_03.spr. Or a sprite that ships with the map."
	grassFadeDist(integer) : "Grass: fade distance" : 800 : "Grass fades out towards this distance from the player (128-4096)."
	grassMinHeight(integer) : "Grass: minimum height" : 16 : "Height of a grass piece, at least (4-256)."
	grassMaxHeight(integer) : "Grass: maximum height" : 32 : "Height of a grass piece, at most (4-256)."
	freeroam(choices) : "Monsters freeroam" : 0 : "Yes: idle monsters whose Freeroam is Map default walk from node to node." =
	[
		0 : "No"
		1 : "Yes"
	]
	materials_file(string) : "Materials file" : : "The map's own texture materials (footsteps, hit sounds, impact effects), e.g. materials/maps/mymap.txt. Empty: materials/maps/<map name>.txt if it exists."
]


//
// Base classes
//

@BaseClass = ZHLTCopyTarget
[
	zhlt_usemodel(target_destination) : "ZHLT Template Model Target"
	zhlt_copylight(target_destination) : "ZHLT Copy Lighting From Target"
	light_origin(target_destination) : "Light Origin Target"
]
@BaseClass base(ZHLTCopyTarget) = ZHLT
[
	zhlt_noclip(choices) : "ZHLT Noclip" : 0 =
	[
		0 : "Solid (default)"
		1 : "Noclip"
	]
	zhlt_lightflags(choices) : "ZHLT Lightflags" : 0 =
	[
		0 : "Default"
		1 : "Embedded Fix"
		2 : "Opaque (blocks light)"
		3 : "Opaque + Embedded fix"
		6 : "Opaque + Concave Fix"
	]
	zhlt_invisible(choices) : "ZHLT Invisible" : 0 =
	[
		0 : "Visible (default)"
		1 : "Invisible"
	]
	zhlt_customshadow(string) : "ZHLT Custom Shadow (when opaque)"
	zhlt_embedlightmap(choices) : "ZHLT Embed Light Map (when translucent)" : 0 =
	[
		0 : "No (default)"
		1 : "Yes"
	]
	zhlt_embedlightmapresolution(integer) : "ZHLT Embed Light Map Resolution" : 4
	_minlight(string) : "Minimum Light Level (0.0 - 1.0)"
]
@BaseClass = ZHLT_point
[
	_fade(string) : "ZHLT Fade" : "1.0" : "Compiler: how fast the light fades with distance (1 = normal)."
	_falloff(choices) : "ZHLT Falloff (ZHLT only)" : 0 : "Compiler: ZHLT only; other compilers ignore it." =
	[
		0 : "Default"
		1 : "Inverse Linear"
		2 : "Inverse Square"
	]
]

@BaseClass = Appearflags
[
	spawnflags(flags) =
	[
		2048 : "Not in Deathmatch" : 0
	]
]
@BaseClass = Angles
[
	angles(choices) : "Pitch Yaw Roll (Y Z X)" : "0 0 0" =
	[
		"0 0 0" : "Default (East)"
		"-90 0 0" : "Up"
		"90 0 0" : "Down"
		"0 90 0" : "North"
		"0 180 0" : "West"
		"0 -90 0" : "South"
	]
]
@BaseClass = Targetname
[
	targetname(target_source) : "Name"
]
@BaseClass = Target
[
	target(target_destination) : "Target"
]
@BaseClass = Global
[
	globalname(string) : "Global Entity Name"
]
@BaseClass = Master
[
	master(string) : "Master"
]
@BaseClass = CustomObjectHint
[
	objecthint(choices) : "Object Hint Template" : "" : "Marks the object for nearby players: faint brackets within Hint Distance, then a color when +use would use it. Hidden: no mark." =
	[
		"" : "None"
		"button" : "button"
		"charger" : "charger"
		"eyescanner" : "eyescanner"
		"pickup" : "pickup"
		"hidden" : "hidden"
	]
	objecthint_distance(integer) : "Hint Distance" : : "How close the player must be to see the brackets. Empty or 0: 512, at most 4096."
]
@BaseClass base(Target) = Targetx
[
	delay(string) : "Delay before trigger" : "0"
	killtarget(target_destination) : "KillTarget"
]

@BaseClass size(-16 -16 -16, 16 16 16) color(0 200 200) studio() = ModelBase
[
	model(studio) : "Model"
]

@BaseClass = ModelScale
[
	scale(string) : "Model scale" : "" : "Draws the model this many times its size (0.5 half, 2 double). Empty or 1: normal size. Hitboxes scale with it, movement does not."
]

@BaseClass = RenderFxChoices
[
	renderfx(choices) : "Render FX" : 0 =
	[
		0 : "Normal"
		1 : "Slow Pulse"
		2 : "Fast Pulse"
		3 : "Slow Wide Pulse"
		4 : "Fast Wide Pulse"
		9 : "Slow Strobe"
		10 : "Fast Strobe"
		11 : "Faster Strobe"
		12 : "Slow Flicker"
		13 : "Fast Flicker"
		5 : "Slow Fade Away"
		6 : "Fast Fade Away"
		7 : "Slow Become Solid"
		8 : "Fast Become Solid"
		14 : "Constant Glow"
		15 : "Distort"
		16 : "Hologram (Distort + fade)"
		18 : "Bulge Sideways"
		19 : "Glow Shell"
	]
]
@BaseClass base(RenderFxChoices) = RenderFields
[
	rendermode(choices) : "Render Mode" : 0 =
	[
		0 : "Normal"
		1 : "Color"
		2 : "Texture"
		3 : "Glow"
		4 : "Solid"
		5 : "Additive"
	]
	renderamt(integer) : "FX Amount (1 - 255)"
	rendercolor(color255) : "FX Color (R G B)" : "0 0 0"
]
// Render keys without defaults: the editor writes them only when set
@BaseClass = RenderFieldsUnset
[
	renderfx(choices) : "Render FX" : : "Render effect, applied on top of the Render Mode." =
	[
		0 : "Normal"
		1 : "Slow Pulse"
		2 : "Fast Pulse"
		3 : "Slow Wide Pulse"
		4 : "Fast Wide Pulse"
		9 : "Slow Strobe"
		10 : "Fast Strobe"
		11 : "Faster Strobe"
		12 : "Slow Flicker"
		13 : "Fast Flicker"
		5 : "Slow Fade Away"
		6 : "Fast Fade Away"
		7 : "Slow Become Solid"
		8 : "Fast Become Solid"
		14 : "Constant Glow"
		15 : "Distort"
		16 : "Hologram (Distort + fade)"
		18 : "Bulge Sideways"
		19 : "Glow Shell"
	]
	rendermode(choices) : "Render Mode" : : "How the object is drawn." =
	[
		0 : "Normal"
		1 : "Color"
		2 : "Texture"
		3 : "Glow"
		4 : "Solid"
		5 : "Additive"
	]
	renderamt(integer) : "FX Amount (1 - 255)"
	rendercolor(color255) : "FX Color (R G B)"
]
@BaseClass = Effects
[
	effects(choices) : "Effects" : "" =
	[
		"" : "None"
		1 : "Particle cloud"
		2 : "Muzzle flash"
		4 : "Bright flash"
		8 : "Player flashlight glow"
		16 : "Get light from ceiling"
		32 : "Don't interpolate next frame"
		64 : "Rocket flare"
		128 : "Nodraw"
	]
]

// Effects for models
@BaseClass = EntityEffects
[
	effects(choices) : "Effects" : 0 =
	[
		0 : "No effects"
		16 : "Invert light (take light from ceiling)"
	]
]

@BaseClass = Body
[
	body(integer) : "Body"
]
@BaseClass = Skin
[
	skin(integer) : "Skin"
]
@BaseClass base(Body, Skin) = BodySkin []

