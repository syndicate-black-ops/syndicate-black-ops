[
	target(string) : "Position [LP] (blank = here)"
	netname(string) : "Spray direction [LV] (blank = angles)"
	angles(string) : "Pitch Yaw Roll (Y Z X)" : "0 0 0"
	impulse(choices) : "Decal group" : 0 =
	[
		1 : "Gunshot"
		2 : "Blood"
		3 : "Alien blood"
		4 : "Glass cracks"
		5 : "Big gunshot"
		6 : "Scorch marks"
		7 : "Bullsquid splat"
		8 : "Small scorch marks"
		9 : "Spore splat (alien blood)"
		10 : "Shock scorch (scorch marks)"
		11 : "Small shock scorch (small scorch marks)"
		0 : "Custom (see below)"
	]
	noise(decal) : "Custom decal texture"
]

// A dynamic light that lights the world and models around it.
