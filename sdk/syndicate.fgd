@PointClass base(Targetname, Targetx) size(-16 -16 0, 16 16 72) color(255 0 255) iconsprite("sprites/editor/scripted_sentence.spr") = scripted_sentence : "Scripted Sentence"
[
	spawnflags(flags) =
	[
		1 : "Fire Once" : 1
		2 : "Followers Only" : 0
		4 : "Interrupt Speech" : 1
		8 : "Others stop talking" : 0
	]
	sentence(string) : "Sentence Name" : ""
	entity(string) : "Speaker Type"
	duration(string) : "Sentence Time" : "3" : "Seconds the speaker counts as talking, and the next sentence can start after this time plus Delay Before Refire. If left empty, the speaker stops counting as talking as soon as it starts."
	radius(integer) : "Search Radius" : 512 : "When Speaker Type is a class name, how far from this entity the speaker is looked for, and the listener too unless Listener search radius is set. If left empty, a speaker given by class name is never found, and neither is a listener given by class name unless Listener search radius is set."
	refire(string) : "Delay Before Refire" : "3" : "Seconds after Sentence Time before it can be spoken again. If left empty, it can be spoken again as soon as Sentence Time is over."
	listener(string) : "Listener Type"
	volume(string) : "Volume 0-10" : "10"
	attenuation(choices) : "Sound Radius" : 0 =
	[
		0 : "Small Radius"
		1 : "Medium Radius"
		2 : "Large Radius"
		3 : "Play Everywhere"
		4 : "Larger Radius"
		5 : "Huge Radius"
	]
	follow_action(choices) : "Follow action" : 0 : "What the speaker does when it starts the sentence. With Start following, it follows the nearest player, though a Cop only does as a player ally with a Followage policy set. A monster that was attacked never follows." =
	[
		0 : "Nothing"
		1 : "Start following"
		2 : "Stop following"
	]
	fire_after(target_destination) : "Fire after speaking" : "" : "Fired Sentence Time seconds after the sentence starts (plus Delay before fire after)."
	fire_after_delay(string) : "Delay before fire after" : "" : "Seconds after the sentence before Fire after speaking."
	listener_radius(string) : "Listener search radius" : "" : "How far the listener is looked for. If left empty or set to 0, it uses the Search Radius."
	allow_use(choices) : "Allow use" : 0 : "With Yes, +use on the speaker works while it says this." =
	[
		0 : "No"
		1 : "Yes"
	]
	search_origin(string) : "Search origin [LP]" : "" : "Where the speaker is looked for when Speaker Type is a class name. If left empty, it is looked for around this entity."
]

