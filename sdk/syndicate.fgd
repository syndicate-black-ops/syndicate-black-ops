//
// Sounds and music
//

// Plays a sound on another entity, moving with it. Empty target: the player who fired it.
@PointClass iconsprite("sprites/editor/ambient_extraspeaker.spr") base(Targetname) = ambient_extraspeaker : "Sound on another entity"
[
	message(sound) : "WAV Name (or !sentence)"
	target(target_destination) : "Attach to entity" : "*player"
	channel(choices) : "Channel to use" : 0 =
	[
		0 : "Default (Static)"
		1 : "Weapon"
		2 : "Voice"
		3 : "Item"
		4 : "Body"
		5 : "Stream"
		6 : "Static"
	]
	health(integer) : "Volume (10 = loudest)" : 10
	pitch(integer) : "Pitch (> 100 = higher)" : 100
	spawnflags(flags) =
	[
		1 : "Play Everywhere" : 0
		2 : "Small Radius" : 0
		4 : "Medium Radius" : 1
		8 : "Large Radius" : 0
		16 : "Start Silent" : 1
		32 : "Not Toggled (plays once per trigger)" : 1
	]
]

@PointClass iconsprite("sprites/editor/ambient_generic.spr") base(Targetname, MoveWith) = ambient_generic : "Plays Sounds/Sentences"
[
	message(sound) : "WAV Name" : : "A .wav, a !sentence or an .mp3. An .mp3 plays as music, which is heard everywhere and has no pitch or radius."
	health(integer) : "Volume (10 = loudest)" : 10 : "How loud the sound is, from 0 for silent up to 10 for the loudest. If left empty, the sound is silent, unless you pick a Dynamic Preset or play an .mp3, which ignore Volume."
	preset(choices) : "Dynamic Presets" : 0 =
	[
		0 : "None"
		1 : "Huge Machine"
		2 : "Big Machine"
		3 : "Machine"
		4 : "Slow Fade in"
		5 : "Fade in"
		6 : "Quick Fade in"
		7 : "Slow Pulse"
		8 : "Pulse"
		9 : "Quick pulse"
		10 : "Slow Oscillator"
		11 : "Oscillator"
		12 : "Quick Oscillator"
		13 : "Grunge pitch"
		14 : "Very low pitch"
		15 : "Low pitch"
		16 : "High pitch"
		17 : "Very high pitch"
		18 : "Screaming pitch"
		19 : "Oscillate spinup/down"
		20 : "Pulse spinup/down"
		21 : "Random pitch"
		22 : "Random pitch fast"
		23 : "Incremental Spinup"
		24 : "Alien"
		25 : "Bizzare"
		26 : "Planet X"
		27 : "Haunted"
	]
	volstart(integer) : "Start Volume" : 0
	fadein(integer) : "Fade in time (0-100)" : 0
	fadeout(integer) : "Fade out time (0-100)" : 0
	pitch(integer) : "Pitch (> 100 = higher)" : 100 : "The pitch of the sound, where 100 is normal and higher numbers play it higher. If left empty or set to 0, it plays at the normal pitch. With Spin up, an empty Pitch stops the sound as soon as it starts, unless Start Pitch is empty too, which plays it at the lowest pitch. With Spin down, it plays at the normal pitch and spins down from there when you turn it off."
	pitchstart(integer) : "Start Pitch" : 100 : "The pitch Spin up starts from and Spin down ends at. If left empty, Spin up starts from the normal pitch, 100, and Spin down slides all the way to the lowest pitch before the sound stops."
	spinup(integer) : "Spin up time (0-100)" : 0
	spindown(integer) : "Spin down time (0-100)" : 0
	lfotype(integer) : "LFO type 0)off 1)sqr 2)tri 3)rnd" : 0
	lforate(integer) : "LFO rate (0-1000)" : 0
	lfomodpitch(integer) : "LFO mod pitch (0-100)" : 0
	lfomodvol(integer) : "LFO mod vol (0-100)" : 0
	cspinup(integer) : "Incremental spinup count" : 0
	playmode(choices) : "Play Mode" : 0 : "With Default, the Not Toggled flag and the WAV's cue points decide. The linear modes fade from Linear Min to silence at Linear Max, and a Linear Max of 0 makes the sound silent. Play Everywhere turns the fade off." =
	[
		0 : "Default"
		1 : "Play once"
		2 : "Loop"
		5 : "Play once, linear falloff"
		6 : "Loop, linear falloff"
	]
	linearmin(integer) : "Linear Min: full volume radius (1 = 256 units)" : 0
	linearmax(integer) : "Linear Max: silent beyond this radius (1 = 256 units)" : 0
	spawnflags(flags) =
	[
		1 : "Play Everywhere" : 0
		2 : "Small Radius" : 0
		4 : "Medium Radius" : 1
		8 : "Large Radius" : 0
		16 : "Start Silent" : 0
		32 : "Not Toggled" : 0
	]
]

// Map music: an MP3 every player hears everywhere, at their own music volume. Trigger to start or stop.
// One track plays at a time; starting another ambient_music replaces it.
@PointClass iconsprite("sprites/editor/ambient_music.spr") base(Targetname) color(220 30 220) = ambient_music : "Map Music (MP3, heard everywhere)"
[
	message(sound) : "MP3 file (under sound/)" : : "Path under sound/, e.g. mymap/theme.mp3 (at most 57 characters). The game adds it to the map's downloads."
	spawnflags(flags) =
	[
		1 : "Start Silent" : 0
		2 : "Loop" : 0
	]
]

