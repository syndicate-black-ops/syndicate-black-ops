@BaseClass base(Targetname, Target, RenderFields, Effects, Global, Angles, ZHLT, MoveWith) = BaseTank
[
	spawnflags(flags) =
	[
		1 : "Active" : 0
		16 : "Only Direct" : 0
		32 : "Controllable" : 0
		64 : "Laser Spot" : 0
		128 : "Match Target" : 0
		256 : "Smoke on empty" : 0
	]
	player_weapon_volume(integer) : "Player weapon volume" : 0 : "How loud a player's shots with it are to monsters. With 0, they are loud, at 1000, and with -1, they are silent."

	master(string) : "(Team) Master" : : "While the master is off, players can't take the controls. An Active tank still fires, so use Fire Master to stop that."
	firemaster(string) : "Fire Master" : "" : "It fires only while this master is on (it still aims and turns)."

	yawrate(string) : "Yaw rate" : "30" : "Degrees per second it turns left and right. If left empty, it doesn't turn."
	yawrange(string) : "Yaw range" : "180" : "Degrees it can turn to each side of where it faces. If left empty, it can't turn."
	yawtolerance(string) : "Yaw tolerance" : "15" : "How many degrees off its target, to the left or right, it may aim and still fire on its own. If left empty, it never fires on its own unless Only Direct is set."
	pitchrate(string) : "Pitch rate" : "0"
	pitchrange(string) : "Pitch range" : "0"
	pitchtolerance(string) : "Pitch tolerance" : "5" : "How many degrees off its target, up or down, it may aim and still fire on its own. If left empty, it never fires on its own unless Only Direct is set."
	barrel(string) : "Barrel Length" : "0"
	barrely(string) : "Barrel Horizontal" : "0"
	barrelz(string) : "Barrel Vertical" : "0"
	spritesmoke(string) : "Smoke Sprite" : "" : "A sprite made at the barrel at each shot. Can't be changed while the map runs."
	spriteflash(string) : "Flash Sprite" : "" : "A sprite made at the barrel at each shot. Can't be changed while the map runs."
	spritescale(string) : "Sprite scale" : "1" : "Size of the smoke and flash sprites. If left empty or set to 0, they are their normal size."
	rotatesound(sound) : "Rotate Sound" : ""
	firerate(string) : "Rate of Fire" : "1"
	persistence(string) : "Firing persistence" : "1" : "Seconds it keeps firing after it loses sight of its target. If left empty, it never fires on its own."
	minRange(string) : "Minimum target range" : "0"
	maxRange(string) : "Maximum target range" : "0"
	bulletCount(integer) : "Bullet count" : 0 : "How many shots it has, where 0 or less means no limit. When it runs out, it clicks instead of firing."
	m_iClass(choices) : "Behavior/Classification" : 0 : "Who an Active tank shoots at. With Attack only players, it shoots the nearest player in view, and a Maximum target range of 0 means no limit. With another class, it shoots players and monsters that class hates within Maximum target range, and a range of 0 means 512. Monsters see it as this class." =
	[
		0 : "Attack only players"
		4 : "Human Military"
		5 : "Alien Military"
		11 : "Player Ally"
	]
	extra_barrels(string) : "Extra barrels name" : "" : "Tanks with this name (not Active) turn with this one and fire when it fires."
	m_iszLocusFire(string) : "Trigger on firing (locus = barrel)" : "" : "Fired at each shot; the activator is a point at the barrel's end."
	smokerendermode(choices) : "Smoke sprite render mode" : 0 =
	[
		0 : "Default (Solid)"
		1 : "Color"
		2 : "Texture"
		3 : "Glow"
		4 : "Solid"
		5 : "Additive"
	]
]

@BaseClass = PlatSounds
[
	movesnd(choices) : "Move Sound" : 0 =
	[
		0 : "No Sound"
		1 : "big elev 1"
		2 : "big elev 2"
		3 : "tech elev 1"
		4 : "tech elev 2"
		5 : "tech elev 3"
		6 : "freight elev 1"
		7 : "freight elev 2"
		8 : "heavy elev"
		9 : "rack elev"
		10 : "rail elev"
		11 : "squeek elev"
		12 : "odd elev 1"
		13 : "odd elev 2"
	]
	stopsnd(choices) : "Stop Sound" : 0 =
	[
		0 : "No Sound"
		1 : "big elev stop1"
		2 : "big elev stop2"
		3 : "freight elev stop"
		4 : "heavy elev stop"
		5 : "rack stop"
		6 : "rail stop"
		7 : "squeek stop"
		8 : "quick stop"
	]
	volume(string) : "Sound Volume 0.0 - 1.0" : "0.85" : "How loud its sounds are. With 0, the volume is 0.85."
	fireonstart(target_destination) : "Fire On Start" : "" : "Fired when it starts moving (either way)."
	fireonstart_triggerstate(choices) : "Fire On Start use type" : 0 =
	[
		0 : "Off"
		1 : "On"
		2 : "Toggle"
	]
	fireonstop(target_destination) : "Fire On Stop" : "" : "Fired when it stops (either end)."
	fireonstop_triggerstate(choices) : "Fire On Stop use type" : 0 =
	[
		0 : "Off"
		1 : "On"
		2 : "Toggle"
	]
	soundradius(choices) : "Sound radius" : 0 =
	[
		-2 : "Small"
		-1 : "Medium"
		0 : "Default (large)"
		1 : "Huge"
		2 : "Enormous"
		3 : "Play Everywhere"
	]
	custommovesnd(sound) : "Custom move sound" : "" : "A sound file instead of the Move Sound."
	customstopsnd(sound) : "Custom stop sound" : "" : "A sound file instead of the Stop Sound."
]

@BaseClass base(Targetname, RenderFields, Global, PlatSounds, ZHLT) = Trackchange
[
	height(integer) : "Travel altitude" : 0 : "How far it moves down. With 0, it moves its own height minus 8. With Rotate Only, it doesn't move."
	spawnflags(flags) =
	[
		8 : "Start at Bottom" : 0
		16 : "Rotate Only" : 0
		64 : "X Axis" : 0
		128 : "Y Axis" : 0
	]
	rotation(integer) : "Spin amount" : 0
	train(target_destination) : "Train to switch"
	toptrack(target_destination) : "Top track"
	bottomtrack(target_destination) : "Bottom track"
	speed(integer) : "Move/Rotate speed" : 0 : "Units per second, or degrees per second with Rotate Only. With 0, it is 150."
	fireonopening(target_destination) : "Fire On Open Start" : "" : "Fired when it starts moving to its top position (Top track)."
	fireonopening_triggerstate(choices) : "Fire On Open Start use type" : 0 =
	[
		0 : "Off"
		1 : "On"
		2 : "Toggle"
	]
	fireonclosing(target_destination) : "Fire On Close Start" : "" : "Fired when it starts moving to its bottom position (Bottom track). It starts at the top, so its first trigger does this."
	fireonclosing_triggerstate(choices) : "Fire On Close Start use type" : 0 =
	[
		0 : "Off"
		1 : "On"
		2 : "Toggle"
	]
	fireonopened(target_destination) : "Fire On Open End" : "" : "Fired when it reaches its top position."
	fireonopened_triggerstate(choices) : "Fire On Open End use type" : 0 =
	[
		0 : "Off"
		1 : "On"
		2 : "Toggle"
	]
	fireonclosed(target_destination) : "Fire On Close End" : "" : "Fired when it reaches its bottom position."
	fireonclosed_triggerstate(choices) : "Fire On Close End use type" : 0 =
	[
		0 : "Off"
		1 : "On"
		2 : "Toggle"
	]
]

