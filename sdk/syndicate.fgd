@SolidClass base(Targetname, Global, RenderFields, ZHLT) = func_tracktrain : "Track Train"
[
	spawnflags(flags) =
	[
		1 : "No Pitch (X-rot)" : 0
		2 : "No User Control" : 0
		4 : "Forwards Only" : 0
		8 : "Passable" : 0
	]
	target(target_destination) : "First stop target"
	sounds(choices) : "Sound" : 0 =
	[
		0 : "None"
		1 : "Rail 1"
		2 : "Rail 2"
		3 : "Rail 3"
		4 : "Rail 4"
		5 : "Rail 6"
		6 : "Rail 7"
	]
	wheels(integer) : "Distance between the wheels" : 50 : "How far apart the front and back wheels are, which sets how the train turns along the path. If left empty or set to 0, a moving train steers as if they were 100 units apart, but it isn't turned along the path where it starts."
	height(integer) : "Height above track" : 4 : "How far above the path_track points the train's origin rides. If left empty, it rides on the path."
	startspeed(integer) : "Initial speed" : 0
	speed(integer) : "Speed (units per second)" : 64 : "Its top speed in units per second. If left empty or set to 0, its top speed is 100."
	dmg(integer) : "Damage on crush" : 0 : "Damage each frame something blocks it, and the speed the blocker is pushed away at. Riders are not hurt. With 0, it does no damage."
	volume(integer) : "Volume (10 = loudest)" : 10 : "How loud it is. With 0, it plays at 10, the loudest. For no sound, set Sound to None."
	bank(string) : "Bank angle on turns" : "0"
	soundradius(choices) : "Sound radius" : 0 =
	[
		-2 : "Small"
		-1 : "Medium"
		0 : "Default (large)"
		1 : "Huge"
		2 : "Enormous"
		3 : "Play Everywhere"
	]
	custommovesnd(sound) : "Custom move sound" : "" : "A sound file instead of the Sound choice (pitched by speed)."
	customstopsnd(sound) : "Custom brake sound" : "" : "The sound it plays when it brakes. If left empty, it plays plats/ttrain_brake1.wav."
]

@SolidClass base(Targetname, Global, PlatSounds, RenderFields, ZHLT) = func_train : "Moving platform"
[
	fireonstart(target_destination) : "Fire On Start" : "" : "Fired each time it sets off toward the next path_corner (at every corner)."
	fireonstop(target_destination) : "Fire On Stop" : "" : "Fired each time it stops, at a corner with a wait, at the end of the path or when it is turned off."
	target(target_destination) : "First stop target"
	speed(integer) : "Speed (units per second)" : 64 : "How fast it moves, in units per second. If left empty or set to 0, it moves at 100 units per second."
	avelocity(string) : "Angular Velocity (y z x)"
	dmg(integer) : "Damage on crush" : 0 : "Damage to what blocks it, at most every 0.5 seconds. With 0, it does 2, or none with No default damage."
	skin(integer) : "Contents" : 0 : "Only with Not solid (8), what it is filled with, where -3 is water, -4 slime and -5 lava."
	m_iObeyTriggerMode(choices) : "Obey Trigger Mode" : 0 : "With No, any trigger starts or stops it. With Yes, On starts it, Off stops it and Toggle toggles it." =
	[
		0 : "No"
		1 : "Yes"
	]
	spawnflags(flags) =
	[
		4 : "Initially On" : 0
		8 : "Not solid" : 0
		64 : "No default damage" : 0
	]
	soundpitch(integer) : "Move sound pitch" : 0 : "The pitch of its move sound. With 100 or 0, it is normal."
]

@SolidClass = func_traincontrols : "Train Controls"
[
	target(target_destination) : "Train Name"
]

@SolidClass base(Targetname, Angles, RenderFields, ZHLT) = func_vehicle : "Drivable Vehicles"
[
	spawnflags(flags) =
	[
		1 : "No Pitch (X-rot)" : 0
		2 : "No User Control" : 0
		8 : "Passable" : 0
	]
	target(target_destination) : "First stop target"
	sounds(choices) : "Sound" : 3 =
	[
		1 : "Vehicle 1"
		2 : "Vehicle 2"
		3 : "Vehicle 3 (default)"
		4 : "Vehicle 4"
		5 : "Vehicle 6"
		6 : "Vehicle 7"
	]
	length(integer) : "Length of the vehicle" : 256
	width(integer) : "Width of the vehicle" : 128
	height(integer) : "Height above track" : 4
	startspeed(integer) : "Initial speed" : 0
	speed(integer) : "Speed (units per second, 0 = 165)" : 0
	acceleration(integer) : "Acceleration (1-10)" : 5
	dmg(integer) : "Push-away speed" : 0 : "Speed (units per second) a blocker is thrown away from the vehicle, plus 300 upward. A blocker in front of, behind or beside it also takes 150 damage."
	volume(integer) : "Volume (10 = loudest)" : 10 : "How loud it is. With 0, it plays at 10, the loudest."
	reverse_speed(string) : "Custom reverse speed" : "" : "Top speed backwards, in units per second. If left empty or set to 0, it is 0.35 times the Speed."
	deceleration(integer) : "Custom deceleration per 0.1 seconds" : 0 : "Speed lost every 0.1 seconds when nobody accelerates or brakes. With 0, it is 20."
	stop_sound_at_halt(choices) : "Stop sound at halt" : 0 : "Silences the engine while the vehicle stands still with no driver." =
	[
		0 : "No (default)"
		1 : "When stopped and no driver"
	]
	brake_sound(sound) : "Custom brake sound" : "" : "Plays when the engine starts. If left empty, it plays plats/vehicle_brake1.wav, but only with the Sound choices Vehicle 1 to Vehicle 4."
	ignition_sound(sound) : "Custom ignition sound" : "" : "Plays when a player takes the wheel. If left empty, it plays plats/vehicle_ignition.wav."
	touch_proxy_name(string) : "Touch proxy name" : "" : "A vehicle touches no triggers. Set a name to have an entity of that name ride with it and touch triggers that accept other entities."
	_minlight(string) : "Minimum light level" : "0"
]

