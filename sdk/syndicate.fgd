@PointClass base(Targetname, Angles, ZHLT_point) iconsprite("sprites/editor/light_environment.spr") = light_environment : "Environment"
[
	spawnflags(flags) =
	[
		// Initially dark: a named sun starts off (its style "a") until triggered
		1 : "Initially dark" : 0
	]
	pitch(integer) : "Pitch" : -90 : "A negative number points the sun down, and -90 points it straight down. If left empty, the sun uses the pitch of Angles, where 0 is level with the horizon."
	_light(color255) : "Brightness" : "255 255 128 200" : "Sun color (R G B) and brightness. Also the in-game model lighting (sv_skycolor), which stays on when a named sun is dark."
	_spread(integer) : "Sun Spread Angle [0-10]" : 0 : "For the compiler, the spread angle in degrees for soft sun shadows, where 0 gives hard shadows. ZHLT doesn't have this key."
	_diffuse_light(color255) : "Ambient Color (Diffuse Light)" : "" : "For the compiler, the color and brightness of the sky's ambient light. If left empty, it uses the sun's."
	_diffuse_light2(color255) : "Sun Diffuse (bounced sunlight)" : "" : "For the compiler, the diffuse color of bounced sunlight only. If left empty, it uses the Ambient Color. ZHLT doesn't have this key."
	_fake(choices) : "Only Dynamic (only affects models)" : "" : "For the compiler. With Yes, it only sets the model lighting and adds no lightmap light. ZHLT doesn't have this key." =
	[
		"" : "No"
		1 : "Yes"
	]
	style(choices) : "Appearance" : 0 : "For unnamed lights only. A named light uses Custom Appearance instead, which is normal when left empty." =
	[
		0 : "Normal"
		10 : "Fluorescent flicker"
		2 : "Slow, strong pulse"
		11 : "Slow pulse, noblack"
		5 : "Gentle pulse"
		1 : "Flicker A"
		6 : "Flicker B"
		3 : "Candle A"
		7 : "Candle B"
		8 : "Candle C"
		4 : "Fast strobe"
		9 : "Slow strobe"
	]
	pattern(string) : "Custom Appearance"
]

// Gives named lights another appearance, faded in, for a while or for good.
@PointClass base(Targetname) color(255 255 128) iconsprite("sprites/editor/trigger_lightstyle.spr") = trigger_lightstyle : "Trigger Change Lightstyle"
[
	target(target_destination) : "Light(s) to affect (named lights)"
	appearance(choices) : "New appearance" : 0 =
	[
		0 : "Normal (steady)"
		13 : "Off"
		10 : "Fluorescent flicker"
		2 : "Slow, strong pulse"
		11 : "Slow pulse, noblack"
		5 : "Gentle pulse"
		1 : "Flicker A"
		6 : "Flicker B"
		3 : "Candle A"
		7 : "Candle B"
		8 : "Candle C"
		4 : "Fast strobe"
		9 : "Slow strobe"
		12 : "Underwater"
		14 : "Slow fade in"
		15 : "Medium fade in"
		16 : "Fast fade in"
		17 : "Slow fade out"
		18 : "Medium fade out"
		19 : "Fast fade out"
	]
	pattern(string) : "Custom appearance (letters a-z, a = dark, m = normal, z = bright)"
	m_iFade(integer) : "Fade time (seconds)" : 0
	m_iWait(string) : "Hold time (seconds, -1 = permanent)" : "-1" : "Seconds the new appearance holds before the light's own comes back, and decimals such as 0.6 work. With -1, it holds for good."
	round_reset(choices) : "Reset light styles at round start" : 0 : "With Yes, every light style goes back to its state at map start at each round start." =
	[
		0 : "No"
		1 : "Yes"
	]
]

// Sets a light pattern on all lights without a style, on custom styles, or on named lights.
// Without a name it applies at map start.
@PointClass base(Targetname) color(255 255 128) iconsprite("sprites/editor/global_light_control.spr") = global_light_control : "Global Light Control"
[
	pattern(string) : "Pattern (letters a-z, a = dark, m = normal, z = bright)" : "m"
	target_entity(target_destination) : "Only these named lights (blank = by the flags)" : : "Only the lights with this name, and the flags are then ignored. If left empty, the flags pick the lights."
	spawnflags(flags) =
	[
		65536 : "Also styles 1-63 (presets and named lights)" : 0
		131072 : "Not the default style (unstyled lights)" : 0
	]
	round_reset(choices) : "Reset light styles at round start" : 0 : "With Yes, every light style goes back to its state at map start at each round start." =
	[
		0 : "No"
		1 : "Yes"
	]
]


//
// Logic
//

@PointClass base(Targetname) color(128 128 255) iconsprite("sprites/editor/calc_state.spr") = calc_state : "Calculate State (a master): On = true, Off = false"
[
	left_operand(target_destination) : "Operand 1 (a master)" : : "A master's name. A leading ~ doesn't invert it, so use NAND or NOR for that."
	right_operand(target_destination) : "Operand 2 (a master)"
	operation(choices) : "Operation" : 0 =
	[
		0 : "AND"
		1 : "OR"
		2 : "NAND"
		3 : "NOR"
		4 : "XOR"
		5 : "NXOR"
	]
	left_fallback(choices) : "Operand 1 missing" : 0 =
	[
		0 : "Treat as error (false, fires nothing)"
		1 : "Treat as Off"
		2 : "Treat as On"
	]
	right_fallback(choices) : "Operand 2 missing" : 0 =
	[
		0 : "Treat as error"
		1 : "Treat as Off"
		2 : "Treat as On"
	]
	target(target_destination) : "Target when triggered (On if true, Off if false)"
	fire_when_false(target_destination) : "Fire when false"
	fire_when_true(target_destination) : "Fire when true"
	spawnflags(flags) =
	[
		2 : "Debug Mode" : 0
	]
]

// Watches the states of other entities (a door open or closed, a monster alive or dead, a light on or off, ...).
// Every key that isn't listed below names an entity to watch, as a multi_manager's keys name its targets (the value
// is not used). A master itself: it passes while its logical test is true.
@PointClass base(Targetname) color(128 128 255) iconsprite("sprites/editor/multi_watcher.spr") = multi_watcher : "State Watcher (a master)"
[
	m_iszWatch(target_destination) : "Entity to watch" : : "One more entity to watch, besides the extra keys."
	m_fLogic(choices) : "Logical test" : 0 =
	[
		0 : "All (AND)"
		2 : "Not all (NAND)"
		1 : "At least one (OR)"
		3 : "None (NOR)"
		4 : "Exactly one (XOR)"
		5 : "Any number but one (XNOR)"
	]
	target(target_destination) : "Entity to notify" : : "Fired with On when the test turns true, Off when it turns false."
	spawnflags(flags) =
	[
		1 : "Send 'Toggle'" : 0
		2 : "Don't send On" : 0
		4 : "Don't send Off" : 0
		8 : "NOT 'On'" : 0
		16 : "'Off'" : 0
		32 : "'Turn On'" : 0
		64 : "'Turn Off'" : 0
		128 : "'In Use'" : 0
	]
]

// Counts the entities of one name that aren't Off (a living monster, an open door, a lit light, ...) and compares
// the count with a number. A master itself: it passes while the comparison is true.
@PointClass base(Targetname) color(128 128 255) iconsprite("sprites/editor/watcher_count.spr") = watcher_count : "Watcher, entity count (a master)"
[
	noise(target_destination) : "Count entities named..."
	impulse(integer) : "Comparison number" : 0
	m_iMode(choices) : "Type of comparison" : 0 =
	[
		0 : "'On' when count = number"
		3 : "'On' when count != number"
		1 : "'On' when count > number"
		5 : "'On' when count >= number"
		2 : "'On' when count < number"
		4 : "'On' when count <= number"
	]
	target(target_destination) : "Fire on changing state" : : "Fired with On when the comparison turns true, Off when it turns false."
	netname(target_destination) : "Fire on turning on"
	message(target_destination) : "Fire on turning off"
	noise1(target_destination) : "Fire when count increases"
	noise2(target_destination) : "Fire when count decreases"
	spawnflags(flags) =
	[
		1 : "Fire at startup" : 0
	]
]

@PointClass base(Targetname) color(255 255 128) iconsprite("sprites/editor/env_global.spr") = env_global : "Global State"
[
	globalstate(string) : "Global State to Set"
	triggermode(choices) : "Trigger Mode" : 0 =
	[
		0 : "Off"
		1 : "On"
		2 : "Dead"
		3 : "Toggle"
		4 : "Modify / Set value"
		5 : "Set state: obey use type"
	]
	initialstate(choices) : "Initial State" : 0 =
	[
		0 : "Off"
		1 : "On"
