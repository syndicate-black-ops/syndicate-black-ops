@PointClass base(Targetname, RenderFxChoices, Angles) size(-16 -16 -16, 16 16 16) iconsprite("sprites/editor/env_laser.spr") = env_laser : "Laser Beam Effect"
[
	LaserTarget(target_destination) : "Target of Laser"
	renderamt(integer) : "Brightness (1 - 255)" : 100 : "How bright the laser is, from 1 to 255. If left empty, the laser can't be seen."
	rendercolor(color255) : "Beam Color (R G B)" : "0 0 0"
	width(integer) : "Width of beam (pixels*0.1 0-255)" : 20 : "How wide the beam is. If left empty, the beam has no width and can't be seen."
	NoiseAmplitude(integer) : "Amount of noise (0-255)" : 0
	texture(sprite) : "Sprite Name" : "sprites/laserbeam.spr" : "The beam sprite. If left empty, the entity removes itself and there is no laser."
	StartSprite(sprite) : "Start Sprite" : "" : "A sprite at the laser's start, shown with the laser."
	EndSprite(sprite) : "End Sprite" : ""
	TextureScroll(integer) : "Texture Scroll Rate (0-100)" : 35 : "How fast the texture scrolls along the beam. If left empty, it doesn't scroll."
	framestart(integer) : "Starting Frame" : 0
	damage(string) : "Damage / second" : "100" : "Damage per second to anything the beam touches. A player takes more where the beam crosses them, twice as much on the chest, three times on the stomach and ten times on the head. If left empty, it does no damage."
	spawnflags(flags) =
	[
		1 : "Start On" : 0
		16 : "StartSparks" : 0
