	duration(string) : "Duration (seconds)" : "2"
	holdtime(string) : "Hold Fade (seconds)" : "0"
	renderamt(integer) : "Fade Alpha" : 255
	rendercolor(color255) : "Fade Color (R G B)" : "0 0 0"
]

// Fog for the whole map (OpenGL only). Without a name it is always on; with a name, trigger it on or off.
@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) color(200 200 200) iconsprite("sprites/editor/env_fog.spr") = env_fog : "Fog (whole map)"
[
	spawnflags(flags) =
	[
		1 : "Start active" : 0
	]
	rendercolor(color255) : "Fog color (R G B)" : "128 128 128"
	density(choices) : "Density (0 - 0.01; above 0.01 = no fog)" : "0.0005" =
	[
		"0.0005" : "Misty"
		"0.0007" : "Thin"
		"0.001" : "Hazy"
		"0.003" : "Moderate"
		"0.005" : "Dense"
		"0.01" : "Thick"
	]
]

// Fog inside the brush; it overrides the map's fog there. Density 0 makes a fog-free area on a foggy map.
@SolidClass base(Targetname) = env_fogzone : "Fog volume"
[
	spawnflags(flags) =
	[
		1 : "Active" : 1
	]
	rendercolor(color255) : "Fog color (R G B)" : "128 128 128"
	density(choices) : "Density (0 - 0.01; above 0.01 = no fog)" : "0.0005" =
	[
		"0" : "None (no fog in the volume)"
		"0.0005" : "Misty"
		"0.0007" : "Thin"
		"0.001" : "Hazy"
		"0.003" : "Moderate"
		"0.005" : "Dense"
		"0.01" : "Thick"
	]
]

