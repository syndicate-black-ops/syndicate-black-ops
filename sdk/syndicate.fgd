//
// Items
//

// Gives 12 seconds of air; refills after 30 seconds. Fires Target when used and again when refilled. Explodes when shot.
@PointClass base(ItemBase) studio("models/w_oxygen.mdl") = item_airtank : "Oxygen tank" []

@PointClass base(ItemBase, ItemPickupFlags) studio("models/w_battery.mdl") = item_battery : "HEV battery" []

// An inventory item (keycard, key, part, coin). A player who touches it carries it; it disappears while it is held
// and shows in the holder's inventory row on the HUD. player_hasinventory checks for it (e.g. as the master of a door)
// and player_inventory takes it. If the holder dies it drops where they died; untouched for Return Time it goes back to
// where you placed it. It also goes back at once when the holder leaves, becomes a spectator or a Game Master, is stripped
// (player_weaponstrip), and at a round restart.
// Shared: the whole team holds it (any player can use it, and the world too); it stays across rounds.
@PointClass base(ItemBase, ItemPickupFlags) studio() = item_pickup : "Inventory item (keycard, key)"
[
	model(studio) : "Model" : "models/w_security.mdl" : "Leave empty for the security card."
	item_name(string) : "Item name" : : "Up to 31 characters. Every check and player_inventory names the item by this, e.g. keycard_red."
	item_icon(choices) : "HUD icon" : "inv_key" : "Its icon in the inventory row, as a name from sprites/hud.txt." =
	[
		"inv_key" : "Key"
		"inv_card_red" : "Red keycard"
		"inv_card_blue" : "Blue keycard"
		"inv_card_yellow" : "Yellow keycard"
	]
	count(integer) : "Count" : 1 : "How many the item counts for (1 to 32767)."
	collect_limit(integer) : "Collect limit" : 0 : "A player, or the team when Shared, can't take it if that would make them hold more than this of the item. With 0, there is no limit."
	return_timelimit(string) : "Return time" : "45" : "Seconds a dropped item lies untouched before it goes back to its placed spot. With 0, it goes straight back."
	holder_keep_on_death(choices) : "Keep on death" : 0 : "With Yes, the holder keeps it when they die or are stripped, so Bounty Killer and Battle Royale players respawn with it. It still goes back at a round restart or when they leave." =
	[
		0 : "No"
		1 : "Yes"
	]
	round_reset(choices) : "Reset at round start" : 0 : "For Shared items only, Yes takes it back from the team and puts it on its spot at each round start. Personal items always go back." =
	[
		0 : "No"
		1 : "Yes"
	]
	noise(sound) : "Pickup sound" : "items/gunpickup2.wav"
	message(string) : "Pickup message" : : "Shown to the player who takes it."
	spawnflags(flags) =
	[
		4 : "Shared (whole team)" : 0
	]
]

@PointClass base(Targetname, Angles) size(-16 -16 0, 16 16 36) color(0 0 200) studio("models/can.mdl") = item_sodacan : "Soda Can"
[
	skin(choices) : "Beverage Type" =
	[
		0 : "Hai! (Green)"
		1 : "Glub (Brown)"
		2 : "Grope (Purple)"
		3 : "Outhrie (Blue)"
		4 : "Yuck (Green+brown)"
		5 : "Dante (Fire)"
	]
]


