@PointClass base(MonsterCore, MonsterUnkillable, MonsterFlags, MonsterClip, MonsterFadeCorpse, Target, MonsterTriggers, MonsterSound, BodySkin) size(-360 -360 -172, 360 360 8) studio("models/apache.mdl") = monster_apache : "Apache"
[
	TriggerCondition(choices) : "Trigger Condition" : 0 =
	[
		0 : "No Trigger"
		1 : "See Player, Mad at Player"
		2 : "Take Damage"
		3 : "50% Health Remaining"
		4 : "Death"
		7 : "Hear World"
		8 : "Hear Player"
		9 : "Hear Combat"
		10 : "See Player Unconditional"
		11 : "See Player, Not In Combat"
		13 : "Got healed"
	]
	TriggerAltCondition(choices) : "Trigger Alternative Condition" : 0 : "A second condition that fires TriggerTarget (whichever comes first, once)." =
	[
		0 : "No Trigger"
		1 : "See Player, Mad at Player"
		2 : "Take Damage"
		3 : "50% Health Remaining"
		4 : "Death"
		7 : "Hear World"
		8 : "Hear Player"
		9 : "Hear Combat"
		10 : "See Player Unconditional"
		11 : "See Player, Not In Combat"
		13 : "Got healed"
	]
	target(target_destination) : "Target" : : "The path_corner it flies to first; from there it follows the path."
	// Wait For Trigger / Start Inactive: hovers until triggered, then hunts. Fire Rockets: rockets as well as the chaingun.
	// Explode sooner: a shot-down apache explodes when it hits something, or after 15 s in the air (4 s with this flag). No Wreckage: the crash leaves no burning wreck or debris.
	spawnflags(flags) =
	[
		4 : "Wait For Trigger (same as Start Inactive)" : 0
		8 : "Explode sooner in the air (4 s, not 15)" : 0
		32 : "Fire Rockets" : 0
		64 : "Start Inactive" : 0
		1024 : "No Wreckage" : 0
	]
	rotorvolume(string) : "Rotor sound volume (0.1 - 1.0)" : "" : "How loud the rotor sound is. If left empty or set to 0, it plays at full volume."
	m_iObeyTriggerMode(choices) : "Obey Trigger Mode" : 0 : "With No, the first trigger starts it and later ones do nothing. With Yes, Off stops it in the air and On starts it again." =
	[
		0 : "No"
		1 : "Yes"
	]
]

