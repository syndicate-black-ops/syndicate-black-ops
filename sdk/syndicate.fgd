	mode(choices) : "Use Mode" : 0 : "In List mode, add one key per name with SmartEdit off, with the name as the key and its place in the list, 1 to 16, as the value." =
	[
		0 : "On/Off"
		1 : "List"
	]
	spawnflags(flags) =
	[
		1 : "Start Off" : 0
		2 : "Debug Mode" : 0
	]
]

