@PointClass base(Targetname, Angles, RenderFieldsUnset) size(-16 -16 -16, 16 16 16) studio("models/editor/monstermaker.mdl") = monstermaker : "Monster Maker"
[
	target(string) : "Target On Release"
	netname(string) : "Children's Name"
	squadname(string) : "Children's squad name" : : "The squad name every child gets."
	weapons(choices) : "Children's weapons" : 0 : "Weapons every grunt child gets (dark grunts: chaingun or sniper). 0: the monster's own." =
	[
		0 : "The monster's own"
		1 : "9mmAR"
		3 : "9mmAR + HG"
		5 : "9mmAR + GL"
		8 : "Shotgun"
		10 : "Shotgun + HG"
	]
	Ff(choices) : "Children's Ignore Friendly Damage" : 0 : "Every child ignores damage from its allies (grunts, assassins and turrets)." =
	[
		0 : "No"
		1 : "Yes"
	]
	childtarget(target_destination) : "Children's Target (path)" : : "The path_corner or path_track every child follows."
	childtriggertarget(target_destination) : "Children's TriggerTarget"
	childtriggercondition(choices) : "Children's Trigger Condition" : 0 =
	[
		0 : "No Trigger"
		1 : "See Player, Mad at Player"
		2 : "Take Damage"
		3 : "50% Health Remaining"
		4 : "Death"
		7 : "Hear World"
		8 : "Hear Player"
		9 : "Hear Combat"
		10 : "See Player Unconditional"
		11 : "See Player, Not In Combat"
	]
	childspawnflags(integer) : "Children's spawnflags" : 0 : "Spawnflags every child gets, as the sum of the monster's flag values (e.g. 32: Apache Fire Rockets)."

	monstertype(choices) : "Monster Type" : "monster_apache" =
	[
		"monster_apache" : "Apache"
		"monster_barney" : "Barney"
		"monster_cyborg" : "Cyborg"
		"monster_cyberminotor" : "Cyber Minotaur"
		"monster_dark" : "Sectum Streuoum"
		"monster_gargantua" : "Gargantua"
		"monster_grunt_hunter" : "Dark Grunt (Hunter)"
		"monster_grunt_hunter_repel" : "Dark Grunt (Repel, Hunter)"
		"monster_human_assassin" : "Assassin"
		"monster_human_grunt" : "Human Grunt"
		"monster_grunt_repel" : "Human Grunt (Repel)"
		"monster_alien_slave" : "Demon Slave"
		"monster_hunter" : "Demon Slave (Hunter)"
		"monster_ichthyosaur" : "Ichthyosaur"
		"monster_imp" : "Imp"
		"monster_imp_hunter" : "Imp (Hunter)"
		"monster_scientist" : "Sectum"
		"monster_snark" : "Pitbull"
		"monster_sentry" : "Sentry"
		"monster_werewolf" : "Werewolf"
		"monster_werewolf_hunter" : "Werewolf (Hunter)"
		"monster_zombie" : "Zombie"
		"monster_zombie_hunter" : "Zombie (Hunter)"
		"monster_zombie_grunt" : "Zombie Grunt"
	]

	spawnflags(flags) =
	[
		1 : "Start ON" : 0
		4 : "Cyclic" : 0
		8 : "MonsterClip" : 0
		16 : "Prisoner" : 0
		32 : "Auto size BBox" : 0
		64 : "Cyclic backlog" : 0
		256 : "Pre-Disaster" : 0
		8192 : "Monster Flag 64" : 0
		32768 : "Monster special flag" : 0
		65536 : "Non-solid corpse" : 0
		524288 : "Ignore move away requests" : 0
		1048576 : "Act out of PVS" : 0
	]

	monstercount(integer) : "Number of Monsters" : -1 : "How many monsters it makes in all. -1: no limit."

	body(integer) : "Children's body" : 0 : "Body every child gets (scientists, monster_dark, zombies). 0: the monster's own."
	scale(string) : "Children's scale" : "" : "Model scale every child gets. Empty: the monster's own."

	delay(string) : "Frequency" : "5" : "Seconds between monsters. -1: a new one when the last one dies."
	m_imaxlivechildren(integer) : "Max live children" : 5 : "No new monster while this many are alive. -1: no limit."
	spawnorigin(string) : "Spawn position [LP] (blank = here)" : "" : "Where each child appears: x y z, an entity name or !activator."
	face_position(string) : "Face position [LP]" : "" : "Each child faces this point; *player: the nearest player in play."
	warpball(target_destination) : "Warpball (an env_warpball)" : "" : "An env_warpball that plays where each child appears."
	impulse(choices) : "Warp at monster's..." : 0 : "Where the warpball plays on the new monster." =
	[
		-1 : "Origin"
		0 : "Default (Center)"
		1 : "Center"
	]
	spawndelay(string) : "Delay before spawn" : "" : "Seconds between the warpball and the monster appearing. Empty or 0: at once."
	delay_after_blocked(string) : "Delay after blocked" : "" : "Seconds before the next try when the spot was taken. Empty: the Frequency."
	target_activator(choices) : "Target's Activator" : 0 : "The activator of Target On Release." =
	[
		-1 : "Don't pass activator"
		0 : "Default (Monstermaker)"
		1 : "Monstermaker"
		2 : "Spawned monster"
		3 : "Forward my activator"
	]
	yawdeviation(integer) : "Max yaw deviation" : 0 : "Each child turns a random amount up to this many degrees left or right."
	trigger_on_death_notice(target_destination) : "Trigger on death notice" : "" : "Fired each time one of its children dies."
	classify(choices) : "Children's classification" : "" : "The class every child fights as. Empty or 0: its own." =
	[
		-1 : "None"
		0 : "Object default"
		1 : "Machine"
		2 : "Player"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
	respawn_as_playerally(choices) : "Reverse Relationship" : 0 : "Yes: every child changes sides (Is player ally)." =
	[
		0 : "No"
		1 : "Yes"
	]
	make_blocker_move_away(choices) : "Make blocker move away" : 0 : "When a monster stands on the spot, ask it to move away." =
	[
		0 : "No"
		1 : "Yes, walking"
		2 : "Yes, running"
	]
	gag(choices) : "Gag" : 0 : "Yes: every child is Gagged (no idle chatter)." =
	[
		0 : "No"
		1 : "Yes"
	]
	change_rendermode(choices) : "Override Render Mode" : 0 : "Yes: every child gets this maker's render settings." =
	[
		0 : "No"
		1 : "Yes"
	]
]


