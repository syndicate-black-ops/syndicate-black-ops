[
	model(string) : "Model" : "models/gman.mdl" : "The model shown in the game. If left empty, or set to an editor model or a file that's missing, the entity is removed."
]

@PointClass base(Targetname) iconsprite("sprites/editor/game_end.spr") = game_end : "Mission Complete: players win the mission when this is triggered. Co-op maps only."
[
	master(string) : "Master"
]

@PointClass base(Targetname) iconsprite("sprites/editor/mission_failed.spr") = mission_failed : "Mission Failed: the mission fails when this is triggered. Co-op maps only."
