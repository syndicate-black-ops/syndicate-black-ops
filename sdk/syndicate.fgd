@SolidClass base(Targetname, Global, RenderFields, Angles, ZHLT, LockedSounds, CustomObjectHint, MoveWith) = func_rot_button : "Rotating Button"
[
	target(target_destination) : "Targeted object"
	master(string) : "Master"
	speed(integer) : "Speed" : 50 : "How fast it turns, in degrees per second. If left empty or set to 0, it turns at 40 degrees per second."
	health(integer) : "Health (shootable if > 0)"
	sounds(choices) : "Sounds" : 21 : "The sound it makes when used. If left empty, it makes no sound." =
	[
		21 : "Squeaky"
		22 : "Squeaky Pneumatic"
		23 : "Ratchet Groan"
		24 : "Clean Ratchet"
		25 : "Gas Clunk"
	]
	wait(choices) : "Delay before reset" : 3 : "Seconds before it can be used again. If left empty or set to 0, it waits 1 second." =
	[
		-1 : "Stays pressed"
	]
	delay(string) : "Delay before trigger" : "0"
	distance(integer) : "Distance (deg)" : 90 : "Degrees it turns when used. If left empty or set to 0, it doesn't turn, but it still fires."
	spawnflags(flags) =
	[
		1 : "Not solid" : 0
		2 : "Reverse Dir" : 0
		32 : "Toggle" : 0
		64 : "X Axis" : 0
		128 : "Y Axis" : 0
		256 : "Touch Activates" : 0
		16384 : "Player Can't Use" : 0
	]
	trigger_before_move(target_destination) : "Trigger before move" : "" : "Fired when it starts moving in."
	trigger_on_return(target_destination) : "Trigger on return" : "" : "Fired when it is back out."
	target_on_locked(target_destination) : "Target when locked" : "" : "Fired when used while its master is locked (at most every 2 seconds)."
	usetype(choices) : "Use type" : 0 : "The use type its targets get." =
	[
		-1 : "Off"
		0 : "Toggle"
		1 : "On"
		2 : "On/Off (Toggle buttons: On in, Off out)"
		3 : "Off/On (Toggle buttons: Off in, On out)"
	]
	wait_toggle(string) : "Wait before toggling again" : "" : "For toggle buttons, the seconds before it can be used again."
	noise(sound) : "Custom sound" : "" : "A sound file instead of the Sounds choice."
	directuse(choices) : "Player use policy" : 0 : "How the player must look at it to use it." =
	[
		0 : "Default"
		1 : "Direct only (look straight at it)"
		2 : "Not through walls"
	]
]

