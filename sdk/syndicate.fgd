//
// Syndicate Black Ops game definition file (.fgd) for J.A.C.K. and Hammer
//
// Based on the Half-Life FGD of the GoldSource FGD Collection:
// https://github.com/Erty-Gamedev/GoldSrcFGDCollection
//
// The editor models and sprites are in the game folder (models/editor, sprites/editor).
//


//
// Worldspawn
//

@SolidClass = worldspawn : "World entity"
[
	message(string) : "Map Description / Title"
	skyname(string) : "environment map (cl_skyname)" : : "The sky images in gfx/env, e.g. desert, dusk, night or space. If left empty, the sky is desert."
	sounds(integer) : "CD track to play" : 1
	WaveHeight(string) : "Default Wave Height"
	MaxRange(string) : "Max viewable distance" : "4096"
	chaptertitle(string) : "Chapter Title Message" : : "Text, or a titles.txt name, shown once to each player on this map when they first enter the game, whether they spawn, spectate or play Game Master. Players who join later see it too."
	startdark(choices) : "Level Fade In" : 0 : "With Yes, the screen fades in from black when the map starts. Only the player hosting a listen server sees it." =
	[
		0 : "No"
		1 : "Yes"
	]
	gametitle(choices) : "Display game title" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	newunit(choices) : "New Level Unit" : 0 : "No effect in SBO." =
	[
		0 : "No, keep current"
		1 : "Yes, clear previous levels"
	]
	mapteams(string) : "Map Team List"
	defaultteam(choices) : "Default Team" : 0 =
	[
		0 : "Fewest Players"
		1 : "First Team"
	]
	grassDensity(integer) : "Grass: density" : 0 : "How many grass pieces are drawn around the player on grass textures, which are material A. If left empty or set to 0, there is no grass. Try 100 to 400, and at most 1000."
	grassSprite(sprite) : "Grass: sprite" : "" : "The sprite the grass pieces use, which can be one that ships with the map. If left empty, the grass uses sprites/grass_01.spr and sprites/grass_03.spr."
	grassFadeDist(integer) : "Grass: fade distance" : 800 : "Grass fades out towards this distance from the player (128-4096)."
	grassMinHeight(integer) : "Grass: minimum height" : 16 : "Height of a grass piece, at least (4-256)."
	grassMaxHeight(integer) : "Grass: maximum height" : 32 : "Height of a grass piece, at most (4-256)."
	freeroam(choices) : "Monsters freeroam" : 0 : "With Yes, idle monsters whose Freeroam is Map default walk from node to node." =
	[
		0 : "No"
		1 : "Yes"
	]
	materials_file(string) : "Materials file" : : "The map's own texture materials file, which sets the footsteps, hit sounds and impact effects, e.g. materials/maps/mymap.txt. If left empty, the game uses materials/maps/<map name>.txt if that file exists."
]


//
// Base classes
//

@BaseClass = ZHLTCopyTarget
[
	zhlt_usemodel(target_destination) : "ZHLT Template Model Target"
	zhlt_copylight(target_destination) : "ZHLT Copy Lighting From Target"
	light_origin(target_destination) : "Light Origin Target"
]
@BaseClass base(ZHLTCopyTarget) = ZHLT
[
	zhlt_noclip(choices) : "ZHLT Noclip" : 0 =
	[
		0 : "Solid (default)"
		1 : "Noclip"
	]
	zhlt_lightflags(choices) : "ZHLT Lightflags" : 0 =
	[
		0 : "Default"
		1 : "Embedded Fix"
		2 : "Opaque (blocks light)"
		3 : "Opaque + Embedded fix"
		6 : "Opaque + Concave Fix"
	]
	zhlt_invisible(choices) : "ZHLT Invisible" : 0 =
	[
		0 : "Visible (default)"
		1 : "Invisible"
	]
	zhlt_customshadow(string) : "ZHLT Custom Shadow (when opaque)"
	zhlt_embedlightmap(choices) : "ZHLT Embed Light Map (when translucent)" : 0 =
	[
		0 : "No (default)"
		1 : "Yes"
	]
	zhlt_embedlightmapresolution(integer) : "ZHLT Embed Light Map Resolution" : 4
	_minlight(string) : "Minimum Light Level (0.0 - 1.0)"
]
@BaseClass = ZHLT_point
[
	_fade(string) : "ZHLT Fade" : "1.0" : "For the compiler, how fast the light fades with distance, where 1 is normal."
	_falloff(choices) : "ZHLT Falloff (ZHLT only)" : 0 : "For the compiler. Only ZHLT reads it, and other compilers ignore it." =
	[
		0 : "Default"
		1 : "Inverse Linear"
		2 : "Inverse Square"
	]
]

@BaseClass = Appearflags
[
	spawnflags(flags) =
	[
		2048 : "Not in multiplayer (never spawns)" : 0
	]
]
@BaseClass = Angles
[
	angles(choices) : "Pitch Yaw Roll (Y Z X)" : "0 0 0" =
	[
		"0 0 0" : "Default (East)"
		"-90 0 0" : "Up"
		"90 0 0" : "Down"
		"0 90 0" : "North"
		"0 180 0" : "West"
		"0 -90 0" : "South"
	]
]
@BaseClass = Targetname
[
	targetname(target_source) : "Name"
]
@BaseClass = Target
[
	target(target_destination) : "Target" : : "The name of the entities to trigger. A name ending in * triggers every other entity whose name starts with the rest, such as room1_*. With !activator, it triggers the entity that started the chain, which is usually the player, but a trigger_relay passes itself unless Forward activator is set."
]
@BaseClass = Global
[
	globalname(string) : "Global Entity Name"
]
@BaseClass = Master
[
	master(string) : "Master"
]
@BaseClass = CustomObjectHint
[
	objecthint(choices) : "Object Hint Template" : "" : "Marks the object for nearby players with faint brackets within Hint Distance, and then a color when +use would use it. With Hidden, there is no mark." =
	[
		"" : "None"
		"button" : "button"
		"charger" : "charger"
		"eyescanner" : "eyescanner"
		"pickup" : "pickup"
		"hidden" : "hidden"
	]
	objecthint_distance(integer) : "Hint Distance" : : "How close the player must be to see the brackets, at most 4096. If left empty or set to 0, it is 512."
]
@BaseClass = MoveWith
[
	movewith(target_destination) : "Move with (parent)" : "" : "Optional. The name of an entity this one moves and turns with, keeping the offset and turn it has from the parent as placed in the editor. Any entity can be a parent, e.g. func_train, func_tracktrain, func_door, func_door_rotating, func_plat, func_rotating, func_pendulum or another child. With name.N, where N is 1 to 4, a sprite or non-solid model sits on attachment N of a studio model. Solid brushes are pushed along and carry players, and sprites and non-solid models are placed on the parent by each client, with no network traffic. The key 'parent' (XashXT) works the same. See docs/MOVEWITH.md. A solid brush on a parent that turns needs an origin brush at the point it turns around. Without one, it turns around the map's origin, so things it bumps into are pushed along a wide arc, though players standing on it still ride correctly. With developer 1 set in the console, the console warns about it at map start."
	parentflags(integer) : "Axis locks (sum)" : 0 : "Optional, with 'Move with'. Keeps this entity's own value of an axis instead of following the parent, where 2 is the X position, 4 the Y position, 8 the Z position, 16 the pitch, 32 the yaw and 64 the roll. Add them up, so 112 keeps it level and unturned, like a gondola on a wheel or a lantern on a drawbridge. With 0, it follows everything."
]
@BaseClass base(Target) = Targetx
[
	delay(string) : "Delay before trigger" : "0"
	killtarget(target_destination) : "KillTarget" : : "Removes the entities with this name when this fires. A name ending in * removes every other entity whose name starts with the rest. With !activator, it removes the entity that started the chain, and with !caller, this entity itself. Players are never removed."
]

@BaseClass size(-16 -16 -16, 16 16 16) color(0 200 200) studio() = ModelBase
[
	model(studio) : "Model"
]

// A placed model lit from an info_light_origin instead of the floor under it.
@BaseClass = LightOrigin
[
	lightorigin(target_destination) : "Light origin (info_light_origin)" : : "The name of an info_light_origin, and the model is lit as if it stood there. This fixes a model that is dark under a ledge or in a wall. If left empty, the model is lit from the floor under it."
]

@BaseClass = ModelScale
[
	scale(string) : "Model scale" : "" : "Draws the model this many times its size, so 0.5 is half and 2 is double. If left empty or set to 1, it is its normal size. Its hitboxes and its solid and pick-up box scale with it, and so do a monster's attack and follow distances, but a monster still walks with its normal-size box."
]

@BaseClass = RenderFxChoices
[
	renderfx(choices) : "Render FX" : 0 =
	[
		0 : "Normal"
		1 : "Slow Pulse"
		2 : "Fast Pulse"
		3 : "Slow Wide Pulse"
		4 : "Fast Wide Pulse"
		9 : "Slow Strobe"
		10 : "Fast Strobe"
		11 : "Faster Strobe"
		12 : "Slow Flicker"
		13 : "Fast Flicker"
		5 : "Slow Fade Away"
		6 : "Fast Fade Away"
		7 : "Slow Become Solid"
		8 : "Fast Become Solid"
		14 : "Constant Glow"
		15 : "Distort"
		16 : "Hologram (Distort + fade)"
		18 : "Bulge Sideways"
		19 : "Glow Shell"
	]
]
@BaseClass base(RenderFxChoices) = RenderFields
[
	rendermode(choices) : "Render Mode" : 0 =
	[
		0 : "Normal"
		1 : "Color"
		2 : "Texture"
		3 : "Glow"
		4 : "Solid"
		5 : "Additive"
	]
	renderamt(integer) : "FX Amount (1 - 255)"
	rendercolor(color255) : "FX Color (R G B)" : "0 0 0"
]
// Render keys without defaults: the editor writes them only when set
@BaseClass = RenderFieldsUnset
[
	renderfx(choices) : "Render FX" : : "Render effect, applied on top of the Render Mode." =
	[
		0 : "Normal"
		1 : "Slow Pulse"
		2 : "Fast Pulse"
		3 : "Slow Wide Pulse"
		4 : "Fast Wide Pulse"
		9 : "Slow Strobe"
		10 : "Fast Strobe"
		11 : "Faster Strobe"
		12 : "Slow Flicker"
		13 : "Fast Flicker"
		5 : "Slow Fade Away"
		6 : "Fast Fade Away"
		7 : "Slow Become Solid"
		8 : "Fast Become Solid"
		14 : "Constant Glow"
		15 : "Distort"
		16 : "Hologram (Distort + fade)"
		18 : "Bulge Sideways"
		19 : "Glow Shell"
	]
	rendermode(choices) : "Render Mode" : : "How the object is drawn." =
	[
		0 : "Normal"
		1 : "Color"
		2 : "Texture"
		3 : "Glow"
		4 : "Solid"
		5 : "Additive"
	]
	renderamt(integer) : "FX Amount (1 - 255)"
	rendercolor(color255) : "FX Color (R G B)"
]
@BaseClass = Effects
[
	effects(choices) : "Effects" : "" =
	[
		"" : "None"
		1 : "Particle cloud"
		2 : "Muzzle flash"
		4 : "Bright flash"
		8 : "Player flashlight glow"
		16 : "Get light from ceiling"
		32 : "Don't interpolate next frame"
		64 : "Rocket flare"
		128 : "Nodraw"
	]
]

// Effects for models
@BaseClass = EntityEffects
[
	effects(choices) : "Effects" : 0 =
	[
		0 : "No effects"
		16 : "Invert light (take light from ceiling)"
	]
]

@BaseClass = Body
[
	body(integer) : "Body"
]
@BaseClass = Skin
[
	skin(integer) : "Skin"
]
@BaseClass base(Body, Skin) = BodySkin []

