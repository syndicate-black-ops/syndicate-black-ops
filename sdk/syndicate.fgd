		1 : "Sticky gib"
		2 : "Noclip shot (no collisions: never fires the collision targets)"
		3 : "Fly shot (ignore gravity)"
		4 : "Fly & bounce shot"
		5 : "Arc shot (obey gravity)"
		6 : "Arc & bounce shot"
	]
	frame(integer) : "Start frame (shot)" : 0
	framerate(string) : "Framerate (shot)" : ""
	m_fFriction(string) : "Bounce friction (shot)" : "0.55" : "For bounce shots, how much speed a shot loses each time it bounces. If left empty, a shot bounces back at full speed."
	m_iszTouch(target_destination) : "Fire on collision (shot) (locus = shot)" : ""
	m_iszTouchOther(target_destination) : "Fire on collision (shot) (locus = what it hit)" : ""
	m_vecSize(string) : "Shot size (X Y Z)" : "" : "The size of the shot's box, as X Y Z. If left empty, the shot is a point."
]

// 3D sky: place it in a small sky room. Faces with the env_sky tool texture show that room as seen from this point.
// Entities in the sky room (func_conveyor clouds, sprites, func_rotating, models) are drawn in the sky too.
// One env_sky is on at a time: triggering another switches to it, Off turns the 3D sky off.
@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) color(128 192 255) iconsprite("sprites/editor/env_sky.spr") = env_sky : "3D sky camera"
[
	spawnflags(flags) =
