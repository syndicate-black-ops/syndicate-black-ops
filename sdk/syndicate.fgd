]

// Freezes players in place: they can look around but not move, shoot or use.
@PointClass base(Targetname) color(180 120 255) iconsprite("sprites/editor/trigger_playerfreeze.spr") = trigger_playerfreeze : "Trigger Player Freeze"
[
	use_type(choices) : "Use type" : 0 : "What a trigger does. Players stay frozen until unfrozen, until they die, or until a new round." =
	[
		-1 : "Unfreeze"
		0 : "Toggle freeze (each player: frozen if free, free if frozen)"
		1 : "Freeze"
		2 : "Copy input (On freezes, Off unfreezes, Toggle toggles)"
	]
	spawnflags(flags) =
	[
		1 : "All players (not only the activator)" : 0
	]
]

@SolidClass base(Targetname, Master, Appearflags, Angles) = trigger_push : "Trigger player push"
[
	spawnflags(flags) =
	[
		1 : "Push Once Only" : 0
		2 : "Start Off" : 0
		8 : "No clients" : 0
		16 : "No monsters" : 0
	]
	speed(integer) : "Speed of push" : 40 : "How fast it pushes, in units per second. If left empty or set to 0, it pushes at 100 units per second."
	m_iszPushSpeed(string) : "Speed factor [LR]" : "" : "Multiplies the push for each toucher (!activator is the toucher)."
	m_iszPushVel(string) : "Push direction [LV] (blank = angles)" : "" : "The push direction instead of the angles (times Speed of push)."
	m_iObeyTriggerMode(choices) : "Obey Trigger Mode" : 0 : "With No, any trigger turns it on or off. With Yes, On turns it on, Off turns it off and Toggle toggles it." =
	[
		0 : "No (always toggle)"
		1 : "Yes"
	]
]

@PointClass base(Targetname, Targetx) iconsprite("sprites/editor/trigger_relay.spr") = trigger_relay : "Trigger Relay"
[
	triggerstate(choices) : "Trigger State" : 0 =
	[
		0 : "Off"
		1 : "On"
		2 : "Toggle"
		-1 : "Copy Input"
		-2 : "Reverse Input"
	]
	spawnflags(flags) =
	[
		1 : "Remove On fire" : 0
		64 : "Forward activator" : 0
		128 : "Pass caller as activator" : 0
	]
	m_flDelayBeforeReset(string) : "Delay Before Reset" : "" : "After it fires, it ignores every trigger for this many seconds."
	master(string) : "Master" : : "While this master (a multisource or another master) is locked, the relay does not fire."
]

// A player falling through it takes no fall damage on landing.
@SolidClass base(Targetname, Master) = trigger_safe_fall : "Trigger Safe Fall (no fall damage)" []

// Runs an entry of the map's sequence file, sequences/<map name>.seq, or of sequences/global.seq: timed lines that fire targets,
// show HUD text and play sounds. On or Toggle starts it over, Off stops it.
@PointClass base(Targetname) color(180 120 255) iconsprite("sprites/editor/trigger_sequence.spr") = trigger_sequence : "Trigger Sequence (sequences/<map>.seq)"
[
	spawnflags(flags) =
	[
		1 : "Fire once" : 0
	]
	sequence_id(string) : "Sequence name (entry of the .seq file, without the %)"
]

@SolidClass base(Targetname, Target, Master) = trigger_teleport : "Trigger teleport"
[
	target(target_destination) : "Target" : "" : "The info_teleport_destination it sends anything that touches it to. If left empty, it does nothing."
	message(target_destination) : "Landmark (seamless)" : "" : "A point entity at the trigger, for a seamless teleport, so the toucher keeps its place relative to Target, its speed and its view."
	spawnflags(flags) =
	[
		1 : "Monsters" : 0
		2 : "No Clients" : 0
		64 : "Random destination" : 0
		128 : "Relative (no landmark)" : 0
		256 : "Keep angles (no landmark)" : 0
		512 : "Keep velocity (no landmark)" : 0
		1024 : "Grenades, items (landmark)" : 0
	]
	teleport_start_inactive(choices) : "Start Inactive" : 0 : "With Yes, it does nothing until it is triggered on, and it needs a name." =
	[
		0 : "No"
		1 : "Yes"
	]
]

// Changes the speed of a moving func_tracktrain, at once or step by step over a time. A stopped train stays stopped.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/train_setspeed.spr") = train_setspeed : "Set Track Train Speed"
[
	train(target_destination) : "Track train"
	speed(integer) : "New speed" : 0 : "Units per second, up to 2000. Below 0 the train runs backward, and 0 stops it."
	mode(choices) : "How" : 0 =
	[
		0 : "At once"
		1 : "Step by step over the time"
	]
	time(string) : "Time (seconds)" : "10" : "With step by step, how long the change takes, in steps of 0.1 seconds."
	target(target_destination) : "Fire when the speed is reached"
]

// Locks or unlocks the controls of the func_tracktrain or func_vehicle named Target.
// On unlocks, Off locks, Toggle switches.
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) iconsprite("sprites/editor/trigger_vehiclecontrols.spr") = trigger_vehiclecontrols : "Lock / unlock vehicle controls"
[
	target(target_destination) : "Train or vehicle"
]


