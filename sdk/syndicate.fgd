@BaseClass base(Targetname, Targetx, RenderFields, Appearflags, Angles, BodySkin, CustomObjectHint, Colormap) size(-16 -16 0, 16 16 32) color(0 0 200) = Weapon []
@BaseClass base(Targetname, Target, RenderFields, Appearflags, Angles, BodySkin, ModelScale, CustomObjectHint, Colormap) size(-16 -16 0, 16 16 36) = ItemBase []
@BaseClass = ItemPickupFlags
[
	spawnflags(flags) =
	[
		128 : "TOUCH only (cancels USE only)" : 0
		256 : "USE only" : 0
	]
]
@BaseClass base(Appearflags, Angles, MoveWith) size(-16 -16 -36, 16 16 36) color(0 255 0) studio("models/player.mdl") = PlayerClass []


// The Monster keys in groups: Monster has them all; a class whose code can't use a group leaves it out
@BaseClass base(Targetname, RenderFields, Angles, ModelScale) color(0 200 200) = MonsterCore
[
	trigger_on_death(target_destination) : "Trigger on death" : "" : "Fired once when it is killed; the activator is the killer."
	classify(choices) : "Classification" : "" : "Who it fights and who fights it. If left empty or set to 0, it keeps its own class. An Osprey gives its class to the Feds it drops." =
	[
		-1 : "None"
		0 : "Default"
		1 : "Machine"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
	is_player_ally(choices) : "Is player ally" : 0 : "With Yes, it changes sides, and so do an Osprey's Feds, but a set Classification decides its side instead. A Cop follows on +use only as an ally with Followage policy Regular." =
	[
		0 : "No"
		1 : "Yes"
	]
	field_of_view(choices) : "Custom Field Of View" : "" : "How wide it sees. If left empty or set to 0, it keeps its own. It has no effect on hunters, the Cyborg and the Cyber Minotaur, which see everything within 12000 units, through walls." =
	[
		0 : "Default"
		-1 : "Full"
		"-0.7" : "Wide (humans)"
		"-0.2" : "Broad"
		"0.2" : "Average"
		"0.5" : "Tunnel"
		"0.7" : "Narrow"
		"0.9" : "Ultra narrow"
	]
	prisonerto(choices) : "Prisoner to" : 0 : "It and this class ignore each other." =
	[
		0 : "None"
		1 : "Machine"
		2 : "Player"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
	ignoredby(choices) : "Ignored by" : 0 : "This class ignores it, but it still sees them." =
	[
		0 : "None"
		1 : "Machine"
		2 : "Player"
		3 : "Human passive"
		4 : "Human military"
		5 : "Alien military"
		6 : "Alien passive"
		7 : "Alien monster"
		8 : "Alien prey"
		9 : "Alien predator"
		10 : "Insect"
		11 : "Player ally"
		12 : "Player bioweapon"
		13 : "Alien bioweapon"
	]
]
@BaseClass = MonsterUnkillable
[
	unkillable(choices) : "Unkillable" : 0 : "With Yes, damage never takes it below 1 health, so it can't be killed. It can be changed while the map runs with trigger_changevalue. It doesn't work on the Apache, turrets or sentry guns." =
	[
		0 : "No"
		1 : "Yes"
	]
]
@BaseClass = MonsterFlags
[
	spawnflags(flags) =
	[
		1 : "WaitTillSeen" : 0
		16 : "Prisoner" : 0
	]
]
@BaseClass = MonsterClip
[
	spawnflags(flags) =
	[
		4 : "MonsterClip" : 0
	]
]
@BaseClass = MonsterGag
[
	spawnflags(flags) =
	[
		2 : "Gag" : 0
	]
]
@BaseClass = MonsterFadeCorpse
[
	spawnflags(flags) =
	[
		512 : "Fade Corpse" : 0
	]
]
@BaseClass = MonsterNonSolidCorpse
[
	spawnflags(flags) =
	[
		// Non-solid corpse: its corpse does not block players, monsters or doors
		65536 : "Non-solid corpse" : 0
	]
]
@BaseClass = MonsterActOutOfPVS
[
	spawnflags(flags) =
	[
		// Act out of PVS: it looks, listens and acts with no player near (without it, it waits for one)
		1048576 : "Act out of PVS" : 0
	]
]
@BaseClass = MonsterTriggers
[
	TriggerTarget(string) : "TriggerTarget"
	TriggerCondition(choices) : "Trigger Condition" : 0 =
	[
		0 : "No Trigger"
		1 : "See Player, Mad at Player"
		2 : "Take Damage"
		3 : "50% Health Remaining"
		4 : "Death"
		7 : "Hear World"
		8 : "Hear Player"
		9 : "Hear Combat"
		10 : "See Player Unconditional"
		11 : "See Player, Not In Combat"
		12 : "Provoked by a player"
		13 : "Got healed"
	]
	TriggerAltCondition(choices) : "Trigger Alternative Condition" : 0 : "A second condition that fires TriggerTarget (whichever comes first, once)." =
	[
		0 : "No Trigger"
		1 : "See Player, Mad at Player"
		2 : "Take Damage"
		3 : "50% Health Remaining"
		4 : "Death"
		7 : "Hear World"
		8 : "Hear Player"
		9 : "Hear Combat"
		10 : "See Player Unconditional"
		11 : "See Player, Not In Combat"
		12 : "Provoked by a player"
		13 : "Got healed"
	]
]
@BaseClass = MonsterBody
[
	bloodcolor(choices) : "Blood Color" : 0 : "The color of its blood, decals and gibs. With Default, it keeps the monster's own." =
	[
		-1 : "Don't bleed"
		0 : "Default"
		247 : "Human (red)"
		195 : "Alien (yellow)"
		70 : "Dark red"
		192 : "Bright yellow"
		244 : "Green"
	]
	gibmodel(studio) : "Custom gib model" : "" : "When gibbed, it throws 4 gibs of this model (random submodels)."
	gib_policy(choices) : "Gibbing policy" : 0 : "A kill that always or never gibs still wins." =
	[
		0 : "Default"
		1 : "Prefer gibbing"
		2 : "Prefer not to gib"
	]
]
@BaseClass = MonsterSound
[
	soundmask(choices) : "Custom Sound Mask" : "" : "The sounds it reacts to. If left empty or set to 0, it keeps its own." =
	[
		-1 : "No sounds (deaf)"
		0 : "Default for monster"
		32 : "Only Danger"
		33 : "Only Combat and Danger"
		37 : "Combat, Danger and Player"
		127 : "Every sound and scent"
		1028 : "Default, except Player"
	]
]
@BaseClass = MonsterRoam
[
	freeroam(choices) : "Freeroam" : 0 : "When idle, it walks from node to node (needs nodes)." =
	[
		0 : "Map default"
		1 : "Never"
		2 : "Always"
	]
	active_alert(choices) : "Active after combat" : 0 : "After a fight, it goes to gunfire it hears and walks around once (needs nodes), instead of standing still." =
	[
		0 : "Default (no)"
		1 : "Never"
		2 : "Always"
	]
]
@BaseClass base(MonsterCore, MonsterUnkillable, MonsterFlags, MonsterClip, MonsterFadeCorpse, MonsterNonSolidCorpse, MonsterActOutOfPVS, MonsterGag, Target, MonsterTriggers, MonsterBody, MonsterSound, MonsterRoam) color(0 200 200) = Monster
[
	target(target_destination) : "Target" : : "The path_corner it walks to first; from there it follows the path. A monster with a Name waits where it is until it is triggered."
]
// Monster without Gag: for monsters with no idle speech to silence
@BaseClass base(MonsterCore, MonsterUnkillable, MonsterFlags, MonsterClip, MonsterFadeCorpse, MonsterNonSolidCorpse, MonsterActOutOfPVS, Target, MonsterTriggers, MonsterBody, MonsterSound, MonsterRoam) color(0 200 200) = MonsterQuiet
[
	target(target_destination) : "Target" : : "The path_corner it walks to first; from there it follows the path. A monster with a Name waits where it is until it is triggered."
]
@BaseClass = TalkMonster
[
	UseSentence(string) : "Use Sentence"
	UnUseSentence(string) : "Un-Use Sentence"
	voicepitch(integer) : "Voice pitch" : 0 : "The pitch of its voice, where 100 is normal. With 0, it keeps its own."
	followage_policy(choices) : "Followage policy" : "" : "Who can make it follow a player. If left empty, scientists follow a player who presses use on them, and Cops never follow. With Regular, a Cop that is a player ally follows on use too, and with Scripted only, only a scripted_following can make it follow. A Cop only ever follows as a player ally." =
	[
		0 : "Regular"
		1 : "Scripted only"
		2 : "Scripted only, decline use"
	]
	followfailpolicy(choices) : "Follow failure policy" : 0 : "What it does when it can't reach the player it follows. With Default, scientists stop following and others keep trying. With a Scripted only followage policy, Stop following keeps trying." =
	[
		0 : "Default"
		1 : "Keep trying"
		2 : "Stop following"
		3 : "Run to the nearest spot"
	]
	suspicious(choices) : "Pre-provoked" : 0 : "With Yes, it dislikes players from the start." =
	[
		0 : "No"
		1 : "Yes"
	]
	tolerance(choices) : "Tolerance level" : 0 : "How many hits from a player make it hostile. With Default, it is Low for Cops and Zero for scientists." =
	[
		0 : "Default"
		1 : "Zero: any hit"
		2 : "Low: a direct hit or a second hit"
		3 : "Average: the third hit"
		4 : "High: the fourth hit, each within 4 seconds of the one before"
		5 : "Absolute: never"
		6 : "Absolute, don't alert friends"
	]
	alert_friends(choices) : "Alert friends" : 0 : "Whether killing it makes its friends who see it hostile. With Default, it always does." =
	[
		0 : "Default"
		1 : "Always"
		2 : "If not in combat"
		3 : "Never"
	]
	RefusalSentence(string) : "Refusal Sentence" : "" : "The sentence group it says when it refuses to follow. With null, it says nothing."
	SpeakAs(string) : "Speech Prefix" : "" : "Speak another voice's lines (BA Cop, SC scientist). Lines that voice lacks stay silent."
	spawnflags(flags) =
	[
		256 : "Pre-Disaster" : 0
		// Ignore move away requests: it does not step aside when a player walks into it
		524288 : "Ignore move away requests" : 0
	]
]

// Charger options
@BaseClass = Recharger
[
	TriggerOnFirstUse(target_destination) : "Trigger On First Use" : "" : "Fired once, the first time it gives a player some charge."
	TriggerOnEmpty(target_destination) : "Trigger On Empty" : "" : "Fired by the first use after it runs out; again only after it has recharged."
	TriggerOnRecharged(target_destination) : "Trigger On Recharged" : "" : "Fired when it fills up again."
	CustomLoopSound(sound) : "Custom Loop Sound" : ""
	CustomDeniedSound(sound) : "Custom Denied Sound" : ""
	CustomStartSound(sound) : "Custom Start Sound" : ""
	CustomRechargeSound(sound) : "Custom Recharge Sound" : "" : "Played when it fills up again (the suit charger plays none by default)."
	CustomJuice(integer) : "Custom Juice Amount" : : "The armor it holds. If left empty or set to 0, it holds the amount the skill setting gives."
]

@BaseClass base(Targetname, Targetx, Angles) size(-16 -16 0, 16 16 72) color(255 0 255) = Scripted
[
	m_iszEntity(string) : "Target Monster"
	m_flRadius(integer) : "Search Radius" : 512 : "How far from the script a monster is looked for when Target Monster is a class name. If left empty, a class name finds no monster, but the Entity to attack of a scripted_action is still looked for within 512 units."
	m_fMoveTo(choices) : "Move to Position" : 0 =
	[
		0 : "No"
		1 : "Walk"
		2 : "Run"
		4 : "Instantaneous"
		5 : "No - Turn to Face"
		7 : "Teleport"
	]
	m_iszFireOnPossessed(target_destination) : "Fire on Possession" : "" : "Fired when the script takes its monster, with this script as the activator."
	m_iszFireOnBegin(target_destination) : "Fire after moving" : "" : "With Walk or Run, fired when the monster reaches the mark and the script may start, with this script as the activator."
	m_iszFireOnAnimStart(target_destination) : "Fire on Animation start" : "" : "Fired when the Action Animation starts, or the action of a scripted_action, with this script as the activator."
	master(string) : "Master" : "" : "While the master is locked the script waits (it looks again every second)."
	m_interruptionPolicy(choices) : "Interruption policy" : 0 : "What breaks the monster out of the script." =
	[
		0 : "Default (by any damage)"
		1 : "No Interruptions (same as flag)"
		2 : "By Death Only"
	]
	m_takeDamagePolicy(choices) : "TakeDamage policy" : 0 : "Damage while the script holds the monster." =
	[
		0 : "As usual"
		1 : "Invulnerable during script"
		2 : "Non-lethal damage"
	]
	m_searchPolicy(choices) : "Search target monster by..." : 0 : "Target Monster as a name, a class name or both." =
	[
		0 : "Targetname, then classname"
		1 : "Targetname only"
		2 : "Classname only"
	]
	m_applySearchRadius(choices) : "Test against search radius" : 0 : "With Always, a monster found by name must be within the Search Radius too." =
	[
		0 : "When searching by classname"
		1 : "Always"
	]
	required_state(choices) : "Required MonsterState" : 0 : "The script takes a monster only in this state." =
	[
		0 : "Any"
		1 : "Idle"
		2 : "Combat"
		3 : "Alert, Hunt"
		4 : "Non-combat (Idle, Alert, Hunt)"
	]
	moveto_radius(string) : "Move to target's radius" : "" : "With Walk or Run, the monster stops this close to the mark and plays there. If left empty or set to 0, it stops on the mark."
	m_fTurnType(choices) : "Turn mode" : 0 : "How the monster turns before the action, with Move to Position Walk, Run or No - Turn to Face. Teleport and Instantaneous take the script's angle; No does not turn." =
	[
		0 : "Match turn target's angle"
		1 : "Turn to target"
		2 : "Don't Turn"
	]
	m_iPriority(choices) : "Priority" : 0 : "With Override, it takes a monster that plays another script." =
	[
		0 : "Normal"
		4 : "Override other sequences"
	]
	m_iRepeats(integer) : "Repeat action X more times" : 0 : "How many more times the Action Animation plays, or the action of a scripted_action."
]

@BaseClass base(Targetname, Angles) size(-16 -16 -16, 16 16 16) = GibshooterBase
[
	m_iGibs(integer) : "Number of Gibs" : 3 : "How many gibs it shoots each time it's triggered. If left empty, it shoots one."
	delay(string) : "Delay between shots" : "0" : "Seconds between gibs. With 0, it is 0.1 seconds."
	m_flVelocity(string) : "Gib Velocity [LR]" : "200" : "How fast the gibs fly. If left empty, the gibs just drop, unless Direction and speed is set, in which case its length alone sets their speed."
	m_iszPosition(string) : "Position [LP] (blank = here)" : "" : "Where the gibs appear, given as x y z, an entity name or !activator."
	m_iszVelocity(string) : "Direction and speed [LV] (blank = angles)" : "" : "The direction the gibs fly; its length times Gib Velocity is their speed."
	m_flVariance(string) : "Course Variance" : "0.15" : "How much the gibs spread from the direction they're shot in. If left empty, they all fly exactly the same way."
	m_flGibLife(string) : "Gib Life" : "4" : "Seconds the gibs last. If left empty or set to 0, they last 25 seconds."

	spawnflags(flags) =
	[
		1 : "Repeatable" : 0
		8 : "Start instantly" : 0
	]
	m_iszSpawnTarget(target_destination) : "Fire on spawn (locus = gib)" : "" : "Fired for each gib or shot; it is the activator."
]

