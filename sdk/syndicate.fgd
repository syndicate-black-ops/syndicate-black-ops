[
	framerate(string) : "Framerate" : "10.0" : "For a sprite, its frames per second. For a model, its playback rate, where 1 is normal and 0 holds the first frame. If left empty, a sprite doesn't animate and a model holds its first frame."
	sequence(integer) : "Sequence (model)" : 0 : "For models only, the number of the sequence it plays."
	model(sprite) : "Sprite or model" : "sprites/glow01.spr" : "The sprite or model shown. If left empty, the entity is removed."
	scale(string) : "Scale" : "" : "How big it is drawn, so 0.5 is half and 2 is double. If left empty or set to 1, it is its normal size."
