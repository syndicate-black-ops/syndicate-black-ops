	buoyancy(integer) : "Buoyancy" : 20 : "How strongly it floats in water. If left empty, it sinks."
	toggleable_push(choices) : "Toggleable push" : 0 : "With Yes, triggering it switches it between pushable and fixed in place, and a trigger then never breaks it." =
