// Changes a key of its target entities when triggered. Target: a name, !activator or !caller. Model, sprite and sound
// keys cannot be changed.
@PointClass base(Targetname) color(180 120 255) iconsprite("sprites/editor/trigger_changevalue.spr") = trigger_changevalue : "Trigger Change Value"
[
	spawnflags(flags) =
	[
		1 : "Don't use X" : 0
		2 : "Don't use Y" : 0
		4 : "Don't use Z" : 0
		32 : "Invert target value" : 0
		64 : "Invert source value" : 0
	]
	target(target_destination) : "Destination entity"
	m_iszValueName(string) : "Key name" : "" : "The key to change. classname, model, sprite and sound keys can't be changed. monstermaker Monster Type and a new game_player_equip item only take a class the map already loads."
	m_iszNewValue(string) : "New value"
	m_iszValueType(choices) : "Type of value (operation)" : 0 =
	[
		0 : "Replace (= new value)"
		1 : "Add (= old + new)"
		2 : "Mul (= old * new)"
		3 : "Sub (= old - new)"
		4 : "Div (= old / new)"
		16 : "Pow (= old ^ new)"
		12 : "Mod (= old % new, whole numbers)"
		5 : "AND (= old & new)"
		6 : "OR (= old | new)"
		13 : "XOR (= old ^ new)"
		15 : "Clear bits (= old & ~new)"
		30 : "Min (= min(old, new))"
		31 : "Max (= max(old, new))"
		7 : "NAND (bitwise: = ~(old & new))"
		8 : "NOR (bitwise: = ~(old | new))"
		14 : "NXOR (bitwise: = ~(old ^ new))"
		9 : "Direction to Angles (= angles of old)"
		10 : "Angles to Direction (= direction of old)"
		11 : "Append (String concatenation)"
		17 : "Sin (= sin(new))"
		18 : "Cos (= cos(new))"
		19 : "Tan (= tan(new))"
		23 : "Cot (= cot(new))"
		20 : "Arcsin (= arcsin(new))"
		21 : "Arccos (= arccos(new))"
		22 : "Arctan (= arctan(new))"
		24 : "Arccot (= arccot(new))"
	]
	m_trigonometricBehaviour(choices) : "Trigonometric funcs. behavior" : 0 : "With Degrees, Sin, Cos, Tan and Cot take the new value in degrees, so sin(30) is 0.5, and Arcsin, Arccos, Arctan and Arccot give degrees, so arcsin(0.5) is 30. With Radians, both are in radians." =
	[
		0 : "Degrees"
		1 : "Radians"
	]
	m_iAppendSpaces(integer) : "Append spaces (for strings)" : 0
	message(target_destination) : "Trigger after operation"
	value_type(choices) : "Treat new value as" : 0 : "With Literal, the New value is used as written. With Locus, the New value is a Locus key, computed when it fires." =
	[
		0 : "Literal value"
		1 : "Locus Ratio"
		2 : "Locus Position"
		3 : "Locus Velocity"
	]
]

