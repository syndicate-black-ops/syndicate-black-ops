[
	target(target_destination) : "Position [LP] (blank = here)" : "" : "Where it explodes: x y z, an entity name, !activator or *player."
	iMagnitude(integer) : "Magnitude" : 100
	spawnflags(flags) =
	[
		1 : "No Damage" : 0
		2 : "Repeatable" : 0
		4 : "No Fireball" : 0
		8 : "No Smoke" : 0
		16 : "No Decal" : 0
		32 : "No Sparks" : 0
		64 : "No Sound" : 0
		128 : "Activator is attacker" : 0
	]
	iradius(integer) : "Damage radius" : 0 : "How far the damage reaches. 0: 2.5 x Magnitude."
	model(sprite) : "Custom Fireball Sprite" : "" : "Empty: the stock fireball."
	smokesprite(sprite) : "Custom Smoke Sprite" : "" : "Empty: the stock smoke."
	scale(string) : "Custom sprite scale" : "" : "The fireball and smoke scale (1 = the sprite's size). Empty or 0: set by the Magnitude."
]

