@SolidClass base(Trackchange) = func_trackchange : "Train track changing platform" []

@SolidClass base(Targetname, Global, RenderFields, ZHLT) = func_tracktrain : "Track Train"
[
	spawnflags(flags) =
	[
		1 : "No Pitch (X-rot)" : 0
		2 : "No User Control" : 0
		4 : "Forwards Only" : 0
		8 : "Passable" : 0
	]
	target(target_destination) : "First stop target"
	sounds(choices) : "Sound" : 0 =
	[
		0 : "None"
		1 : "Rail 1"
		2 : "Rail 2"
		3 : "Rail 3"
		4 : "Rail 4"
		5 : "Rail 6"
		6 : "Rail 7"
	]
	wheels(integer) : "Distance between the wheels" : 50
	height(integer) : "Height above track" : 4
	startspeed(integer) : "Initial speed" : 0
	speed(integer) : "Speed (units per second)" : 64
	dmg(integer) : "Damage on crush" : 0
	volume(integer) : "Volume (10 = loudest)" : 10
	bank(string) : "Bank angle on turns" : "0"
	soundradius(choices) : "Sound radius" : 0 =
	[
		-2 : "Small"
		-1 : "Medium"
		0 : "Default (large)"
		1 : "Huge"
		2 : "Enormous"
		3 : "Play Everywhere"
	]
	custommovesnd(sound) : "Custom move sound" : "" : "A sound file instead of the Sound choice (pitched by speed)."
	customstopsnd(sound) : "Custom brake sound" : "" : "Empty: plats/ttrain_brake1.wav."
]

@SolidClass base(Targetname, Global, PlatSounds, RenderFields, ZHLT) = func_train : "Moving platform"
[
	target(target_destination) : "First stop target"
	speed(integer) : "Speed (units per second)" : 64
	avelocity(string) : "Angular Velocity (y z x)"
	dmg(integer) : "Damage on crush" : 0
	skin(integer) : "Contents" : 0
	m_iObeyTriggerMode(choices) : "Obey Trigger Mode" : 0 : "No: any trigger starts or stops it. Yes: On starts, Off stops, Toggle toggles." =
	[
		0 : "No"
		1 : "Yes"
	]
	spawnflags(flags) =
	[
		4 : "Initially On" : 0
		8 : "Not solid" : 0
		64 : "No default damage" : 0
	]
	soundpitch(integer) : "Move sound pitch" : 0 : "100 or 0: normal."
]

@SolidClass = func_traincontrols : "Train Controls"
[
	target(target_destination) : "Train Name"
]

@SolidClass base(Targetname, Angles, RenderFields, ZHLT) = func_vehicle : "Drivable Vehicles"
[
	spawnflags(flags) =
	[
		1 : "No Pitch (X-rot)" : 0
		2 : "No User Control" : 0
		8 : "Passable" : 0
	]
	target(target_destination) : "First stop target"
	sounds(choices) : "Sound" : 3 =
	[
		1 : "Vehicle 1"
		2 : "Vehicle 2"
		3 : "Vehicle 3 (default)"
		4 : "Vehicle 4"
		5 : "Vehicle 6"
		6 : "Vehicle 7"
	]
	length(integer) : "Length of the vehicle" : 256
	width(integer) : "Width of the vehicle" : 128
	height(integer) : "Height above track" : 4
	startspeed(integer) : "Initial speed" : 0
	speed(integer) : "Speed (units per second, 0 = 165, at most 2000)" : 0
	acceleration(integer) : "Acceleration (1-10)" : 5
	dmg(integer) : "Damage on crush" : 0
	volume(integer) : "Volume (10 = loudest)" : 10
	bank(string) : "Bank angle on turns" : "0"
	reverse_speed(string) : "Custom reverse speed" : "" : "Top speed backwards (units per second). Empty or 0: 0.35 x Speed."
	deceleration(integer) : "Custom deceleration per 0.1 seconds" : 0 : "Speed lost every 0.1 seconds when nobody accelerates or brakes. 0: 20."
	stop_sound_at_halt(choices) : "Stop sound at halt" : 0 : "Silences the engine while the vehicle stands still with no driver." =
	[
		0 : "No (default)"
		1 : "When stopped and no driver"
	]
	brake_sound(sound) : "Custom brake sound" : "" : "Plays when the engine starts. Empty: plats/vehicle_brake1.wav (Sound 1-4 only)."
	ignition_sound(sound) : "Custom ignition sound" : "" : "Plays when a player takes the wheel. Empty: plats/vehicle_ignition.wav."
	touch_proxy_name(string) : "Touch proxy name" : "" : "A vehicle touches no triggers. Set a name to have an entity of that name ride with it and touch triggers that accept other entities."
	_minlight(string) : "Minimum light level" : "0"
]

@SolidClass = func_vehiclecontrols : "Vehicle Controls"
[
	target(target_destination) : "Vehicle Name"
	zhlt_invisible(choices) : "Invisible" : 1 =
	[
		1 : "yes"
	]
]

