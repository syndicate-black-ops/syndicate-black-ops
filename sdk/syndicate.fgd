	]
]

@PointClass base(Targetname) color(170 179 43) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/calc_vecfromnums.spr") = calc_vecfromnums : "Calculate Vector from Numbers"
[
	base_vector(string) : "Base vector [LV] / [LP] / color" : "" : "If left empty, it is 0 0 0."
	vector_type(choices) : "Base vector is" : 0 =
	[
		0 : "Velocity [LV]"
		1 : "Position [LP]"
		2 : "Color (an entity's render color)"
	]
	x_value(string) : "X value [LR]" : "" : "If left empty, it keeps the base vector's."
	y_value(string) : "Y value [LR]" : "" : "If left empty, it keeps the base vector's."
	z_value(string) : "Z value [LR]" : "" : "If left empty, it keeps the base vector's."
]

@PointClass base(Targetname) color(170 179 43) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/calc_subvelocity.spr") = calc_subvelocity : "Calculate Vector from Entity"
[
	netname(string) : "Entity to use" : "*locus"
	impulse(choices) : "Value to calculate from" : 0 =
	[
		0 : "Movement velocity"
		1 : "Angles (direction)"
		2 : "View angles (player)"
		10 : "Calc Velocity of the entity [LV]"
	]
	noise(string) : "Scale factor [LR]" : : "If left empty, it is 1. Here *locus is the Entity to use, not the activator."
	message(string) : "Add offset [LV]" : : "If left empty, there is no offset. Here *locus is the Entity to use, not the activator."
	spawnflags(flags) =
	[
		1 : "Normalize before scaling" : 0
		2 : "Flip vertical" : 0
		4 : "Discard X" : 0
		8 : "Discard Y" : 0
		16 : "Discard Z" : 0
	]
]

@PointClass base(Targetname) color(170 179 43) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/calc_velocity_path.spr") = calc_velocity_path : "Calculate Vector between Positions"
[
	target(string) : "Start position [LP]" : "*locus"
	netname(string) : "Destination [LP] / [LV]"
	armorvalue(choices) : "Destination is" : 0 =
	[
		0 : "Position [LP]"
		1 : "Offset [LV]"
	]
	health(choices) : "Length calculation" : 0 =
	[
		0 : "None (X = X)"
		1 : "Normalize (X = 1)"
		2 : "Reciprocal (X = 1/X)"
		3 : "Inverse square (X = 1/X*X)"
		4 : "Square (X = X*X)"
	]
	noise(string) : "Length factor [LR]" : : "If left empty, it is 1."
	frags(choices) : "Line is blocked by" : 0 =
	[
		0 : "Nothing"
		1 : "Walls"
		2 : "Walls & glass"
		3 : "Walls & monsters"
		4 : "Walls, monsters & glass"
	]
]

@PointClass base(Targetname) color(170 179 43) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/calc_velocity_polar.spr") = calc_velocity_polar : "Calculate Rotated Vector"
[
	netname(string) : "Based on vector [LV]" : "*locus"
	angles(string) : "Rotated by angle (Y Z X, degrees)" : "0 0 0"
	noise(string) : "Length factor [LR]" : : "If left empty, it is 1."
	message(string) : "Add offset [LV]" : : "If left empty, there is no offset."
	spawnflags(flags) =
	[
		1 : "Normalize (length factor = exact length)" : 0
	]
]

@PointClass base(Targetname) color(170 221 85) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/calc_eval_number.spr") = calc_eval_number : "Calculate Number from Numbers"
[
	left_operand(string) : "First operand [LR]"
	right_operand(string) : "Second operand [LR]"
	third_operand(string) : "Third operand [LR] (optional)" : "" : "The operation is applied again with the result and this."
	operation(choices) : "Operation" : 0 =
	[
		0 : "Add"
		1 : "Subtract"
		2 : "Multiply"
		3 : "Divide"
		4 : "Mod"
		5 : "Find min"
		6 : "Find max"
	]
	store_result(target_destination) : "Store result in" : "" : "When it is triggered, the result goes to this game_number or game_counter, with the use type Set."
	target(target_destination) : "Trigger after operation"
	trigger_on_fail(target_destination) : "Trigger on calculation fail" : "" : "A missing operand, a division by zero, an overflow."
	min_value(string) : "Min (blank = none) [LR]"
	max_value(string) : "Max (blank = none) [LR]"
	clamp_policy(choices) : "If outside range" : 0 =
	[
		0 : "Pick nearest value"
		1 : "Wrap around"
		2 : "Bounce back"
	]
	vector_mode(choices) : "Report as vector" : 0 =
	[
		0 : "No"
		1 : "X 0 0"
		2 : "0 Y 0"
		3 : "0 0 Z"
	]
	first_cast_mode(choices) : "Cast first operand" : 0 =
	[
		0 : "No cast"
		1 : "Round"
		2 : "Floor"
		3 : "Ceil"
		4 : "Trunc"
	]
	second_cast_mode(choices) : "Cast second operand" : 0 =
	[
		0 : "No cast"
		1 : "Round"
		2 : "Floor"
		3 : "Ceil"
		4 : "Trunc"
	]
	third_cast_mode(choices) : "Cast third operand" : 0 =
	[
		0 : "No cast"
		1 : "Round"
		2 : "Floor"
		3 : "Ceil"
		4 : "Trunc"
	]
	result_cast_mode(choices) : "Cast result" : 0 =
	[
		0 : "No cast"
		1 : "Round"
		2 : "Floor"
		3 : "Ceil"
		4 : "Trunc"
	]
]

@PointClass base(Targetname) color(170 221 85) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/locus_variable.spr") = locus_variable : "Locus Variable (stores values)"
[
	m_iszPosition(string) : "Position to record [LP]" : "*locus" : "If one of the three values can't be worked out, the trigger stores, makes and fires nothing."
	m_iszVelocity(string) : "Vector to record [LV]" : "*locus"
	m_iszRatio(string) : "Number to record [LR]" : "*locus"
	m_iszTargetName(string) : "Child's name (blank = no child)" : "" : "If set, each trigger makes a marker entity with this name that holds the values, and each one is an edict."
	m_iszFireOnSpawn(target_destination) : "Fire on spawn (activator = the child, or this entity without one)"
	m_fDuration(string) : "Child removed after (seconds)" : "0" : "With a Child's name, 0 removes the child on the next frame, so it lasts only for Fire on spawn. Set a time to keep it."
	round_reset(choices) : "Reset at round start" : 0 : "With Yes, it goes back to its state at map load at each round start." =
	[
		0 : "No"
		1 : "Yes"
	]
]

// Each trigger makes a beam between two Locus points or entities.
@PointClass base(Targetname) color(170 179 43) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/locus_beam.spr") = locus_beam : "Locus Beam"
[
	m_iszStart(string) : "Start at" : "" : "An entity name or a position [LP], as 'Start & End are' says, and !activator is whoever triggered it. If left empty, no beam is made."
	m_iszEnd(string) : "End at" : "*locus" : "An entity name, a position [LP] or a direction [LV], as 'Start & End are' says. With *locus, or if left empty, it is whoever triggered it."
	impulse(choices) : "Start & End are" : 0 : "Entity ends follow their entities while they move." =
	[
		0 : "Entity & Entity [LE LE]"
		1 : "Position & Entity [LP LE]"
		2 : "Position & Position [LP LP]"
		3 : "Position & Direction [LP LV] (end = start + direction)"
	]
	m_iszSprite(sprite) : "Sprite name" : "sprites/laserbeam.spr"
	renderamt(integer) : "Brightness (1 - 255)" : 0 : "If left at 0, the beam doesn't show, so set it."
	rendercolor(color255) : "Color (R G B)" : "0 0 0" : "If left at 0 0 0, the beam doesn't show, or is black with Draw solid, so set it."
	m_iWidth(integer) : "Width" : 0 : "If left at 0, the beam doesn't show, so set it."
	m_iDistortion(integer) : "Distortion (noise)" : 0 : "How much the beam wobbles, and 0 keeps it straight. With Draw sine, it is the height of the wave."
	m_fFrame(integer) : "Start frame" : 0
	m_iScrollRate(integer) : "Scroll rate" : 0 : "How fast the texture moves along the beam."
	m_fDuration(string) : "Duration (0 = unlimited)" : 0 : "Seconds before the beam is removed. With 0, it stays until it is killed by its name."
	m_fDamage(string) : "Damage per second" : 0 : "Damage to anything the beam touches. Whoever triggered it gets the kill, except when a player's beam hits another player, and then the beam does."
	m_iDamageType(choices) : "Damage type" : 0 =
	[
		0 : "Generic"
		1 : "Crush"
		2 : "Bullet"
		4 : "Slash"
		8 : "Burn"
		16 : "Freeze"
		64 : "Blast"
		128 : "Club"
		256 : "Shock"
		512 : "Sonic"
		1024 : "Energy beam"
		16384 : "Drown"
		65536 : "Nerve gas"
		131072 : "Poison"
		262144 : "Radiation"
		1048576 : "Chemical"
	]
	m_iszTargetName(target_source) : "Name of the beams" : : "Each beam gets this name (killtarget it to remove the beams)."
	target(target_destination) : "Fire on spawn (activator = the beam)"
	m_iStartAttachment(integer) : "Start attachment [1-4]" : : "Start at this attachment of the start entity's model (entity starts only)."
	m_iEndAttachment(integer) : "End attachment [1-4]" : : "End at this attachment of the end entity's model (entity ends only)."
	spawnflags(flags) =
	[
		16 : "Start sparks" : 0
		32 : "End sparks" : 0
		64 : "Decal end (scorch marks where it hits a wall)" : 0
		128 : "Fade start" : 0
		256 : "Fade end" : 0
		512 : "Draw solid" : 0
		1024 : "Draw sine" : 0
	]
]

// A number [LR] read from the player who triggered the chain.
@PointClass base(Targetname) color(170 221 85) size(-12 -12 -12, 12 12 12) iconsprite("sprites/editor/player_calc_ratio.spr") = player_calc_ratio : "Player Number (health, armor, ammo, speed)"
[
	calc_param(choices) : "Value" : 0 : "What is read from the player who triggered the chain. Fails (no number) when that is not a player in play." =
	[
		0 : "Health"
		1 : "Armor"
		2 : "Ammo"
		3 : "Ammo, with the loaded clips"
		4 : "Inventory item count"
		5 : "Maximum speed"
	]
	item_name(string) : "Inventory item" : : "For Inventory item count, the item's name. With Fraction, it is 1 while the player has any, and 0 otherwise."

	value_notion(choices) : "Number as" : 0 : "With Fraction, the value is a share of its maximum, so health is a share of the player's max health, armor of 100, ammo of the carry limit plus the clip sizes with the loaded clips, and speed of the player's normal speed." =
	[
		0 : "Absolute"
		1 : "Fraction [0..1]"
	]
	ammo_name(choices) : "Ammo type" : "" : "For Ammo, which ammo is counted." =
	[
		"" : ""
		"ARgrenades" : "Grenades (Vindico Grenade Launcher, MP5)"
		"rockets" : "Rockets (Nuclear RPG: always 0, no spare rockets)"
		"Hand Grenade" : "Hand grenades"
		"Satchel Charge" : "Satchel charges"
		"Trip Mine" : "Tripmines"
		"Snarks" : "Pitbulls"
		"K444m" : ".444k Bear Killer"
		"federalm" : "Vindico Federal"
		"pm66m" : "Croon PM 66"
		"rc28m" : "Croon RC 28"
		"fa18m" : "Croon FA 18"
		"nm33m" : "Croon NM 33 Sniper Rifle"
		"swm" : "Vindico Plasma Sniper Rifle"
		"spam" : "Saan Auto-Shotgun"
		"benm" : "Benelli"
		"chainm" : "Vindico Avenger Minigun"
		"canonm" : "Canon of Terror"
	]
]


