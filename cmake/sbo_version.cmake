# Writes the build-version header (cmake -P, run on every build by the sbo_version target in CMakeLists.txt).
#   -DOUT=<header> -DVERSION=<x.y.z> -DSRC=<repo root>
#
# CI (CI_COMMIT_SHORT_SHA set):          SBO_VERSION_STRING "2.1.0+1a2b3c4d"
# anything else (local build):            SBO_VERSION_STRING "2.1.0+dirty@HEAD-1a2b3c4d"
# SBO_VERSION_BRANCH: CI: CI_COMMIT_REF_NAME (the branch or tag; else CI_COMMIT_BRANCH). Local: the branch HEAD points
#   to ("feat/server-version"), "detached" for a detached HEAD, "unknown" without a .git. Characters other than
#   letters, digits and "._/-" become "_" (the name ends up in cvars and the server name).
# SBO_BUILD_DATE: "Oct 10 2026 17:02:11" (UTC, __DATE__ __TIME__ style, like studiomdlPlusPlus's banner).
#
# The commit is read from .git directly (HEAD -> ref file or packed-refs), so no git binary is needed in the
# build image. The header is only rewritten when its content changes.

set(_sha "$ENV{CI_COMMIT_SHORT_SHA}")
set(_branch "$ENV{CI_COMMIT_REF_NAME}")
if(NOT _branch)
  set(_branch "$ENV{CI_COMMIT_BRANCH}")
endif()
set(_ci 1)
if(NOT _sha)
  set(_ci 0)
  set(_sha "unknown")
  set(_branch "")
  set(_git "${SRC}/.git")
  if(EXISTS "${_git}" AND NOT IS_DIRECTORY "${_git}")  # worktree / submodule: "gitdir: <path>"
    file(READ "${_git}" _gitfile)
    string(REGEX REPLACE "^gitdir: *([^\n]*).*" "\\1" _git "${_gitfile}")
    if(NOT IS_ABSOLUTE "${_git}")
      set(_git "${SRC}/${_git}")
    endif()
  endif()
  if(EXISTS "${_git}/HEAD")
    file(READ "${_git}/HEAD" _head)
    string(STRIP "${_head}" _head)
    if(_head MATCHES "^ref: (.*)$")
      set(_ref "${CMAKE_MATCH_1}")
      string(REGEX REPLACE "^refs/(heads/)?" "" _branch "${_ref}")
      set(_full "")
      if(EXISTS "${_git}/${_ref}")
        file(READ "${_git}/${_ref}" _full)
      else()
        # worktrees keep refs in the common dir
        set(_common "${_git}")
        if(EXISTS "${_git}/commondir")
          file(READ "${_git}/commondir" _c)
          string(STRIP "${_c}" _c)
          get_filename_component(_common "${_git}/${_c}" ABSOLUTE)
        endif()
        if(EXISTS "${_common}/${_ref}")
          file(READ "${_common}/${_ref}" _full)
        elseif(EXISTS "${_common}/packed-refs")
          file(STRINGS "${_common}/packed-refs" _packed REGEX " ${_ref}$")
          string(REGEX REPLACE " .*" "" _full "${_packed}")
        endif()
      endif()
    else()
      set(_full "${_head}") # detached HEAD
      set(_branch "detached")
    endif()
    string(STRIP "${_full}" _full)
    if(_full MATCHES "^[0-9a-f]+$")
      string(SUBSTRING "${_full}" 0 8 _sha)
    endif()
  endif()
endif()

string(REGEX REPLACE "[^A-Za-z0-9._/-]" "_" _branch "${_branch}")
if(NOT _branch)
  set(_branch "unknown")
endif()

if(_ci)
  set(_ver "${VERSION}+${_sha}")
else()
  set(_ver "${VERSION}+dirty@HEAD-${_sha}")
endif()
string(TIMESTAMP _date "%b %d %Y %H:%M:%S" UTC)

set(_text "// Generated by cmake/sbo_version.cmake -- do not edit.
#define SBO_VERSION \"${VERSION}\"
#define SBO_VERSION_STRING \"${_ver}\"
#define SBO_VERSION_COMMIT \"${_sha}\"
#define SBO_VERSION_BRANCH \"${_branch}\"
#define SBO_VERSION_IS_CI ${_ci}
#define SBO_BUILD_DATE \"${_date}\"
")
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
  file(WRITE "${OUT}" "${_text}")
endif()
