{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitsDisabled"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "14 days",
  "git-submodules": {
    "enabled": false
  },
  "ignorePaths": [
    "external/**"
  ],
  "packageRules": [
    {
      "description": "GitHub Actions: one PR for minor and patch updates (SHA pins with the version in a comment)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Steam Runtime sniper SDK image pinned by tag and digest in the workflows (SNIPER_IMAGE)",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "SNIPER_IMAGE: (?<depName>registry\\.gitlab\\.steamos\\.cloud/steamrt/sniper/sdk):(?<currentValue>[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ]
}
